  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.8",
    "csv-parse": "^7.0.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "wrangler": "^4.140.0"
  }
