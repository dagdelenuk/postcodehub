{
  "name": "postcodehub-uk",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:full": "npm run ingest && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ingest": "tsx scripts/ingest/run-all.ts",
    "ingest:geography": "tsx scripts/ingest/fetch-geography.ts",
    "ingest:transport": "tsx scripts/ingest/fetch-transport.ts",
    "ingest:health": "tsx scripts/ingest/fetch-health.ts",
    "ingest:schools": "tsx scripts/ingest/fetch-schools.ts",
    "ingest:childcare": "tsx scripts/ingest/fetch-childcare.ts",
    "ingest:crime": "tsx scripts/ingest/fetch-crime.ts",
    "ingest:police-stations": "tsx scripts/ingest/fetch-police-stations.ts",
    "ingest:fire-stations": "tsx scripts/ingest/fetch-fire-stations.ts",
    "ingest:places": "tsx scripts/ingest/fetch-places.ts",
    "ingest:property": "tsx scripts/ingest/fetch-property.ts",
    "ingest:representatives": "tsx scripts/ingest/fetch-representatives.ts",
    "ingest:planning": "tsx scripts/ingest/fetch-planning.ts",
    "ingest:seed": "tsx scripts/ingest/seed-events-history.ts",
    "ingest:banners": "tsx scripts/ingest/fetch-banner-images.ts",
    "ingest:district-images": "tsx scripts/ingest/fetch-district-images.ts",
    "ingest:curate-borough-images": "tsx scripts/ingest/curate-borough-images.ts",
    "ingest:merge": "tsx scripts/ingest/build-outcode-data.ts",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "check": "node scripts/check-build.mjs",
    "test": "node --check public/sw.js && npm run build && npm run check"
