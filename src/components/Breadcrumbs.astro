---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-4 pt-6 text-sm text-stone-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span class="text-stone-300">/</span>}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-emerald-700 hover:underline">
              {crumb.label}
            </a>
          ) : (
            <span class="text-stone-900 font-medium">{crumb.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
