---
import PlaceCategorySection from "./PlaceCategorySection.astro";
import type { getEvCharging } from "../lib/data";

interface Props {
  ev: NonNullable<ReturnType<typeof getEvCharging>>;
  outcode: string;
  boroughName: string;
}

const { ev, outcode, boroughName } = Astro.props;
const nf = new Intl.NumberFormat("en-GB");
const nearby = ev.nearby;
const list = nearby.slice(0, 12);
const mapsUrl = (s: { latitude: number; longitude: number; name: string }) => `https://www.google.com/maps/search/?api=1&query=${s.latitude},${s.longitude}`;

const rows = ev.borough
  ? [
      { label: "Public charging devices", local: nf.format(ev.borough.devices), london: nf.format(ev.london.devices) },
      { label: "Devices per 100,000 residents", local: nf.format(ev.borough.devicesPer100k), london: nf.format(ev.london.devicesPer100k), better: ev.borough.devicesPer100k > ev.london.devicesPer100k },
      { label: "Rapid devices (50 kW or more)", local: nf.format(ev.borough.rapidDevices), london: nf.format(ev.london.rapidDevices) },
      { label: "Rapid devices per 100,000 residents", local: ev.borough.rapidPer100k.toFixed(1), london: ev.london.rapidPer100k.toFixed(1), better: ev.borough.rapidPer100k > ev.london.rapidPer100k },
    ]
  : [];
---

<section class="mb-8">
  <h2 class="text-lg font-semibold mb-1">EV charge points</h2>
  <p class="text-sm text-stone-500 mb-3">Public electric vehicle charging in {boroughName}, and the charge points mapped within a mile of {outcode}.</p>

  {
    ev.borough && (
      <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white mb-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
              <th class="px-4 py-2 font-semibold">{boroughName} (all public devices, {ev.period})</th>
              <th class="px-4 py-2 font-semibold text-right">{boroughName}</th>
              <th class="px-4 py-2 font-semibold text-right">London</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-stone-100 last:border-0">
                <td class="px-4 py-2">{r.label}</td>
                <td class="px-4 py-2 text-right">
                  {r.local}
                  {r.better !== undefined && (
                    <span class:list={["ml-1.5", r.better ? "text-emerald-600" : "text-red-600"]} title={r.better ? "Better than the London average" : "Worse than the London average"}>
                      {r.better ? "▲" : "▼"}
                    </span>
                  )}
                </td>
                <td class="px-4 py-2 text-right text-stone-500">{r.london}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    nearby.length > 0 ? (
      <PlaceCategorySection cat={{ key: "ev", label: "Mapped charge points within a mile" }} items={list} mapId={`ev-${outcode}`}>
        {list.map((s) => (
          <div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4">
            <span class="pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none text-emerald-700" aria-hidden="true">⚡</span>
            <div class="relative pr-8">
              <p class="font-medium">{s.name}</p>
              {s.operator && s.operator !== s.name && <p class="text-sm text-stone-500 mt-1">{s.operator}</p>}
              <p class="text-xs text-stone-400 mt-1">
                {s.capacity ? `${s.capacity} charge point${s.capacity === 1 ? "" : "s"}` : "Charge points not recorded"} &middot; {(s.distanceKm * 0.621371).toFixed(1)} mi away
              </p>
            </div>
            <a
              href={mapsUrl(s)}
              target="_blank"
              rel="noopener"
              aria-label={`Get directions to ${s.name}`}
              title="Get directions"
              class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full text-stone-400 hover:bg-stone-100 hover:text-emerald-700 transition-colors"
            >
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        ))}
      </PlaceCategorySection>
    ) : (
      <p class="text-sm text-stone-600 rounded-lg border border-stone-200 bg-white p-4">No mapped charge points within a mile of {outcode}. Many kerbside chargers are not on the map, so check a charging app for the streets you need.</p>
    )
  }

  <p class="text-xs text-stone-400 mt-3">
    Sources: {ev.source}. The borough totals count every public device (lamp-post and kerbside units included); the map shows only stations someone has added to
    OpenStreetMap, so it will miss some. {nearby.length > list.length ? `Showing the nearest ${list.length} of ${nearby.length}.` : ""}
  </p>
</section>
