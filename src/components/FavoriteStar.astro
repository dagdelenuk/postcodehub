---
interface Props {
  favKey: string;
  size?: "sm" | "md";
}

const { favKey, size = "md" } = Astro.props;
const dims = size === "sm" ? "14" : "18";
---

<button
  type="button"
  data-favorite-star
  data-favorite-key={favKey}
  aria-label="Add to favourites"
  aria-pressed="false"
  class="favorite-star-btn inline-flex items-center justify-center h-7 w-7 rounded-full hover:bg-stone-100 transition-colors shrink-0"
>
  <svg data-star-fill width={dims} height={dims} viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M10 1.6l2.53 5.12 5.65.82-4.09 3.99.97 5.63L10 14.4l-5.06 2.66.97-5.63-4.09-3.99 5.65-.82L10 1.6z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
  </svg>
</button>

<script>
  const STORAGE_KEY = "postcodehub:favorites";

  function getFavorites(): Set<string> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return new Set(raw ? (JSON.parse(raw) as string[]) : []);
    } catch {
      return new Set();
    }
  }

  function saveFavorites(favs: Set<string>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...favs]));
    } catch {
      // localStorage unavailable (private mode, quota, etc.) - favouriting just silently no-ops.
    }
  }

  function applyStarVisual(btn: HTMLElement, isFav: boolean) {
    btn.setAttribute("aria-pressed", String(isFav));
    const path = btn.querySelector("path");
    if (path) {
      path.setAttribute("fill", isFav ? "#f59e0b" : "none");
      path.setAttribute("stroke", isFav ? "#f59e0b" : "currentColor");
    }
  }

  function reorderFavoriteLists(favs: Set<string>) {
    document.querySelectorAll<HTMLElement>("[data-favorite-list]").forEach((list) => {
      const items = [...list.children] as HTMLElement[];
      for (const el of items) {
        const key = el.dataset.favoriteKey;
        el.classList.toggle("is-favorited-item", Boolean(key && favs.has(key)));
      }
      // Some lists (e.g. an alphabetical "London Boroughs"/"Postcodes" listing)
      // want the highlight above without the reorder-to-front - the sort order
      // itself is the point, favourites should just stand out in place.
      if (list.dataset.noReorder !== undefined) return;
      const favItems = items.filter((el) => el.dataset.favoriteKey && favs.has(el.dataset.favoriteKey));
      const rest = items.filter((el) => !favItems.includes(el));
      for (const el of [...favItems, ...rest]) {
        list.appendChild(el);
      }
    });
  }

  const STAR_SVG = `<svg data-star-fill width="14" height="14" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 1.6l2.53 5.12 5.65.82-4.09 3.99.97 5.63L10 14.4l-5.06 2.66.97-5.63-4.09-3.99 5.65-.82L10 1.6z" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.3" stroke-linejoin="round" /></svg>`;

  function wireStar(btn: HTMLElement) {
    const key = btn.dataset.favoriteKey;
    if (!key) return;
    const favs = getFavorites();
    applyStarVisual(btn, favs.has(key));
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const current = getFavorites();
      if (current.has(key)) current.delete(key);
      else current.add(key);
      saveFavorites(current);
      applyStarVisual(btn, current.has(key));
      reorderFavoriteLists(current);
      renderFavouritesSection(current);
    });
  }

  interface FavouriteEntry {
    label: string;
    sublabel: string;
    href: string;
    thumb?: string;
    type: "city" | "borough" | "outcode";
    sortKey: string;
  }

  const FAVOURITE_TYPE_ORDER: Record<FavouriteEntry["type"], number> = { city: 0, borough: 1, outcode: 2 };

  /**
   * Renders the "Your Favourites" roll-up (cities, then boroughs, then
   * postcodes, each A-Z) from the page's embedded lookup - see
   * favouritesLookup in index.astro/[city]/index.astro/[city]/[borough]/index.astro.
   * No-ops on pages without this markup.
   */
  function renderFavouritesSection(favs: Set<string>) {
    const section = document.querySelector<HTMLElement>("[data-favourites-section]");
    const list = document.querySelector<HTMLElement>("[data-favourites-list]");
    const lookupEl = document.getElementById("favourites-lookup");
    if (!section || !list || !lookupEl) return;

    let lookup: Record<string, FavouriteEntry>;
    try {
      lookup = JSON.parse(lookupEl.textContent ?? "{}");
    } catch {
      return;
    }

    const entries = [...favs]
      .map((key) => ({ key, entry: lookup[key] }))
      .filter((e): e is { key: string; entry: FavouriteEntry } => Boolean(e.entry))
      .sort((a, b) => {
        const typeDiff = FAVOURITE_TYPE_ORDER[a.entry.type] - FAVOURITE_TYPE_ORDER[b.entry.type];
        return typeDiff !== 0 ? typeDiff : a.entry.sortKey.localeCompare(b.entry.sortKey);
      });

    if (entries.length === 0) {
      section.classList.add("hidden");
      list.innerHTML = "";
      return;
    }

    section.classList.remove("hidden");
    list.innerHTML = "";
    for (const { key, entry } of entries) {
      // Star button is a sibling of the <a>, not nested inside it - buttons
      // can't validly nest inside anchors (same reason the static cards in
      // index.astro/[city]/index.astro/[borough]/index.astro wrap both in a
      // position:relative div rather than putting the star inside the link).
      const wrapper = document.createElement("div");
      wrapper.className = "is-favorited-item relative rounded-lg border border-stone-200 bg-white transition-colors";
      const img = entry.thumb ? `<img src="${entry.thumb}" alt="" class="h-12 w-12 shrink-0 rounded-md object-cover">` : "";
      wrapper.innerHTML = `
        <a href="${entry.href}" class="flex items-center gap-3 p-4 pr-9 hover:border-emerald-600 rounded-lg transition-colors">
          ${img}
          <span class="flex-1 min-w-0">
            <span class="block font-semibold truncate">${escapeHtml(entry.label)}</span>
            <span class="block text-sm text-stone-500 truncate">${escapeHtml(entry.sublabel)}</span>
          </span>
        </a>
        <button type="button" data-favorite-star data-favorite-key="${escapeHtml(key)}" aria-label="Remove from favourites" class="favorite-star-btn absolute top-1/2 -translate-y-1/2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full hover:bg-stone-100 transition-colors shrink-0">${STAR_SVG}</button>
      `;
      list.appendChild(wrapper);
      const star = wrapper.querySelector<HTMLElement>("[data-favorite-star]");
      if (star) wireStar(star);
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  }

  function init() {
    const favs = getFavorites();
    document.querySelectorAll<HTMLElement>("[data-favorite-star]").forEach((btn) => {
      wireStar(btn);
    });
    reorderFavoriteLists(favs);
    renderFavouritesSection(favs);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
