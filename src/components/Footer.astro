---
// Boroughs (and, when viewing a specific borough, its post towns) are pulled
// straight from the hierarchy at build time, so the footer always reflects
// whatever cities/boroughs/outcodes the site actually covers rather than a
// hand-maintained list that can drift out of date.
import { districtLocalName, getBorough, loadHierarchy, partitionDistrictsForNav } from "../lib/data";
import PartBadge from "./PartBadge.astro";

interface Props {
  citySlug?: string;
  boroughSlug?: string;
}

const { citySlug, boroughSlug } = Astro.props;

const hierarchy = loadHierarchy();
const city = hierarchy.cities[0];
const boroughs = city ? [...city.boroughs].sort((a, b) => a.name.localeCompare(b.name)) : [];

// Only populated when the current page has a borough in context (borough
// pages and their outcode subpages) - the homepage/city page has no single
// borough to show districts for.
const currentBorough = citySlug && boroughSlug ? getBorough(citySlug, boroughSlug) : undefined;
const districtGroups = currentBorough ? partitionDistrictsForNav(currentBorough.outcodes, city!.name) : null;
---

<footer class="border-t border-stone-200 bg-white mt-12">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-4">
      <div>
        <a href="/" class="text-2xl font-extrabold tracking-tight">
          Postcode<span class="text-emerald-700">Hub</span>.UK
        </a>
        <p class="mt-3 text-xs text-stone-500">
          Health, safety, transport, schools, and local civic data for UK neighbourhoods.
        </p>
        <p class="mt-2 text-xs text-stone-400">
          Built from open data: NHS Organisation Data Service, DfE Get Information about Schools, Ofsted,
          data.police.uk, OpenStreetMap, HM Land Registry, UK Parliament, and each local council.
        </p>
      </div>

      <div class="min-w-0">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-400">Explore</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/" class="text-stone-600 hover:text-emerald-700">Home</a></li>
          <li><a href="/compare/" class="text-stone-600 hover:text-emerald-700">Compare areas</a></li>
          {
            city && (
              <>
                <li>
                  <a href={`/${city.slug}/`} class="text-stone-600 hover:text-emerald-700">
                    {city.name}
                  </a>
                </li>
                <li>
                  <a href={`/${city.slug}/statistics/`} class="text-stone-600 hover:text-emerald-700">
                    Statistics
                  </a>
                </li>
              </>
            )
          }
        </ul>
      </div>

      {
        boroughs.length > 0 && (
          <div data-borough-list class:list={[!currentBorough && "sm:col-span-2"]}>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-400">
              Boroughs in<br />{city!.name}
            </h2>
            <ul class:list={["mt-3 text-sm", currentBorough ? "space-y-2" : "grid grid-cols-2 gap-x-6 gap-y-2"]}>
              {boroughs.slice(0, 10).map((b) => (
                <li>
                  <a href={`/${city!.slug}/${b.slug}/`} class="text-stone-600 hover:text-emerald-700">
                    {b.name}
                  </a>
                </li>
              ))}
            </ul>
            {
              boroughs.length > 10 && (
                <>
                  <ul
                    class:list={["mt-2 text-sm hidden", currentBorough ? "space-y-2" : "grid grid-cols-2 gap-x-6 gap-y-2"]}
                    data-boroughs-extra
                  >
                    {boroughs.slice(10).map((b) => (
                      <li>
                        <a href={`/${city!.slug}/${b.slug}/`} class="text-stone-600 hover:text-emerald-700">
                          {b.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <button type="button" class="mt-2 text-xs text-stone-400 hover:text-stone-600" data-boroughs-toggle>
                    Show more
                  </button>
                </>
              )
            }
          </div>
        )
      }

      {
        currentBorough && districtGroups && districtGroups.full.length + districtGroups.split.length > 0 && (
          <div class="min-w-0">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-400">
              Postcode districts in<br />{currentBorough.name}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              {districtGroups.full.map((o) => {
                const label = `${o.outcode} - ${districtLocalName(o, city!.name)}`;
                return (
                  <li class="min-w-0">
                    <a
                      href={`/${city!.slug}/${boroughSlug}/${o.slug}/`}
                      title={label}
                      class="block truncate text-stone-600 hover:text-emerald-700"
                    >
                      {label}
                    </a>
                  </li>
                );
              })}
            </ul>
            {
              districtGroups.split.length > 0 && (
                <>
                  <p class="mt-3 text-[11px] font-medium uppercase tracking-wide text-stone-400">Partly in this borough</p>
                  <ul class="mt-2 space-y-2 text-sm">
                    {districtGroups.split.map((o) => {
                      const label = `${o.outcode} - ${districtLocalName(o, city!.name)} (part)`;
                      return (
                        <li class="min-w-0">
                          <a
                            href={`/${city!.slug}/${boroughSlug}/${o.slug}/`}
                            title={label}
                            class="flex min-w-0 items-center text-stone-600 hover:text-emerald-700"
                          >
                            <span class="truncate">
                              {o.outcode} - {districtLocalName(o, city!.name)}
                            </span>
                            <PartBadge borough={currentBorough.name} />
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </>
              )
            }
          </div>
        )
      }
    </div>

    <div class="mt-8 pt-6 border-t border-stone-100 flex flex-wrap items-center gap-x-4 gap-y-2" data-install-row>
      <button
        type="button"
        class="inline-flex items-center gap-2 text-sm text-emerald-700 hover:underline"
        data-install-app
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Install PostcodeHub as an app
      </button>
      <span class="text-xs text-stone-400">Works offline for pages you've visited. No app store needed.</span>
    </div>

    <dialog class="m-auto rounded-xl border border-stone-200 p-0 backdrop:bg-stone-900/40 max-w-sm w-[calc(100%-2rem)]" data-install-dialog>
      <div class="p-5">
        <h2 class="text-base font-semibold mb-2">Install PostcodeHub</h2>
        <p class="text-sm text-stone-600" data-install-instructions></p>
        <form method="dialog" class="mt-4 text-right">
          <button class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 transition-colors">Got it</button>
        </form>
      </div>
    </dialog>

    <p class="mt-6 pt-6 border-t border-stone-100 text-center text-xs text-stone-400">
      PostcodeHub.UK is an independent project and is not affiliated with Royal Mail, the NHS, the Metropolitan
      Police, or any local council.
    </p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLElement>("[data-borough-list]").forEach((container) => {
    const extra = container.querySelector<HTMLElement>("[data-boroughs-extra]");
    const toggle = container.querySelector<HTMLElement>("[data-boroughs-toggle]");
    if (!extra || !toggle) return;
    toggle.addEventListener("click", () => {
      extra.classList.remove("hidden");
      toggle.remove();
    });
  });
</script>

<script>
  // "Install as app". Chrome/Edge/Android offer a real install prompt (beforeinstallprompt); Safari and Firefox don't, so
  // there we explain how to add it from the browser's own menu. Hidden once the site is already running as an installed app.
  interface InstallPromptEvent extends Event {
    prompt(): Promise<void>;
    userChoice: Promise<{ outcome: "accepted" | "dismissed" }>;
  }

  const row = document.querySelector<HTMLElement>("[data-install-row]");
  const button = document.querySelector<HTMLButtonElement>("[data-install-app]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-install-dialog]");
  const instructions = document.querySelector<HTMLElement>("[data-install-instructions]");
  let deferred: InstallPromptEvent | null = null;

  const installed = () => window.matchMedia("(display-mode: standalone)").matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
  if (installed()) row?.remove();

  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();
    deferred = event as InstallPromptEvent;
  });
  window.addEventListener("appinstalled", () => row?.remove());

  function instructionsFor(ua: string): string {
    const isIos = /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    if (isIos) return "Tap the Share button in Safari, then choose Add to Home Screen.";
    if (/Android/.test(ua)) return "Open your browser menu (the three dots) and choose Install app or Add to Home screen.";
    if (/Firefox/.test(ua)) return "Firefox on desktop can't install web apps. Open PostcodeHub in Chrome, Edge or Safari to install it.";
    if (/Edg\//.test(ua)) return "Click the install icon at the right of the address bar, or open the menu and choose Apps, then Install this site as an app.";
    if (/Chrome\//.test(ua)) return "Click the install icon at the right of the address bar, or open the menu and choose Cast, save and share, then Install page as app.";
    if (/Safari\//.test(ua)) return "In the Safari menu bar choose File, then Add to Dock.";
    return "Use your browser's menu and look for Install or Add to Home Screen.";
  }

  button?.addEventListener("click", async () => {
    if (deferred) {
      await deferred.prompt();
      await deferred.userChoice;
      deferred = null; // a prompt can only be used once
      return;
    }
    if (instructions) instructions.textContent = instructionsFor(navigator.userAgent);
    dialog?.showModal();
  });
</script>
