---
import type { GpSurgery } from "../lib/types";

interface Props {
  org: GpSurgery;
  kind: "gp" | "dentist" | "pharmacy";
}

const { org, kind } = Astro.props;

const ICONS: Record<Props["kind"], { emoji: string; text: string }> = {
  gp: { emoji: "🏥", text: "text-rose-600" },
  dentist: { emoji: "🦷", text: "text-cyan-600" },
  pharmacy: { emoji: "💊", text: "text-emerald-600" },
};

const icon = ICONS[kind];
---

<div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4">
  <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", icon.text]} aria-hidden="true">
    {icon.emoji}
  </span>
  <div class="relative">
    <p class="font-medium">{org.name}</p>
    <p class="text-sm text-stone-500 mt-1">{org.address || org.postcode}</p>
    {org.telephone && <p class="text-sm text-stone-500">{org.telephone}</p>}
  </div>
</div>
