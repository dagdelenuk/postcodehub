---
import type { GpSurgery } from "../lib/types";

interface Props {
  org: GpSurgery;
  kind: "gp" | "dentist" | "pharmacy" | "hospital";
  /** Only set on the borough page, where each section is one outcode's post town - used to tag cards for the Post town filter. */
  postTown?: string;
}

const { org, kind, postTown } = Astro.props;

const ICONS: Record<Props["kind"], { emoji: string; text: string }> = {
  gp: { emoji: "🩺", text: "text-rose-600" },
  dentist: { emoji: "🦷", text: "text-cyan-600" },
  pharmacy: { emoji: "💊", text: "text-emerald-600" },
  hospital: { emoji: "🏥", text: "text-red-600" },
};

const icon = ICONS[kind];
const addressLine = org.address || org.postcode;
const mapsUrl = addressLine
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${org.name}, ${addressLine}`)}`
  : null;
const telHref = org.telephone ? `tel:${org.telephone.replace(/[^\d+]/g, "")}` : null;
---

<div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4" data-health-card data-health-kind={kind} data-health-post-town={postTown}>
  <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", icon.text]} aria-hidden="true">
    {icon.emoji}
  </span>
  <div class="relative pr-8">
    <p class="font-medium">{org.name}</p>
    <p class="text-sm text-stone-500 mt-1">{addressLine}</p>
    {telHref && (
      <p class="text-sm mt-2">
        <a href={telHref} class="text-stone-500 hover:text-emerald-700 hover:underline">
          {org.telephone}
        </a>
      </p>
    )}
  </div>
  {mapsUrl && (
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Get directions to ${org.name}`}
      title="Get directions"
      class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full text-stone-400 hover:bg-stone-100 hover:text-emerald-700 transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      </svg>
    </a>
  )}
</div>
