---
// Disruption status is fetched client-side per the pipeline doc's "live API
// fallback" strategy: TfL status changes constantly, so it must never be
// baked into the static build. Which lines actually run near this outcode is
// a build-time geographic fact instead (see fetch-transport.ts) - `lines`
// filters the live fetch down to only those, so an outcode with no nearby
// Underground/DLR/Overground/Elizabeth line/Tram access (e.g. TW11/Teddington,
// which only has a National Rail station) doesn't show unrelated tube delays.
interface Props {
  lines: string[];
  nearestStationName?: string;
}

const { lines, nearestStationName } = Astro.props;
---

<div class="rounded-lg border border-stone-200 bg-white p-4" data-tfl-widget data-lines={JSON.stringify(lines)} data-nearest-station={nearestStationName ?? ""}>
  <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">Live TfL status</p>
  <ul data-tfl-output class="text-sm text-stone-600 space-y-1">
    <li>Loading live status&hellip;</li>
  </ul>
</div>

<script>
  interface TflLine {
    id: string;
    name: string;
    modeName: string;
    lineStatuses: { statusSeverityDescription: string }[];
  }

  document.querySelectorAll<HTMLElement>("[data-tfl-widget]").forEach(async (widget) => {
    const output = widget.querySelector<HTMLElement>("[data-tfl-output]");
    if (!output) return;

    const lines: string[] = JSON.parse(widget.dataset.lines ?? "[]");
    const nearestStationName = widget.dataset.nearestStation;

    if (lines.length === 0) {
      output.innerHTML = "";
      const li = document.createElement("li");
      li.textContent = "No Underground, DLR, Overground, Elizabeth line, or Tram stations within 1.5km of this area.";
      output.appendChild(li);
      if (nearestStationName) {
        const li2 = document.createElement("li");
        li2.textContent = `Nearest station: ${nearestStationName} — see National Rail Live Departures below.`;
        output.appendChild(li2);
      }
      return;
    }

    try {
      const res = await fetch("https://api.tfl.gov.uk/Line/Mode/tube,dlr,overground,elizabeth-line,tram/Status");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const allLines: TflLine[] = await res.json();
      const relevant = allLines.filter((l) => lines.includes(l.id));
      const disrupted = relevant.filter((l) => !l.lineStatuses.every((s) => s.statusSeverityDescription === "Good Service"));

      output.innerHTML = "";
      if (disrupted.length === 0) {
        const li = document.createElement("li");
        li.textContent = "✅ Good service on all lines";
        output.appendChild(li);
      } else {
        for (const line of disrupted.slice(0, 6)) {
          const li = document.createElement("li");
          li.textContent = `⚠️ ${line.name}: ${line.lineStatuses.map((s) => s.statusSeverityDescription).join(", ")}`;
          output.appendChild(li);
        }
      }
    } catch {
      output.innerHTML = '<li>Live status unavailable right now.</li>';
    }
  });
</script>
