---
import type { GreenspaceMetrics } from "../lib/types";

interface Column {
  label: string;
  noise: number[] | null;
  green: GreenspaceMetrics | null;
}

interface Props {
  /** First column is the area being viewed; the last is London. */
  columns: Column[];
  noiseLabels: string[];
  noiseModelled: string;
  noiseSource: string;
  greenSource: string;
  greenYear: number;
  /** Where the noise picture is drawn from, e.g. "within a mile of the centre of TW11". */
  noiseScope: string;
}

const { columns, noiseLabels, noiseModelled, noiseSource, greenSource, greenYear, noiseScope } = Astro.props;
const focus = columns[0];
const london = columns[columns.length - 1];
const withNoise = columns.filter((c) => c.noise);
const hasGreen = columns.some((c) => c.green);

// Defra's own band colours, quietest to loudest.
const NOISE_COLOURS = ["#f5f5f4", "#b8d6d1", "#cee4cc", "#e2f2bf", "#f3c683", "#e87e4d", "#cd463e", "#a11a4d", "#75085c", "#430a4a"];
const sum = (b: number[], from: number, to = b.length) => b.slice(from, to).reduce((a, x) => a + x, 0);
const p1 = (n: number | null | undefined) => (n == null ? "n/a" : `${n.toFixed(1)}%`);
const nf = new Intl.NumberFormat("en-GB");

const NOISE_ROWS = [
  { label: "Area with under 45 dB (quiet)", get: (b: number[]) => sum(b, 0, 2), goodHigh: true },
  { label: "Area at 55 dB or more (noticeable)", get: (b: number[]) => sum(b, 4), goodHigh: false },
  { label: "Area at 65 dB or more (loud)", get: (b: number[]) => sum(b, 6), goodHigh: false },
];

const GREEN_ROWS: { label: string; get: (g: GreenspaceMetrics) => number | null; format: (n: number) => string; goodHigh: boolean }[] = [
  { label: "Average distance to the nearest park", get: (g) => g.parkDistanceM, format: (n) => `${nf.format(n)} m`, goodHigh: false },
  { label: "Parks and playing fields within 1 km (average)", get: (g) => g.parksWithin1km, format: (n) => n.toFixed(1), goodHigh: true },
  { label: "Postcodes within 300 m of a park", get: (g) => g.within300m, format: (n) => `${n.toFixed(1)}%`, goodHigh: true },
  { label: "Postcodes within 900 m of a park", get: (g) => g.within900m, format: (n) => `${n.toFixed(1)}%`, goodHigh: true },
  { label: "Homes with a private garden or outdoor space", get: (g) => g.gardenShare, format: (n) => `${n.toFixed(1)}%`, goodHigh: true },
  { label: "Average size of that outdoor space", get: (g) => g.gardenAvgSizeM2, format: (n) => `${nf.format(n)} m²`, goodHigh: true },
];
---

{
  withNoise.length > 0 && (
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-1">Road noise</h3>
      <p class="text-sm text-stone-500 mb-3">
        Average road traffic noise over a 24 hour day (Lden, which counts evening and night noise more heavily), across the area {noiseScope}, as modelled by Defra in {noiseModelled}. A typical quiet
        residential street is around 45 dB and a busy main road above 65 dB.
      </p>
      <div class="rounded-lg border border-stone-200 bg-white p-4 mb-3">
        {withNoise.map((c) => (
          <div class="mb-4 last:mb-2">
            <p class="text-sm font-medium mb-1">{c.label}</p>
            <div class="flex h-5 w-full overflow-hidden rounded bg-stone-100" role="img" aria-label={`${c.label}: share of area by road noise band`}>
              {c.noise!.map((share, i) => <div style={`width:${share}%;background:${NOISE_COLOURS[i]}`} title={`${noiseLabels[i]}: ${p1(share)}`}></div>)}
            </div>
          </div>
        ))}
        <div class="flex items-center gap-2 text-xs text-stone-500 mt-3 pt-3 border-t border-stone-100">
          <span class="shrink-0">Quieter</span>
          <div class="flex flex-1 overflow-hidden rounded">
            {NOISE_COLOURS.map((colour, i) => (
              <div class:list={["flex-1 py-0.5 text-center text-[9px] font-medium", i >= 6 ? "text-white" : "text-stone-800"]} style={`background:${colour}`} title={noiseLabels[i]}>
                {i === 0 ? "<40" : i === 9 ? "80+" : `${35 + i * 5}`}
              </div>
            ))}
          </div>
          <span class="shrink-0">Louder</span>
        </div>
      </div>
      {focus.noise && (
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="px-4 py-2 font-semibold"></th>
                {columns.filter((c) => c.noise).map((c) => <th class="px-4 py-2 font-semibold text-right">{c.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {NOISE_ROWS.map((row) => {
                const lon = london.noise ? row.get(london.noise) : null;
                return (
                  <tr class="border-b border-stone-100 last:border-0">
                    <td class="px-4 py-2">{row.label}</td>
                    {columns.filter((c) => c.noise).map((c) => {
                      const v = row.get(c.noise!);
                      const isFocus = c === focus;
                      const better = isFocus && lon !== null && c !== london && Math.abs(v - lon) >= 0.05 ? (row.goodHigh ? v > lon : v < lon) : null;
                      return (
                        <td class:list={["px-4 py-2 text-right", !isFocus && "text-stone-500"]}>
                          {p1(v)}
                          {better !== null && (
                            <span class:list={["ml-1.5", better ? "text-emerald-600" : "text-red-600"]} title={better ? "Better than the London average" : "Worse than the London average"}>
                              {v > lon! ? "▲" : "▼"}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      <p class="text-xs text-stone-400 mt-2">
        Source: {noiseSource}. Road noise only: rail and aircraft noise are not included, and modelled noise is an estimate, not a measurement at your door. Quiet Richmond Park or
        Hampstead Heath type areas pull an area's average down.
      </p>
    </div>
  )
}

{
  hasGreen && (
    <div class="mb-4">
      <h3 class="text-lg font-semibold mb-1">Green space and gardens</h3>
      <p class="text-sm text-stone-500 mb-3">How close homes are to a park, public garden or playing field, and how many have a private garden or outdoor space ({greenYear} data).</p>
      <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
              <th class="px-4 py-2 font-semibold"></th>
              {columns.map((c) => <th class="px-4 py-2 font-semibold text-right">{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {GREEN_ROWS.map((row) => {
              const lon = london.green ? row.get(london.green) : null;
              return (
                <tr class="border-b border-stone-100 last:border-0">
                  <td class="px-4 py-2">{row.label}</td>
                  {columns.map((c) => {
                    const v = c.green ? row.get(c.green) : null;
                    const isFocus = c === focus;
                    const better = isFocus && v !== null && lon !== null && c !== london && v !== lon ? (row.goodHigh ? v > lon : v < lon) : null;
                    return (
                      <td class:list={["px-4 py-2 text-right", !isFocus && "text-stone-500"]}>
                        {v === null ? "n/a" : row.format(v)}
                        {better !== null && (
                          <span class:list={["ml-1.5", better ? "text-emerald-600" : "text-red-600"]} title={better ? "Better than the London average" : "Worse than the London average"}>
                            {v! > lon! ? "▲" : "▼"}
                          </span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-stone-400 mt-2">
        Source: {greenSource}. Park access covers built-up areas; sites labelled playing fields may be private. The data is from 2020 and is the latest published national set.
      </p>
    </div>
  )
}
