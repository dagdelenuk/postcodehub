---
interface Props {
  /** The borough this badge is shown in, for the tooltip - "Only part of this district is in {borough}." */
  borough?: string;
}

const { borough } = Astro.props;
---

<span
  class="ml-1 inline-flex items-center rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-amber-800 align-middle"
  title={borough ? `Only part of this district is in ${borough}` : "This district is shared with a neighbouring borough"}
>
  part
</span>
