---
import type { Place } from "../lib/types";
import { PLACE_CATEGORY_MAP } from "../lib/place-categories";

interface Props {
  place: Place;
  /** Only set on the borough page, where each section is one outcode's post town - used to tag cards for the Post town filter. */
  postTown?: string;
}

const { place, postTown } = Astro.props;
const category = PLACE_CATEGORY_MAP[place.category];
const addressLine = place.address;
// Every place has coordinates (unlike health/station/school records, which
// can lack them), so fall back to a "name @ lat,lon" query rather than
// hiding the directions icon whenever OSM has no structured address - common
// for parks and open spaces.
const mapsQuery = addressLine ? `${place.name}, ${addressLine}` : `${place.name} @ ${place.latitude},${place.longitude}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`;
---

<div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4" data-place-card data-place-kind={place.category} data-place-post-town={postTown}>
  <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", category.colorClass]} aria-hidden="true">
    {category.emoji}
  </span>
  <div class="relative pr-8">
    <p class="font-medium">{place.name}</p>
    {addressLine && <p class="text-sm text-stone-500 mt-1">{addressLine}</p>}
    {place.website && (
      <p class="text-sm mt-1">
        <a href={place.website} target="_blank" rel="noopener" class="text-emerald-700 hover:underline truncate block">
          Website
        </a>
      </p>
    )}
    <p class="text-xs text-stone-400 mt-1">{(place.distanceKm * 0.621371).toFixed(1)} mi away</p>
  </div>
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Get directions to ${place.name}`}
    title="Get directions"
    class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full text-stone-400 hover:bg-stone-100 hover:text-emerald-700 transition-colors"
  >
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
  </a>
</div>
