---
import type { PlaceCategory } from "../lib/types";
import { PLACE_CATEGORIES } from "../lib/place-categories";

interface Props {
  counts: Partial<Record<PlaceCategory, number>>;
  /** Only passed on the borough places page - one pill per post town, filtering by whole outcode group. */
  postTowns?: string[];
}

const { counts, postTowns = [] } = Astro.props;

const available = PLACE_CATEGORIES.filter((c) => (counts[c.key] ?? 0) > 0);
const PILL_BASE = "text-xs px-3 py-1 rounded-full border whitespace-nowrap transition-colors";

const hasAnyFilters = available.length > 1 || postTowns.length > 1;
---

{
  hasAnyFilters && (
    <div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-2" data-places-filters>
        {postTowns.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs text-stone-400">Post town:</span>
            {postTowns.map((t) => (
              <button type="button" class={PILL_BASE} data-filter-group="postTown" data-filter-value={t}>
                {t}
              </button>
            ))}
          </div>
        )}
        {available.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs text-stone-400">Type:</span>
            {available.map((c) => (
              <button type="button" class={PILL_BASE} data-filter-group="kind" data-filter-value={c.key}>
                {c.label}
              </button>
            ))}
          </div>
        )}
        <button type="button" class="text-xs text-stone-400 underline hidden" data-filter-clear>
          Clear filters
        </button>
      </div>
      <p class="text-xs text-stone-400 mb-6" data-filter-count />
    </div>
  )
}

<style>
  [data-filter-group] {
    border-color: #d6d3d1;
    color: #57534e;
    background: white;
  }
  [data-filter-group].is-active {
    border-color: #059669;
    background: #ecfdf5;
    color: #065f46;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-places-filters]").forEach((bar) => {
    const pills = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter-group]")];
    const clearBtn = bar.querySelector<HTMLElement>("[data-filter-clear]");
    const countEl = document.querySelector<HTMLElement>("[data-filter-count]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-place-card]")];
    const typeBlocks = [...document.querySelectorAll<HTMLElement>("[data-place-type-block]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-place-group]")];
    const totalCount = cards.length;

    // active[group] = Set of selected values for that facet; empty set = no filter on that facet
    const active: Record<string, Set<string>> = {};

    function apply() {
      const activeGroups = Object.entries(active).filter(([, set]) => set.size > 0);
      let visible = 0;
      for (const card of cards) {
        const matches = activeGroups.every(([group, values]) => values.has(card.dataset[`place${group[0].toUpperCase()}${group.slice(1)}`] ?? ""));
        card.classList.toggle("hidden", !matches);
        if (matches) visible++;
      }
      for (const block of typeBlocks) {
        const anyVisible = [...block.querySelectorAll<HTMLElement>("[data-place-card]")].some((c) => !c.classList.contains("hidden"));
        block.classList.toggle("hidden", !anyVisible);
      }
      for (const group of groups) {
        const anyVisible = [...group.querySelectorAll<HTMLElement>("[data-place-type-block]")].some((b) => !b.classList.contains("hidden"));
        group.classList.toggle("hidden", !anyVisible);
      }
      clearBtn?.classList.toggle("hidden", activeGroups.length === 0);
      if (countEl) countEl.textContent = activeGroups.length > 0 ? `Showing ${visible} of ${totalCount} results` : "";
    }

    pills.forEach((pill) => {
      const group = pill.dataset.filterGroup!;
      const value = pill.dataset.filterValue!;
      active[group] ??= new Set();
      pill.addEventListener("click", () => {
        if (active[group].has(value)) active[group].delete(value);
        else active[group].add(value);
        pill.classList.toggle("is-active", active[group].has(value));
        apply();
      });
    });

    clearBtn?.addEventListener("click", () => {
      for (const key of Object.keys(active)) active[key].clear();
      pills.forEach((p) => p.classList.remove("is-active"));
      apply();
    });
  });
</script>
