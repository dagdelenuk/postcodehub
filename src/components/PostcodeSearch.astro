---
import { getPostcodeSearchIndex, getQuickSearchIndex } from "../lib/data";

const index = getPostcodeSearchIndex();
const quickSearchIndex = getQuickSearchIndex();

const TYPE_ICON: Record<string, string> = {
  city: "🏙️",
  borough: "🏘️",
  outcode: "📮",
};
---

<div data-postcode-search class="relative w-full max-w-xs">
  <form data-postcode-search-form class="flex items-center gap-2">
    <label for="postcode-search-input" class="sr-only">Search by postcode, place, or ward</label>
    <input
      id="postcode-search-input"
      type="text"
      inputmode="text"
      autocomplete="off"
      placeholder="Search a postcode (e.g. TW9)"
      data-postcode-search-input
      class="w-full rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600"
    />
    <button
      type="submit"
      aria-label="Search"
      class="flex items-center justify-center h-8 w-8 shrink-0 rounded-md text-stone-600 hover:bg-stone-100 hover:text-stone-900 transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="7" cy="7" r="5.2" stroke="currentColor" stroke-width="1.6" />
        <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </form>
  <p data-postcode-search-message class="hidden absolute left-0 top-full mt-1 text-xs text-stone-500 bg-white border border-stone-200 rounded-md px-3 py-2 shadow-sm z-10"></p>
  <ul data-postcode-search-results class="hidden absolute left-0 top-full mt-1 w-96 max-w-[90vw] max-h-80 overflow-y-auto bg-white border border-stone-200 rounded-md shadow-sm z-10 py-1"></ul>
</div>

<script type="application/json" id="postcode-search-index" set:html={JSON.stringify(index)} />
<script type="application/json" id="postcode-quick-search-index" set:html={JSON.stringify(quickSearchIndex)} />
<script type="application/json" id="postcode-search-type-icon" set:html={JSON.stringify(TYPE_ICON)} />

<script>
  interface QuickSearchEntry {
    type: "city" | "borough" | "outcode";
    label: string;
    sublabel: string;
    href: string;
    keywords: string;
    wards?: string[];
  }

  /** Same "word starts with, or plain substring" rule used for whole-entry scoring, applied to one ward name. */
  function wardMatches(ward: string, q: string): boolean {
    const lower = ward.toLowerCase();
    return lower.split(/[\s,&]+/).some((word) => word.startsWith(q)) || lower.includes(q);
  }

  function postcodeToOutcode(raw: string): string | null {
    const normalised = raw.trim().toUpperCase().replace(/\s+/g, "");
    const match = normalised.match(/^([A-Z]{1,2}\d[A-Z\d]?)\d[A-Z]{2}$/);
    if (match) return match[1];
    // The input might already just be an outcode ("TW9") rather than a full postcode.
    const outcodeMatch = normalised.match(/^[A-Z]{1,2}\d[A-Z\d]?$/);
    return outcodeMatch ? normalised : null;
  }

  const TYPE_ORDER: Record<string, number> = { city: 0, borough: 1, outcode: 2 };

  function rankResults(entries: QuickSearchEntry[], query: string): QuickSearchEntry[] {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    const scored: { entry: QuickSearchEntry; score: number }[] = [];
    for (const entry of entries) {
      const label = entry.label.toLowerCase();
      let score: number;
      if (label.startsWith(q)) score = 0;
      else if (entry.keywords.split(" ").some((word) => word.startsWith(q))) score = 1;
      else if (entry.keywords.includes(q)) score = 2;
      else continue;
      scored.push({ entry, score });
    }
    scored.sort((a, b) => a.score - b.score || TYPE_ORDER[a.entry.type] - TYPE_ORDER[b.entry.type] || a.entry.label.localeCompare(b.entry.label));
    return scored.slice(0, 10).map((s) => s.entry);
  }

  document.querySelectorAll<HTMLElement>("[data-postcode-search]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-postcode-search-form]");
    const input = root.querySelector<HTMLInputElement>("[data-postcode-search-input]");
    const message = root.querySelector<HTMLElement>("[data-postcode-search-message]");
    const results = root.querySelector<HTMLUListElement>("[data-postcode-search-results]");
    const indexEl = document.getElementById("postcode-search-index");
    const quickIndexEl = document.getElementById("postcode-quick-search-index");
    const typeIconEl = document.getElementById("postcode-search-type-icon");
    if (!form || !input || !message || !results || !indexEl || !quickIndexEl || !typeIconEl) return;

    let index: Record<string, string>;
    let quickIndex: QuickSearchEntry[];
    let typeIcon: Record<string, string>;
    try {
      index = JSON.parse(indexEl.textContent ?? "{}");
      quickIndex = JSON.parse(quickIndexEl.textContent ?? "[]");
      typeIcon = JSON.parse(typeIconEl.textContent ?? "{}");
    } catch {
      index = {};
      quickIndex = [];
      typeIcon = {};
    }

    function hideResults() {
      results!.classList.add("hidden");
      results!.innerHTML = "";
    }

    function renderResults(entries: QuickSearchEntry[], query: string) {
      results!.innerHTML = "";
      if (entries.length === 0) {
        hideResults();
        return;
      }
      const q = query.trim().toLowerCase();
      for (const entry of entries) {
        const li = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "w-full flex items-start gap-2 px-3 py-2 text-left text-sm hover:bg-stone-100 transition-colors";
        const icon = document.createElement("span");
        icon.className = "shrink-0";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = typeIcon[entry.type] ?? "";
        const text = document.createElement("span");
        text.className = "min-w-0";
        const label = document.createElement("span");
        label.className = "block font-medium truncate";
        label.textContent = entry.label;
        // For an outcode matched via a ward name, show the matching ward(s)
        // next to the postcode instead of the generic borough/city line -
        // that's specifically what the visitor searched for.
        const matchedWards = entry.wards?.filter((w) => wardMatches(w, q)) ?? [];
        const sublabel = document.createElement("span");
        sublabel.className = "block text-xs text-stone-500 truncate";
        sublabel.textContent = matchedWards.length > 0 ? matchedWards.join(", ") : entry.sublabel;
        text.append(label, sublabel);
        button.append(icon, text);
        // mousedown (not click) fires before the input's blur hides the list.
        button.addEventListener("mousedown", (e) => {
          e.preventDefault();
          window.location.href = entry.href;
        });
        li.appendChild(button);
        results!.appendChild(li);
      }
      results!.classList.remove("hidden");
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const outcode = postcodeToOutcode(input.value);
      const path = outcode ? index[outcode] : null;
      if (path) {
        window.location.href = path;
        return;
      }
      hideResults();
      message.textContent = outcode
        ? `${outcode} isn't covered yet - we're only live in London so far.`
        : "Enter a UK postcode or postcode area, e.g. \"TW9\" or \"TW9 3PZ\".";
      message.classList.remove("hidden");
    });

    input.addEventListener("input", () => {
      message.classList.add("hidden");
      renderResults(rankResults(quickIndex, input.value), input.value);
    });

    input.addEventListener("focus", () => {
      if (input.value.trim()) renderResults(rankResults(quickIndex, input.value), input.value);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hideResults();
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) hideResults();
    });
  });
</script>
