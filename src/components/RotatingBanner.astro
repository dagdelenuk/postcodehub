---
import type { BannerImage } from "../lib/types";

interface Props {
  images: BannerImage[];
}

const { images } = Astro.props;
const rotates = images.length > 1;
---

{
  images.length > 0 && (
    <div
      class="relative h-56 sm:h-72 overflow-hidden rounded-lg bg-stone-200 touch-pan-y"
      data-banner={rotates ? "rotating" : undefined}
    >
      {images.map((img, i) => (
        <img
          src={img.src}
          width={img.width}
          height={img.height}
          alt=""
          loading={i === 0 ? "eager" : "lazy"}
          class:list={["absolute inset-0 h-full w-full object-cover transition-opacity duration-1000", i === 0 ? "opacity-100" : "opacity-0"]}
          data-banner-slide
          data-credit={img.credit}
          data-credit-url={img.creditUrl}
        />
      ))}

      {rotates && (
        <>
          <button
            type="button"
            aria-label="Previous photo"
            data-banner-prev
            class="absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-8 w-8 rounded-full bg-black/30 text-white hover:bg-black/50 transition-colors"
          >
            ‹
          </button>
          <button
            type="button"
            aria-label="Next photo"
            data-banner-next
            class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-8 w-8 rounded-full bg-black/30 text-white hover:bg-black/50 transition-colors"
          >
            ›
          </button>
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5" data-banner-dots>
            {images.map((_, i) => (
              <button
                type="button"
                aria-label={`Go to photo ${i + 1}`}
                data-banner-dot
                class:list={["h-1.5 w-1.5 rounded-full transition-colors", i === 0 ? "bg-white" : "bg-white/40 hover:bg-white/70"]}
              />
            ))}
          </div>
        </>
      )}

      <a
        href={images[0].creditUrl}
        target="_blank"
        rel="noopener"
        data-banner-credit
        class="absolute bottom-1.5 right-2 rounded bg-black/40 px-2 py-0.5 text-[11px] text-white/90 hover:text-white hover:bg-black/60 transition-colors"
      >
        {images[0].credit}
      </a>
    </div>
  )
}

{
  rotates && (
    <script>
      document.querySelectorAll<HTMLElement>('[data-banner="rotating"]').forEach((banner) => {
        const slides = [...banner.querySelectorAll<HTMLImageElement>("[data-banner-slide]")];
        const dots = [...banner.querySelectorAll<HTMLButtonElement>("[data-banner-dot]")];
        const creditLink = banner.querySelector<HTMLAnchorElement>("[data-banner-credit]");
        const prevBtn = banner.querySelector<HTMLButtonElement>("[data-banner-prev]");
        const nextBtn = banner.querySelector<HTMLButtonElement>("[data-banner-next]");
        if (slides.length < 2) return;

        let current = 0;
        let timer: ReturnType<typeof setInterval>;

        function show(index: number) {
          slides[current].classList.remove("opacity-100");
          slides[current].classList.add("opacity-0");
          dots[current]?.classList.remove("bg-white");
          dots[current]?.classList.add("bg-white/40");

          current = (index + slides.length) % slides.length;

          slides[current].classList.remove("opacity-0");
          slides[current].classList.add("opacity-100");
          dots[current]?.classList.remove("bg-white/40");
          dots[current]?.classList.add("bg-white");
          if (creditLink) {
            creditLink.textContent = slides[current].dataset.credit ?? "";
            creditLink.href = slides[current].dataset.creditUrl ?? "#";
          }
        }

        function restartTimer() {
          clearInterval(timer);
          timer = setInterval(() => show(current + 1), 5000);
        }

        prevBtn?.addEventListener("click", () => {
          show(current - 1);
          restartTimer();
        });
        nextBtn?.addEventListener("click", () => {
          show(current + 1);
          restartTimer();
        });
        dots.forEach((dot, i) =>
          dot.addEventListener("click", () => {
            show(i);
            restartTimer();
          })
        );

        // Swipe/drag anywhere on the banner to move between photos - Pointer
        // Events cover touch, mouse, and pen with one API. touch-pan-y on the
        // container lets vertical page scroll still pass through untouched.
        const SWIPE_THRESHOLD_PX = 40;
        let startX = 0;
        let startY = 0;
        let tracking = false;

        banner.addEventListener("pointerdown", (e) => {
          tracking = true;
          startX = e.clientX;
          startY = e.clientY;
        });

        banner.addEventListener("pointerup", (e) => {
          if (!tracking) return;
          tracking = false;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (Math.abs(dx) > SWIPE_THRESHOLD_PX && Math.abs(dx) > Math.abs(dy)) {
            show(current + (dx < 0 ? 1 : -1));
            restartTimer();
          }
        });

        banner.addEventListener("pointercancel", () => {
          tracking = false;
        });

        restartTimer();
      });
    </script>
  )
}
