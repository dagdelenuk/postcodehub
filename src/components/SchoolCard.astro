---
import type { School } from "../lib/types";
import { OFSTED_RATING_COLORS, formatOfstedDate } from "../lib/ofsted";

interface Props {
  school: School;
}

const { school } = Astro.props;

const isOversubscribed = school.numberOfPupils != null && school.schoolCapacity != null && school.numberOfPupils > school.schoolCapacity;

// GIAS's phase/establishment-type strings are free text (and, since our
// "Not applicable" fallback, can be any establishment type), so match by
// keyword rather than an exhaustive exact-value map - covers new/unseen
// variants with a sensible fallback instead of silently showing nothing.
function iconFor(phase: string): { emoji: string; text: string } {
  const p = phase.toLowerCase();
  if (p.includes("nursery")) return { emoji: "🧸", text: "text-amber-700" };
  if (p.includes("primary")) return { emoji: "🎒", text: "text-sky-700" };
  if (p.includes("secondary")) return { emoji: "📚", text: "text-indigo-700" };
  if (p.includes("all-through")) return { emoji: "🏫", text: "text-teal-700" };
  if (p.includes("pupil referral") || p.includes("alternative provision")) return { emoji: "🧭", text: "text-rose-700" };
  if (p.includes("special")) return { emoji: "🧩", text: "text-violet-700" };
  if (p.includes("16 plus") || p.includes("sixth form") || p.includes("post 16") || p.includes("higher education")) return { emoji: "🎓", text: "text-purple-700" };
  if (p.includes("independent")) return { emoji: "🏛️", text: "text-emerald-700" };
  if (p.includes("service children")) return { emoji: "🎖️", text: "text-slate-700" };
  return { emoji: "🏫", text: "text-stone-500" };
}

const icon = iconFor(school.phaseOfEducation);
const mapsUrl = school.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${school.name}, ${school.address}`)}` : null;
---

<div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4" data-school-card data-school-rating={school.ofstedRating ?? "none"} data-school-phase={school.phaseOfEducation} data-school-oversubscribed={isOversubscribed}>
  <span class:list={["pointer-events-none select-none absolute -right-3 -bottom-4 text-7xl opacity-25 leading-none", icon.text]} aria-hidden="true">
    {icon.emoji}
  </span>

  <div class:list={["relative pr-8", (school.ofstedRating || isOversubscribed) && "pb-5"]}>
    <p class="font-medium">{school.name}</p>
    <p class="text-sm text-stone-500 mt-1">{school.phaseOfEducation} &middot; {school.address}</p>
    {
      school.ofstedRating && !school.ofstedRatingDerivedFromAreaGrades && formatOfstedDate(school.ofstedLastInspection) && (
        <p class="text-xs text-stone-400 mt-1">Inspected {formatOfstedDate(school.ofstedLastInspection)}</p>
      )
    }
    {
      school.ofstedRating && school.ofstedRatingDerivedFromAreaGrades && (
        <p class="text-xs text-stone-400 mt-1">
          {formatOfstedDate(school.ofstedLastInspection) ? `Inspected ${formatOfstedDate(school.ofstedLastInspection)} · ` : ""}
          based on its lowest-graded area ({school.ofstedRating.toLowerCase()})
        </p>
      )
    }
    {
      !school.ofstedRating && school.ofstedNotJudgedUnderNewFramework && (
        <p class="text-xs text-stone-400 mt-1">
          {formatOfstedDate(school.ofstedLastInspection) ? `Inspected ${formatOfstedDate(school.ofstedLastInspection)} · ` : ""}
          no graded areas to go on, no single overall grade under Ofsted's post-2024 framework
        </p>
      )
    }
    {
      school.numberOfPupils && (
        <p class="text-xs text-stone-400 mt-1">
          {school.numberOfPupils} pupils{school.schoolCapacity ? ` / capacity ${school.schoolCapacity}` : ""}
        </p>
      )
    }
  </div>

  {
    (isOversubscribed || school.ofstedRating) && (
      <span class="absolute bottom-2 left-4 flex items-center gap-1">
        {
          isOversubscribed && (
            <span class="text-xs px-2 py-0.5 rounded-full whitespace-nowrap bg-amber-100 text-amber-800">Oversubscribed</span>
          )
        }
        {
          school.ofstedRating && (
            <span
              class:list={[
                "text-xs px-2 py-0.5 rounded-full whitespace-nowrap",
                OFSTED_RATING_COLORS[school.ofstedRating] ?? "bg-stone-100 text-stone-600",
              ]}
            >
              {school.ofstedRating}
            </span>
          )
        }
      </span>
    )
  }

  {
    mapsUrl && (
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener"
        aria-label={`Get directions to ${school.name}`}
        title="Get directions"
        class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full text-stone-400 hover:bg-stone-100 hover:text-emerald-700 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </a>
    )
  }
</div>
