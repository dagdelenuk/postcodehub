---
import type { School } from "../lib/types";
import SchoolCard from "./SchoolCard.astro";

interface Props {
  heading: string;
  headingHref?: string;
  sectionKey: string;
  schools: School[];
  /** Only set on the borough page, where each section is one outcode's post town - used to tag cards for the Post town filter. */
  postTown?: string;
}

const { heading, headingHref, sectionKey, schools, postTown } = Astro.props;
const mapPoints = schools
  .filter((s) => s.latitude != null && s.longitude != null)
  .map((s) => ({ name: s.name, lat: s.latitude, lon: s.longitude }));
---

<div class="mb-8" data-school-group>
  <div class="flex items-center justify-between mb-3 gap-2">
    <h2 class="text-lg font-semibold">
      {headingHref ? <a href={headingHref} class="hover:text-emerald-700">{heading}</a> : heading}
    </h2>
    {
      mapPoints.length > 0 && (
        <div class="inline-flex items-center gap-0.5 rounded-full border border-stone-200 bg-white p-0.5 shrink-0" data-view-toggle data-map-id={sectionKey}>
          <button type="button" data-view="cards" aria-pressed="true" aria-label={`Show ${heading} as cards`} title="Card view" class="view-btn is-active">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="2.5" y="2.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.4" />
              <rect x="11.5" y="2.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.4" />
              <rect x="2.5" y="11.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.4" />
              <rect x="11.5" y="11.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
          <button type="button" data-view="map" aria-pressed="false" aria-label={`Show ${heading} on a map`} title="Map view" class="view-btn">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M10 18s6-6.5 6-11a6 6 0 1 0-12 0c0 4.5 6 11 6 11Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <circle cx="10" cy="7" r="2" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
        </div>
      )
    }
  </div>

  {
    mapPoints.length > 0 && (
      <div class="hidden rounded-lg border border-stone-200 overflow-hidden mb-3 relative isolate" data-map-wrap data-map-id={sectionKey}>
        <div class="h-72 sm:h-96 w-full" data-map-canvas />
      </div>
    )
  }

  <div class="grid gap-3 sm:grid-cols-2" data-view-cards data-map-id={sectionKey}>
    {schools.map((school) => <SchoolCard school={school} postTown={postTown} />)}
  </div>
</div>
{mapPoints.length > 0 && <script type="application/json" data-map-json={sectionKey} set:html={JSON.stringify(mapPoints)} />}

<style>
  .view-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
    width: 1.75rem;
    border-radius: 9999px;
    color: #a8a29e;
    transition: background-color 0.15s, color 0.15s;
  }
  .view-btn:hover {
    background: #f5f5f4;
  }
  .view-btn.is-active {
    background: #ecfdf5;
    color: #065f46;
  }
  [data-map-wrap] :global(.leaflet-container) {
    font-family: inherit;
  }
</style>

<script>
  interface MapPoint {
    name: string;
    lat: number;
    lon: number;
  }

  declare global {
    interface Window {
      L: any;
    }
  }

  let leafletReady: Promise<any> | undefined;

  function whenLeafletReady(): Promise<any> {
    leafletReady ??= new Promise((resolve, reject) => {
      if (window.L) {
        resolve(window.L);
        return;
      }
      let waited = 0;
      const id = setInterval(() => {
        if (window.L) {
          clearInterval(id);
          resolve(window.L);
        } else if ((waited += 50) > 10000) {
          clearInterval(id);
          reject(new Error("Leaflet failed to load"));
        }
      }, 50);
    });
    return leafletReady;
  }

  document.querySelectorAll<HTMLElement>("[data-view-toggle]").forEach((toggle) => {
    const id = toggle.dataset.mapId!;
    const cards = document.querySelector<HTMLElement>(`[data-view-cards][data-map-id="${id}"]`);
    const wrap = document.querySelector<HTMLElement>(`[data-map-wrap][data-map-id="${id}"]`);
    const canvas = wrap?.querySelector<HTMLElement>("[data-map-canvas]");
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>("[data-view]")];
    if (!cards || !wrap || !canvas) return;

    let map: any = null;

    new ResizeObserver(() => {
      if (map && canvas.clientWidth > 0 && canvas.clientHeight > 0) map.invalidateSize();
    }).observe(canvas);

    async function show(view: string) {
      cards!.classList.toggle("hidden", view === "map");
      wrap!.classList.toggle("hidden", view !== "map");
      for (const btn of buttons) {
        const active = btn.dataset.view === view;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", String(active));
      }
      if (view !== "map") return;

      if (!map) {
        let L: any;
        try {
          L = await whenLeafletReady();
        } catch {
          return;
        }
        const dataEl = document.querySelector<HTMLScriptElement>(`[data-map-json="${id}"]`);
        const points = JSON.parse(dataEl?.textContent ?? "[]") as MapPoint[];

        map = L.map(canvas, { scrollWheelZoom: false });
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        const markers = points.map((p) => {
          const el = document.createElement("div");
          el.textContent = p.name;
          return L.marker([p.lat, p.lon]).bindPopup(el);
        });

        if (markers.length > 0) {
          const group = L.featureGroup(markers).addTo(map);
          map.fitBounds(group.getBounds(), { padding: [24, 24], maxZoom: 16 });
        }
      }
      map.invalidateSize();
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => show(btn.dataset.view!));
    });
  });
</script>
