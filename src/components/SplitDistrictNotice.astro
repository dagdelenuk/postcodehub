---
import type { SplitInfo } from "../lib/data";

interface Props {
  info: SplitInfo;
  variant?: "full" | "condensed";
}

const { info, variant = "full" } = Astro.props;

// No percentages anywhere in this copy (spec is explicit) - shares invite
// "why is this page here if it's only 6%?" questions the page can't answer.
const NUMBER_WORDS: Record<number, string> = { 2: "two", 3: "three", 4: "four", 5: "five", 6: "six" };
function numberWord(n: number): string {
  return NUMBER_WORDS[n] ?? String(n);
}

function formatList(items: string[]): string {
  if (items.length <= 1) return items[0] ?? "";
  if (items.length === 2) return `${items[0]} and ${items[1]}`;
  return `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
}

const numBoroughs = info.allBoroughNames.length;
const linkClass = "text-emerald-700 underline underline-offset-2 hover:text-emerald-800";
---

{
  info.isSplit && variant === "full" && (
    <aside class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-stone-700">
      {numBoroughs === 2 ? (
        <>
          <strong>{info.outcode} spans two boroughs.</strong> This page covers the {info.boroughName} side — {info.localName}. For the{" "}
          {info.siblings[0].boroughName} side, see{" "}
          <a href={info.siblings[0].href} class={linkClass}>
            {info.outcode} in {info.siblings[0].boroughName}
          </a>
          .
        </>
      ) : (
        <>
          <strong>
            {info.outcode} spans {numberWord(numBoroughs)} boroughs — {formatList(info.allBoroughNames)}.
          </strong>{" "}
          This page covers the {info.boroughName} side — {info.localName}. See also:{" "}
          {info.siblings.map((s, idx) => (
            <>
              {idx > 0 && " · "}
              <a href={s.href} class={linkClass}>
                {info.outcode} in {s.boroughName}
              </a>
            </>
          ))}
        </>
      )}
    </aside>
  )
}
{
  info.isSplit && variant === "condensed" && (
    <aside class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-stone-700">
      {info.outcode} spans {numberWord(numBoroughs)} boroughs — this page covers the {info.boroughName} part.{" "}
      {numBoroughs === 2 ? (
        <>
          See{" "}
          <a href={info.siblings[0].href} class={linkClass}>
            {info.outcode} in {info.siblings[0].boroughName}
          </a>
          .
        </>
      ) : (
        <>
          See also:{" "}
          {info.siblings.map((s, idx) => (
            <>
              {idx > 0 && " · "}
              <a href={s.href} class={linkClass}>
                {info.outcode} in {s.boroughName}
              </a>
            </>
          ))}
        </>
      )}
    </aside>
  )
}
