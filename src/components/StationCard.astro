---
import type { PoliceStation } from "../lib/types";

interface Props {
  station: PoliceStation;
  kind: "police" | "fire";
}

const { station, kind } = Astro.props;

const ICONS: Record<Props["kind"], { emoji: string; text: string }> = {
  police: { emoji: "🚓", text: "text-blue-700" },
  fire: { emoji: "🚒", text: "text-red-600" },
};

const icon = ICONS[kind];
const addressLine = [station.address, station.postcode].filter(Boolean).join(", ");
const mapsUrl = addressLine
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${station.name}, ${addressLine}`)}`
  : null;
---

<div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4" data-station-card data-station-kind={kind}>
  <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", icon.text]} aria-hidden="true">
    {icon.emoji}
  </span>
  <div class="relative pr-8">
    <p class="font-medium">{station.name}</p>
    {addressLine && <p class="text-sm text-stone-500 mt-1">{addressLine}</p>}
    {station.telephone && <p class="text-sm text-stone-500">{station.telephone}</p>}
    <p class="text-xs text-stone-400 mt-1">{(station.distanceKm * 0.621371).toFixed(1)} mi away</p>
  </div>
  {mapsUrl && (
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Get directions to ${station.name}`}
      title="Get directions"
      class="absolute top-2 right-2 inline-flex items-center justify-center h-7 w-7 rounded-full text-stone-400 hover:bg-stone-100 hover:text-emerald-700 transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      </svg>
    </a>
  )}
</div>
