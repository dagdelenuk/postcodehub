---
import "../styles/global.css";
import HamburgerMenu from "../components/HamburgerMenu.astro";
import PostcodeSearch from "../components/PostcodeSearch.astro";

interface Props {
  title: string;
  description?: string;
  menuLevel?: "home" | "city" | "borough" | "outcode";
  citySlug?: string;
  boroughSlug?: string;
}

const {
  title,
  description = "A non-commercial community information network for UK neighbourhoods.",
  menuLevel = "home",
  citySlug,
  boroughSlug,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · PostcodeHub</title>
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 text-stone-900">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="text-2xl font-extrabold tracking-tight">
          Postcode<span class="text-emerald-700">Hub</span>.UK
        </a>
        <div class="order-3 w-full sm:order-none sm:w-auto sm:flex-1 sm:px-6">
          <PostcodeSearch />
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            Beta
          </span>
          <HamburgerMenu level={menuLevel} citySlug={citySlug} boroughSlug={boroughSlug} />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-white mt-12">
      <div class="mx-auto max-w-5xl px-4 py-8 text-xs text-stone-400 space-y-2">
        <p>Health, safety, transport, schools, and local civic data for UK neighbourhoods.</p>
        <p>Built from open data: NHS Organisation Data Service, DfE Get Information about Schools, Ofsted, data.police.uk, HM Land Registry, UK Parliament, and each local council.</p>
      </div>
    </footer>
  </body>
</html>
