---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import HamburgerMenu from "../components/HamburgerMenu.astro";
import PostcodeSearch from "../components/PostcodeSearch.astro";
import { SITE_NAME, absoluteUrl } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  menuLevel?: "home" | "city" | "borough" | "outcode";
  citySlug?: string;
  boroughSlug?: string;
  /** schema.org JSON-LD objects for this page (Place, Dataset, ...). Breadcrumbs add their own. */
  jsonLd?: object | object[];
  /** Keep this page out of search results (e.g. pages whose content is built in the browser). Links are still followed. */
  noindex?: boolean;
}

const {
  title,
  description = "A non-commercial community information network for UK neighbourhoods.",
  menuLevel = "home",
  citySlug,
  boroughSlug,
  jsonLd,
  noindex = false,
} = Astro.props;

// One canonical URL per page: no query string (?highlight= is a view of the same page) and always a trailing slash.
const canonicalPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = absoluteUrl(canonicalPath);
const fullTitle = `${title} · PostcodeHub`;
const structuredData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PostcodeHub" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
    {structuredData.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 text-stone-900">
    <header class="sticky top-0 z-40 border-b border-stone-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="text-2xl font-extrabold tracking-tight">
          Postcode<span class="text-emerald-700">Hub</span>.UK
        </a>
        {
          menuLevel !== "home" && (
            <div class="order-3 w-full sm:order-none sm:w-auto sm:flex-1 sm:px-6">
              <PostcodeSearch />
            </div>
          )
        }
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            Beta
          </span>
          <HamburgerMenu level={menuLevel} citySlug={citySlug} boroughSlug={boroughSlug} />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer citySlug={citySlug} boroughSlug={boroughSlug} />
    <script is:inline>
      // The site header is taller on phones (the search box drops onto its own row) and the breadcrumbs can wrap, so the sticky bars
      // below them (breadcrumbs, district menu, section tabs) can't use fixed offsets: measure and publish them as CSS variables.
      (function () {
        var root = document.documentElement;
        function update() {
          var header = document.querySelector("header.sticky");
          var crumbs = document.querySelector('nav[aria-label="Breadcrumb"].sticky');
          var headerHeight = header ? header.offsetHeight : 0;
          root.style.setProperty("--sticky-header", headerHeight + "px");
          root.style.setProperty("--sticky-crumbs", headerHeight + (crumbs ? crumbs.offsetHeight : 0) + "px");
        }
        update();
        window.addEventListener("resize", update);
        window.addEventListener("load", update);
        if ("ResizeObserver" in window) {
          var observer = new ResizeObserver(update);
          [document.querySelector("header.sticky"), document.querySelector('nav[aria-label="Breadcrumb"].sticky')].forEach(function (el) {
            if (el) observer.observe(el);
          });
        }
      })();
    </script>
    {
      import.meta.env.PROD && (
        <script is:inline>
          {`// Offline support and installability. Production builds only: in dev a service worker would keep serving stale pages.
          if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
          }`}
        </script>
      )
    }
  </body>
</html>
