---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import { getAllOutcodeParams, getFoodHygieneMeta, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "food"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;
const meta = getFoodHygieneMeta();

const establishments = data.food.establishments;
const total = establishments.length;
const RATINGS = [5, 4, 3, 2, 1, 0] as const;
const RATING_LABELS: Record<number, string> = { 5: "Very good", 4: "Good", 3: "Generally satisfactory", 2: "Improvement necessary", 1: "Major improvement necessary", 0: "Urgent improvement necessary" };
const RATING_COLORS: Record<number, string> = { 5: "bg-emerald-600", 4: "bg-lime-600", 3: "bg-yellow-500", 2: "bg-orange-500", 1: "bg-red-500", 0: "bg-red-700" };

const counts = Object.fromEntries(RATINGS.map((r) => [r, establishments.filter((e) => e.rating === r).length])) as Record<number, number>;
const londonCounts = meta?.londonCounts ?? {};
const londonTotal = Object.values(londonCounts).reduce((a, b) => a + b, 0);
const pct = (n: number, of: number) => (of > 0 ? (n / of) * 100 : 0);
const fiveStarShare = pct(counts[5], total);
const londonFiveStarShare = pct(londonCounts["5"] ?? 0, londonTotal);
const types = [...new Set(establishments.map((e) => e.type))].sort();
const formatDate = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<LocalityLayout citySlug={city!} boroughSlug={borough!} data={data} active="food" topic="Food & Hospitality">
  <h1 class="text-2xl font-bold mb-2">Food hygiene ratings in {data.outcode}, {data.borough}</h1>
  <p class="text-stone-500 mb-6">{total.toLocaleString()} restaurants, cafes, takeaways, pubs, hotels and food shops with a published rating.</p>

  <div class="grid gap-4 sm:grid-cols-2 mb-6">
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{fiveStarShare.toFixed(0)}%</p>
      <p class="text-xs text-stone-500 mt-1">
        rated 5 (very good)
        {Math.round(fiveStarShare) !== Math.round(londonFiveStarShare) && (
          <span class:list={["ml-1 font-medium", fiveStarShare > londonFiveStarShare ? "text-emerald-600" : "text-red-600"]}>
            {fiveStarShare > londonFiveStarShare ? "▲" : "▼"} London: {londonFiveStarShare.toFixed(0)}%
          </span>
        )}
      </p>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{counts[2] + counts[1] + counts[0]}</p>
      <p class="text-xs text-stone-500 mt-1">rated 2 or below (needs improvement)</p>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 bg-white p-4 mb-6">
    <h2 class="text-sm font-semibold mb-3">Ratings compared with London</h2>
    <div class="space-y-2">
      {
        RATINGS.map((r) => (
          <div class="grid grid-cols-[2rem_1fr_7rem] items-center gap-3 text-sm">
            <span class="font-medium">{r}</span>
            <div class="relative h-4 rounded bg-stone-100" title={`${RATING_LABELS[r]}: ${counts[r]} here, ${pct(londonCounts[String(r)] ?? 0, londonTotal).toFixed(1)}% across London`}>
              <div class:list={["h-4 rounded", RATING_COLORS[r]]} style={`width:${pct(counts[r], total).toFixed(1)}%`}></div>
              <div class="absolute top-[-2px] h-5 w-0.5 bg-stone-900" style={`left:${pct(londonCounts[String(r)] ?? 0, londonTotal).toFixed(1)}%`} title="London share"></div>
            </div>
            <span class="text-stone-500 text-xs text-right">{pct(counts[r], total).toFixed(0)}% ({counts[r]}) · Ldn {pct(londonCounts[String(r)] ?? 0, londonTotal).toFixed(0)}%</span>
          </div>
        ))
      }
    </div>
    <p class="text-xs text-stone-400 mt-3">Bar = share of premises in {data.outcode}; black marker = London share.</p>
  </div>

  <div class="flex flex-wrap items-center gap-3 mb-3" data-food-filters>
    <input type="search" placeholder="Search by name or street" class="rounded border border-stone-300 px-3 py-1.5 text-sm w-64" data-food-search />
    <select class="rounded border border-stone-300 px-2 py-1.5 text-sm" data-food-type>
      <option value="">All types</option>
      {types.map((t) => <option value={t}>{t}</option>)}
    </select>
    <select class="rounded border border-stone-300 px-2 py-1.5 text-sm" data-food-rating>
      <option value="">Any rating</option>
      <option value="5">5 only</option>
      <option value="4">4 and above</option>
      <option value="low">2 or below</option>
    </select>
    <span class="text-xs text-stone-400" data-food-count></span>
  </div>

  <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
          <th class="px-4 py-2 font-semibold">Business</th>
          <th class="px-4 py-2 font-semibold">Type</th>
          <th class="px-4 py-2 font-semibold">Inspected</th>
          <th class="px-4 py-2 font-semibold text-right">Rating</th>
        </tr>
      </thead>
      <tbody>
        {
          establishments.map((e) => (
            <tr class="border-b border-stone-100 last:border-0" data-food-row data-type={e.type} data-rating={e.rating} data-text={`${e.name} ${e.address}`.toLowerCase()}>
              <td class="px-4 py-2">
                <span class="font-medium">{e.name}</span>
                <span class="block text-xs text-stone-500">{e.address}, {e.postcode}</span>
              </td>
              <td class="px-4 py-2 text-stone-500">{e.type}</td>
              <td class="px-4 py-2 text-stone-500 whitespace-nowrap">{formatDate(e.ratingDate)}</td>
              <td class="px-4 py-2 text-right">
                <span class:list={["inline-block min-w-7 rounded px-2 py-0.5 text-white font-semibold text-center", RATING_COLORS[e.rating]]} title={RATING_LABELS[e.rating]}>{e.rating}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="text-xs text-stone-400 mt-4">
    Source: {meta?.source ?? "Food Standards Agency"}, retrieved {meta ? formatDate(meta.fetchedAt) : ""}. Ratings reflect the last inspection and can change; premises awaiting inspection or exempt are not shown.
  </p>

  <script>
    const rows = [...document.querySelectorAll<HTMLElement>("[data-food-row]")];
    const search = document.querySelector<HTMLInputElement>("[data-food-search]");
    const type = document.querySelector<HTMLSelectElement>("[data-food-type]");
    const rating = document.querySelector<HTMLSelectElement>("[data-food-rating]");
    const count = document.querySelector<HTMLElement>("[data-food-count]");

    function apply() {
      const q = (search?.value ?? "").trim().toLowerCase();
      const t = type?.value ?? "";
      const r = rating?.value ?? "";
      let shown = 0;
      for (const row of rows) {
        const value = Number(row.dataset.rating);
        const ok =
          (!q || (row.dataset.text ?? "").includes(q)) &&
          (!t || row.dataset.type === t) &&
          (!r || (r === "low" ? value <= 2 : r === "5" ? value === 5 : value >= Number(r)));
        row.hidden = !ok;
        if (ok) shown++;
      }
      if (count) count.textContent = `${shown} shown`;
    }
    search?.addEventListener("input", apply);
    type?.addEventListener("change", apply);
    rating?.addEventListener("change", apply);
    apply();
  </script>
</LocalityLayout>
