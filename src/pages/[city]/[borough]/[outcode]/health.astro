---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import HealthOrgCard from "../../../../components/HealthOrgCard.astro";
import HealthFilters from "../../../../components/HealthFilters.astro";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "health"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;
const counts = {
  gp: data.health.gpSurgeries.length,
  dentist: data.health.dentists.length,
  pharmacy: data.health.pharmacies.length,
  hospital: data.health.hospitals.length,
};
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="health"
  title={`Health in ${data.outcode}`}
  description={`GP surgeries, dentists, pharmacies, and hospitals serving the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-4">Health services in {data.outcode}</h1>

  <HealthFilters counts={counts} />

  {
    [
      { title: "GP surgeries", items: data.health.gpSurgeries, kind: "gp" as const },
      { title: "Dentists", items: data.health.dentists, kind: "dentist" as const },
      { title: "Pharmacies", items: data.health.pharmacies, kind: "pharmacy" as const },
      { title: "Hospitals", items: data.health.hospitals, kind: "hospital" as const },
    ].map(
      (section) =>
        section.items.length > 0 && (
          <section class="mb-8" data-health-type-block data-health-kind={section.kind}>
            <h2 class="text-lg font-semibold mb-3">{section.title} ({section.items.length})</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {section.items.map((org) => (
                <HealthOrgCard org={org} kind={section.kind} />
              ))}
            </div>
          </section>
        )
    )
  }

  <p class="text-xs text-stone-400 mt-4">Source: NHS Organisation Data Service (ODS).</p>
</LocalityLayout>
