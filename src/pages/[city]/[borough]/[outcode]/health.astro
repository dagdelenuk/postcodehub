---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "health"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="health"
  title={`Health in ${data.outcode}`}
  description={`GP surgeries, dentists, and pharmacies serving the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-6">Health services in {data.outcode}</h1>

  {
    [
      { title: "GP surgeries", items: data.health.gpSurgeries },
      { title: "Dentists", items: data.health.dentists },
      { title: "Pharmacies", items: data.health.pharmacies },
    ].map(
      (section) =>
        section.items.length > 0 && (
          <section class="mb-8">
            <h2 class="text-lg font-semibold mb-3">{section.title} ({section.items.length})</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {section.items.map((org) => (
                <div class="rounded-lg border border-stone-200 bg-white p-4">
                  <p class="font-medium">{org.name}</p>
                  <p class="text-sm text-stone-500 mt-1">{org.address || org.postcode}</p>
                  {org.telephone && <p class="text-sm text-stone-500">{org.telephone}</p>}
                </div>
              ))}
            </div>
          </section>
        )
    )
  }

  <p class="text-xs text-stone-400 mt-4">Source: NHS Organisation Data Service (ODS).</p>
</LocalityLayout>
