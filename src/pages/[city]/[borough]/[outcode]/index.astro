---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import LiveWeatherWidget from "../../../../components/LiveWeatherWidget.astro";
import { CATEGORIES } from "../../../../lib/categories";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";
import { CATEGORY_KEYS } from "../../../../lib/types";

export function getStaticPaths() {
  return getAllOutcodeParams().map((p) => ({
    params: p,
    props: { data: loadOutcodeData(p.city, p.borough, p.outcode) },
  }));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const STAT_COLORS: Record<string, string> = {
  health: "text-rose-600",
  schools: "text-indigo-600",
  safety: "text-amber-600",
  property: "text-emerald-600",
};

const summaryStats = [
  { label: "Health services", value: data.health.gpSurgeries.length, category: "health" as const },
  { label: "Schools", value: data.schools.schools.length, category: "schools" as const },
  { label: "Safety & Crime (12mo)", value: data.safety.totalLast12Months, category: "safety" as const },
  { label: "Property sales", value: data.property.sales.length, category: "property" as const },
];
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="overview"
  title={data.outcode}
  description={`Health, schools, safety, transport, and civic information for the ${data.outcode} postcode area in ${data.borough}.`}
>
  <div class="grid gap-4 sm:grid-cols-4 mb-8">
    {
      summaryStats.map((stat) => {
        const clickable = hasContent(data, stat.category);
        const cardClass = "relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4 text-center transition-colors" + (clickable ? " hover:border-emerald-600 cursor-pointer" : "");
        const icon = CATEGORIES.find((c) => c.key === stat.category)!.icon;
        const content = (
          <>
            <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", STAT_COLORS[stat.category]]} aria-hidden="true">
              {icon}
            </span>
            <p class="relative text-2xl font-bold text-emerald-800">{stat.value.toLocaleString()}</p>
            <p class="relative text-xs text-stone-500 mt-1">{stat.label}</p>
          </>
        );
        return clickable ? (
          <a href={`/${city}/${borough}/${data.slug}/${stat.category}/`} class={cardClass}>
            {content}
          </a>
        ) : (
          <div class={cardClass}>{content}</div>
        );
      })
    }
  </div>

  <div class="grid gap-6 sm:grid-cols-2 mb-8">
    <LiveWeatherWidget latitude={data.latitude} longitude={data.longitude} />
    <div class="rounded-lg border border-stone-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">About {data.outcode}</p>
      <p class="text-sm text-stone-600">{data.history.summary}</p>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Explore {data.outcode}</h2>
  <div class="grid gap-3 sm:grid-cols-2">
    {
      CATEGORY_KEYS.filter((key) => (key === "transport" ? true : hasContent(data, key))).map((key) => {
        const cat = CATEGORIES.find((c) => c.key === key)!;
        return (
          <a
            href={`/${city}/${borough}/${data.slug}/${key}/`}
            class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
          >
            <span class="text-2xl leading-none">{cat.icon}</span>
            <span>
              <span class="block font-medium">{cat.label}</span>
              <span class="block text-sm text-stone-500">{cat.description}</span>
            </span>
          </a>
        );
      })
    }
  </div>
</LocalityLayout>
