---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import LiveWeatherWidget from "../../../../components/LiveWeatherWidget.astro";
import LiveAirQualityWidget from "../../../../components/LiveAirQualityWidget.astro";
import RotatingBanner from "../../../../components/RotatingBanner.astro";
import { CATEGORIES } from "../../../../lib/categories";
import { getAllOutcodeParams, getDistrictImages, hasContent, loadOutcodeData } from "../../../../lib/data";
import { CATEGORY_KEYS } from "../../../../lib/types";
import { getSimilarDistricts } from "../../../../lib/similar";
import { districtGlance, glanceDescription } from "../../../../lib/glance";

export function getStaticPaths() {
  return getAllOutcodeParams().map((p) => ({
    params: p,
    props: { data: loadOutcodeData(p.city, p.borough, p.outcode) },
  }));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const STAT_COLORS: Record<string, string> = {
  health: "text-rose-600",
  schools: "text-indigo-600",
  safety: "text-amber-600",
  statistics: "text-emerald-600",
  places: "text-teal-600",
  food: "text-orange-600",
};

const similar = getSimilarDistricts(data.outcode, 4);
const glance = districtGlance(data.outcode);
const description = glance ? glanceDescription(glance) : undefined;
const mpCount = new Set(data.representatives.representatives.filter((r) => r.role === "MP").map((r) => r.name)).size;
const summaryStats = [
  { label: "Health services", value: data.health.gpSurgeries.length, category: "health" as const },
  { label: "Schools", value: data.schools.schools.length, category: "schools" as const },
  // Same figure as the borough page: each outcode lists its whole borough's police + fire stations.
  { label: "Safety services", value: data.safety.policeStations.length + data.safety.fireStations.length, category: "safety" as const },
  { label: "Places", value: data.places.places.length, category: "places" as const },
  { label: "Food & Hospitality", value: data.food.establishments.length, category: "food" as const },
  { label: "Statistics", value: null as number | null, category: "statistics" as const },
];

---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="overview"
  description={description}
>
  <div class="mb-6">
    <RotatingBanner images={getDistrictImages(data.slug)} />
  </div>
  {
    glance && (
      <div class="rounded-lg border border-emerald-100 bg-emerald-50/60 p-4 mb-6" data-at-a-glance>
        <p class="text-xs uppercase tracking-wide text-emerald-800 font-medium mb-1">At a glance</p>
        <p class="text-sm text-stone-700 leading-relaxed">{glance.detail.join(" ")}</p>
        <p class="text-xs text-stone-400 mt-2">Summarised from the figures on this site, set against the rest of London. See Statistics for the detail and sources.</p>
      </div>
    )
  }

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-6 sm:gap-4 mb-8">
    {
      summaryStats.map((stat) => {
        const clickable = hasContent(data, stat.category);
        const cardClass = "relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4 text-center transition-colors" + (clickable ? " hover:border-emerald-600 cursor-pointer" : "");
        const icon = CATEGORIES.find((c) => c.key === stat.category)!.icon;
        const content = (
          <>
            <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", STAT_COLORS[stat.category]]} aria-hidden="true">
              {icon}
            </span>
            {stat.value === null ? (
              <svg class="relative mx-auto h-8 w-8 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Chart">
                <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
              </svg>
            ) : (
              <p class="relative text-2xl font-bold text-emerald-800">{stat.value.toLocaleString()}</p>
            )}
            <p class="relative text-xs text-stone-500 mt-1">{stat.label}</p>
          </>
        );
        return clickable ? (
          <a href={`/${city}/${borough}/${data.slug}/${stat.category}/`} class={cardClass}>
            {content}
          </a>
        ) : (
          <div class={cardClass}>{content}</div>
        );
      })
    }
  </div>

  <div class="grid gap-6 sm:grid-cols-2 mb-6">
    <LiveWeatherWidget latitude={data.latitude} longitude={data.longitude} />
    <LiveAirQualityWidget latitude={data.latitude} longitude={data.longitude} />
  </div>

  <div class="flex items-stretch gap-4 mb-8">
    <div class="flex-1 rounded-lg border border-stone-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">About {data.outcode}</p>
      <p class="text-sm text-stone-600">{data.history.summary}</p>
    </div>
    {
      hasContent(data, "representatives") && (
        <a
          href={`/${city}/${borough}/${data.slug}/representatives/`}
          class="relative overflow-hidden shrink-0 w-32 sm:w-40 aspect-square rounded-lg border border-stone-200 bg-white p-4 text-center flex flex-col items-center justify-center transition-colors hover:border-emerald-600 cursor-pointer"
        >
          <span class="pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none text-purple-600" aria-hidden="true">
            🏛️
          </span>
          <p class="relative text-2xl font-bold text-emerald-800">{mpCount}</p>
          <p class="relative text-xs text-stone-500 mt-1">Representatives</p>
        </a>
      )
    }
  </div>

  <h2 class="text-lg font-semibold mb-4">Explore {data.outcode}</h2>
  <div class="grid gap-3 sm:grid-cols-2 mb-8">
    {
      CATEGORY_KEYS.filter((key) => (key === "transport" ? true : hasContent(data, key))).map((key) => {
        const cat = CATEGORIES.find((c) => c.key === key)!;
        return (
          <a
            href={`/${city}/${borough}/${data.slug}/${key}/`}
            class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
          >
            <span class="text-2xl leading-none">{cat.icon}</span>
            <span>
              <span class="block font-medium">{cat.label}</span>
              <span class="block text-sm text-stone-500">{cat.description}</span>
            </span>
          </a>
        );
      })
    }
  </div>

  {
    similar.length > 0 && (
      <section class="mb-8">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-1">
          <h2 class="text-lg font-semibold">Areas like {data.outcode}</h2>
          <a
            href={`/compare/?areas=${[data.outcode, ...similar.map((s) => s.district.code)].slice(0, 4).join(",")}`}
            class="text-sm text-emerald-700 hover:underline"
          >
            Compare side by side &rarr;
          </a>
        </div>
        <p class="text-sm text-stone-500 mb-3">
          The London districts whose numbers sit closest to {data.outcode}'s on price, commute, crime, noise, green space and who lives there, and how each one differs.
        </p>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {similar.map(({ district, differences }) => (
            <li class="min-w-0">
              <a
                href={`/${district.citySlug}/${district.boroughSlug}/${district.slug}/`}
                class="block h-full rounded-lg border border-stone-200 bg-white px-4 py-3 hover:border-emerald-600 transition-colors"
              >
                <span class="flex items-center gap-3">
                  <span class="h-10 w-10 shrink-0 rounded-md border border-stone-200 bg-stone-100 text-stone-600 text-[11px] font-bold flex items-center justify-center">{district.code}</span>
                  <span class="min-w-0">
                    <span class="block font-semibold truncate">{district.name}</span>
                    <span class="block text-xs text-stone-500 truncate">{district.borough}</span>
                  </span>
                </span>
                <span class="mt-2 flex flex-wrap gap-1.5">
                  {(differences.length > 0 ? differences : ["Very close on everything we track"]).map((d) => (
                    <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs text-stone-600">{d}</span>
                  ))}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</LocalityLayout>
