---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import LeafletAssets from "../../../../components/LeafletAssets.astro";
import PlaceCategorySection from "../../../../components/PlaceCategorySection.astro";
import PlacesFilters from "../../../../components/PlacesFilters.astro";
import { displayPlaceName, getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";
import { PLACE_CATEGORIES } from "../../../../lib/place-categories";
import type { PlaceCategory } from "../../../../lib/types";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "places"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;
const placeName = displayPlaceName(data.postTown, data.wards, data.city);

const counts: Partial<Record<PlaceCategory, number>> = {};
for (const place of data.places.places) {
  counts[place.category] = (counts[place.category] ?? 0) + 1;
}
const total = data.places.places.length;
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="places"
  topic="Places"
>
  <h1 class="text-2xl font-bold mb-4">Places in {placeName} - {data.outcode}, {data.borough} ({total})</h1>

  <LeafletAssets />
  <PlacesFilters counts={counts} />

  {
    PLACE_CATEGORIES.map((cat) => {
      const items = data.places.places.filter((p) => p.category === cat.key);
      return items.length > 0 && <PlaceCategorySection cat={cat} items={items} />;
    })
  }

  <p class="text-xs text-stone-400 mt-4">Source: OpenStreetMap contributors.</p>
</LocalityLayout>
