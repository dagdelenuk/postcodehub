---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "places"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  library: "Library",
  park: "Park / Open space",
  "leisure-centre": "Leisure centre",
  "community-hub": "Community hub",
};
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="places"
  title={`Places in ${data.outcode}`}
  description={`Parks, landmarks, and community hubs in the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-6">Places in {data.outcode}</h1>

  <div class="grid gap-3 sm:grid-cols-2">
    {
      data.places.places.map((place) => (
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <div class="flex items-start justify-between gap-2">
            <p class="font-medium">{place.name}</p>
            <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-600 whitespace-nowrap">
              {CATEGORY_LABELS[place.category] ?? place.category}
            </span>
          </div>
          <p class="text-sm text-stone-500 mt-1">{place.address}</p>
          <p class="text-sm text-stone-600 mt-2">{place.description}</p>
        </div>
      ))
    }
  </div>
</LocalityLayout>
