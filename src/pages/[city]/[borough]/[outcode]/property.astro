---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import LiveFloodWarningsWidget from "../../../../components/LiveFloodWarningsWidget.astro";
import { getAllOutcodeParams, getBorough, getBroadband, getCouncilTax, getCouncilTaxAverage, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "property"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const boroughName = getBorough(city!, borough!)?.name ?? data.city;
const councilTax = getCouncilTax(borough!);
const londonAverage = getCouncilTaxAverage();
const COUNCIL_TAX_BANDS = ["A", "B", "C", "D", "E", "F", "G", "H"] as const;

const broadband = getBroadband(data.outcode, borough!);
const BROADBAND_ROWS = [
  { key: "gigabit", label: "Gigabit (1 Gbit/s+) available", goodHigh: true },
  { key: "fullFibre", label: "Full fibre available", goodHigh: true },
  { key: "ultrafast", label: "Ultrafast (100 Mbit/s+) available", goodHigh: true },
  { key: "superfast", label: "Superfast (30 Mbit/s+) available", goodHigh: true },
  { key: "below30", label: "Cannot get 30 Mbit/s", goodHigh: false },
] as const;
const BROADBAND_BANDS = [
  { key: "over300", label: "300 Mbit/s or faster", color: "bg-emerald-600" },
  { key: "from30to300", label: "30 to 300 Mbit/s", color: "bg-lime-500" },
  { key: "from10to30", label: "10 to 30 Mbit/s", color: "bg-amber-500" },
  { key: "under10", label: "Under 10 Mbit/s", color: "bg-red-500" },
] as const;
const pctFmt = (n: number | null | undefined) => (n == null ? "n/a" : `${n.toFixed(1)}%`);

const gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });
const recentSales = data.property.sales.slice(0, 40);
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="property"
  topic="Property"
>
  {
    councilTax && (
      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-1">Council Tax bands in {boroughName}</h2>
        <p class="text-sm text-stone-500 mb-3">
          2026-27 rates, Band D (the reference band) is {gbp.format(councilTax.bandD)} a year.
        </p>
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="px-4 py-2 font-semibold">Band</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax (AVG London)</th>
              </tr>
            </thead>
            <tbody>
              {
                COUNCIL_TAX_BANDS.map((band) => {
                  const amount = councilTax.bands[band];
                  const avgAmount = londonAverage[band];
                  return (
                    <tr class:list={["border-b border-stone-100 last:border-0", band === "D" && "bg-emerald-50 font-semibold"]}>
                      <td class="px-4 py-2">Band {band}</td>
                      <td class="px-4 py-2 text-right">
                        {gbp.format(amount)}
                        {avgAmount != null && amount !== avgAmount && (
                          <span
                            class:list={["ml-1.5", amount > avgAmount ? "text-red-600" : "text-emerald-600"]}
                            title={amount > avgAmount ? "Above the London average" : "Below the London average"}
                          >
                            {amount > avgAmount ? "▲" : "▼"}
                          </span>
                        )}
                      </td>
                      <td class="px-4 py-2 text-right text-stone-500">{avgAmount != null ? gbp.format(avgAmount) : "—"}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        <p class="text-xs text-stone-400 mt-2">
          Source: gov.uk, Council Tax levels set by local authorities in England 2026 to 2027 (Band D area council tax, including the GLA
          precept).
        </p>
      </section>
    )
  }

  <h1 class="text-2xl font-bold mb-2">Property Statistics in {data.outcode}, {data.borough}</h1>
  <p class="text-stone-500 mb-6">{data.property.sales.length} recorded sales over the last two years.</p>

  <div class="grid gap-4 sm:grid-cols-2 mb-8">
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{data.property.medianPrice ? gbp.format(data.property.medianPrice) : "n/a"}</p>
      <p class="text-xs text-stone-500 mt-1">Median sale price</p>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{data.property.averagePrice ? gbp.format(data.property.averagePrice) : "n/a"}</p>
      <p class="text-xs text-stone-500 mt-1">Average sale price</p>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-3">Recent sales</h2>
  <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
          <th class="px-4 py-2 font-semibold">Address</th>
          <th class="px-4 py-2 font-semibold">Type</th>
          <th class="px-4 py-2 font-semibold">Date</th>
          <th class="px-4 py-2 font-semibold text-right">Price</th>
        </tr>
      </thead>
      <tbody>
        {
          recentSales.map((sale) => (
            <tr class="border-b border-stone-100 last:border-0">
              <td class="px-4 py-2">{sale.address || sale.postcode}</td>
              <td class="px-4 py-2 text-stone-500">{sale.propertyType}{sale.newBuild ? " (new build)" : ""}</td>
              <td class="px-4 py-2 text-stone-500">{sale.dateOfTransfer}</td>
              <td class="px-4 py-2 text-right font-medium">{gbp.format(sale.price)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="text-xs text-stone-400 mt-4">Source: HM Land Registry Price Paid Data.</p>

  <section id="flood-risk" class="mt-8 mb-4">
    <h2 class="text-lg font-semibold mb-3">Flood risk</h2>
    <div class="mb-3">
      <LiveFloodWarningsWidget latitude={data.latitude} longitude={data.longitude} />
    </div>
    <a
      href={`https://check-long-term-flood-risk.service.gov.uk/postcode?postcode=${encodeURIComponent(data.outcode)}`}
      target="_blank"
      rel="noopener"
      class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
    >
      <span class="text-3xl leading-none" aria-hidden="true">🌊</span>
      <div>
        <p class="font-medium">Check long-term flood risk</p>
        <p class="text-sm text-stone-500 mt-1">
          Flood risk from rivers, the sea and surface water varies street by street within {data.outcode} - look up an exact
          address on the Environment Agency's checker.
        </p>
      </div>
    </a>
  </section>

  <section id="broadband-mobile" class="mb-4">
    <h2 class="text-lg font-semibold mb-3">Broadband &amp; mobile coverage</h2>
    {
      broadband && (
        <div class="mb-4">
          <p class="text-sm text-stone-500 mb-3">
            Share of homes in {data.outcode} that can get each speed of fixed broadband, against {data.borough} and London (Ofcom, {broadband.period}). This
            is what is available to order, not what people actually buy.
          </p>
          <div class="rounded-lg border border-stone-200 bg-white p-4 mb-3">
            <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">Best speed available to homes in {data.outcode}</p>
            <div class="flex h-5 w-full overflow-hidden rounded bg-stone-100" role="img" aria-label="Share of homes by best available download speed">
              {BROADBAND_BANDS.map((b) => (
                <div class={b.color} style={`width:${broadband.outcode.bands[b.key]}%`} title={`${b.label}: ${broadband.outcode.bands[b.key].toFixed(1)}%`}></div>
              ))}
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs text-stone-600">
              {BROADBAND_BANDS.map((b) => (
                <span class="inline-flex items-center gap-1.5">
                  <span class:list={["inline-block h-2.5 w-2.5 rounded-sm", b.color]}></span>
                  {b.label} {broadband.outcode.bands[b.key].toFixed(1)}%
                </span>
              ))}
            </div>
          </div>
          <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                  <th class="px-4 py-2 font-semibold">Homes that can get&hellip;</th>
                  <th class="px-4 py-2 font-semibold text-right">{data.outcode}</th>
                  <th class="px-4 py-2 font-semibold text-right">{data.borough}</th>
                  <th class="px-4 py-2 font-semibold text-right">London</th>
                </tr>
              </thead>
              <tbody>
                {BROADBAND_ROWS.map((row) => {
                  const local = broadband.outcode[row.key];
                  const lon = broadband.london[row.key];
                  const better = local != null && lon != null && local !== lon ? (row.goodHigh ? local > lon : local < lon) : null;
                  return (
                    <tr class="border-b border-stone-100 last:border-0">
                      <td class="px-4 py-2">{row.label}</td>
                      <td class="px-4 py-2 text-right">
                        {pctFmt(local)}
                        {better !== null && (
                          <span class:list={["ml-1.5", better ? "text-emerald-600" : "text-red-600"]} title={better ? "Better than the London average" : "Worse than the London average"}>
                            {local! > lon! ? "▲" : "▼"}
                          </span>
                        )}
                      </td>
                      <td class="px-4 py-2 text-right text-stone-500">{pctFmt(broadband.borough?.[row.key])}</td>
                      <td class="px-4 py-2 text-right text-stone-500">{pctFmt(lon)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-stone-400 mt-2">
            Source: {broadband.source}. {data.outcode} figures are the average across its {broadband.outcode.postcodes.toLocaleString()} postcodes; borough and London
            figures are weighted by number of homes. Full fibre is only published per borough. Use the checker below for an exact address.
          </p>
        </div>
      )
    }
    <div class="grid gap-3 sm:grid-cols-2">
      <a
        href={`https://checker.ofcom.org.uk/en-gb/broadband-coverage?postcode=${encodeURIComponent(data.outcode)}`}
        target="_blank"
        rel="noopener"
        class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
      >
        <span class="text-3xl leading-none" aria-hidden="true">📶</span>
        <div>
          <p class="font-medium">Broadband coverage</p>
          <p class="text-sm text-stone-500 mt-1">Available speeds and providers for an exact address, via Ofcom's checker.</p>
        </div>
      </a>
      <a
        href={`https://checker.ofcom.org.uk/en-gb/mobile-coverage?postcode=${encodeURIComponent(data.outcode)}`}
        target="_blank"
        rel="noopener"
        class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
      >
        <span class="text-3xl leading-none" aria-hidden="true">📱</span>
        <div>
          <p class="font-medium">Mobile coverage</p>
          <p class="text-sm text-stone-500 mt-1">Indoor/outdoor signal by network for an exact address, via Ofcom's checker.</p>
        </div>
      </a>
    </div>
    <p class="text-xs text-stone-400 mt-2">Source: Ofcom mobile and broadband coverage checker.</p>
  </section>
</LocalityLayout>
