---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import StationCard from "../../../../components/StationCard.astro";
import StationFilters from "../../../../components/StationFilters.astro";
import { displayPlaceName, getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "safety"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const placeName = displayPlaceName(data.postTown, data.wards, data.city);

const stationCounts = { police: data.safety.policeStations.length, fire: data.safety.fireStations.length };
const totalStations = stationCounts.police + stationCounts.fire;
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="safety"
  topic="Safety"
>
  {
    totalStations > 0 && (
      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-4">Safety services in {placeName} - {data.outcode} ({totalStations})</h2>

        <StationFilters counts={stationCounts} />

        <div class="grid gap-3 sm:grid-cols-2">
          {[...data.safety.policeStations].sort((a, b) => a.name.localeCompare(b.name)).map((station) => (
            <StationCard station={station} kind="police" />
          ))}
          {[...data.safety.fireStations].sort((a, b) => a.name.localeCompare(b.name)).map((station) => (
            <StationCard station={station} kind="fire" />
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-8">
    <h2 class="text-lg font-semibold mb-3">Emergency calls</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <a
        href="https://www.police.uk/pu/contact-us"
        target="_blank"
        rel="noopener"
        class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
      >
        <span class="text-3xl leading-none" aria-hidden="true">🚓</span>
        <div>
          <p class="font-medium">Contact Police</p>
          <p class="text-sm text-stone-500 mt-1">
            Report a crime or find your local force online. If a crime is in progress or life is at risk, always call 999.
          </p>
        </div>
      </a>
      <a
        href="https://www.londonambulance.nhs.uk/our-services/emergency-care/calling-999/"
        target="_blank"
        rel="noopener"
        class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
      >
        <span class="text-3xl leading-none" aria-hidden="true">🚒</span>
        <div>
          <p class="font-medium">Contact Fire Brigade</p>
          <p class="text-sm text-stone-500 mt-1">
            999 is for life-threatening emergencies like fires, explosions, and situations where lives or property are at risk.
          </p>
        </div>
      </a>
    </div>
  </section>

  <section class="mb-8">
    <a
      href={`/${city}/${borough}/${data.slug}/statistics/#crime`}
      class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
    >
      <span class="text-3xl leading-none" aria-hidden="true">📊</span>
      <div>
        <p class="font-medium">Crime statistics for {data.outcode}</p>
        <p class="text-sm text-stone-500 mt-1">
          {data.safety.totalLast12Months.toLocaleString()} recorded crimes over the last 12 months, with the monthly trend, a comparison of postcode areas in {data.borough}
          and a breakdown by category, now on the Statistics page.
        </p>
      </div>
    </a>
  </section>

  <p class="text-xs text-stone-400 mt-6">
    {(data.safety.policeStations.length > 0 || data.safety.fireStations.length > 0) && "Police and fire station locations: OpenStreetMap contributors."}
  </p>
</LocalityLayout>
