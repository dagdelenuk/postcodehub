---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "schools"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const RATING_COLORS: Record<string, string> = {
  Outstanding: "bg-emerald-100 text-emerald-800",
  Good: "bg-lime-100 text-lime-800",
  "Requires improvement": "bg-amber-100 text-amber-800",
  Inadequate: "bg-red-100 text-red-800",
};

// Ofsted's own CSV dates the inspection as DD/MM/YYYY; single-word ratings
// were also discontinued after Sept 2024, so showing the date matters - a
// "Good" badge from 2019 shouldn't read as a current judgement.
function formatOfstedDate(raw: string | null): string | null {
  if (!raw) return null;
  const match = raw.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if (!match) return null;
  const [, day, month, year] = match;
  const date = new Date(Number(year), Number(month) - 1, Number(day));
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="schools"
  title={`Schools in ${data.outcode}`}
  description={`Schools and Ofsted ratings in the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-6">Schools in {data.outcode} ({data.schools.schools.length})</h1>

  <div class="grid gap-3 sm:grid-cols-2">
    {
      data.schools.schools.map((school) => (
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <div class="flex items-start justify-between gap-2">
            <p class="font-medium">{school.name}</p>
            {school.ofstedRating && (
              <span class:list={["text-xs px-2 py-0.5 rounded-full whitespace-nowrap", RATING_COLORS[school.ofstedRating] ?? "bg-stone-100 text-stone-600"]}>
                {school.ofstedRating}
              </span>
            )}
          </div>
          <p class="text-sm text-stone-500 mt-1">{school.phaseOfEducation} &middot; {school.address}</p>
          {school.ofstedRating && !school.ofstedRatingDerivedFromAreaGrades && formatOfstedDate(school.ofstedLastInspection) && (
            <p class="text-xs text-stone-400 mt-1">Inspected {formatOfstedDate(school.ofstedLastInspection)}</p>
          )}
          {school.ofstedRating && school.ofstedRatingDerivedFromAreaGrades && (
            <p class="text-xs text-stone-400 mt-1">
              {formatOfstedDate(school.ofstedLastInspection) ? `Inspected ${formatOfstedDate(school.ofstedLastInspection)} · ` : ""}
              {school.ofstedRating.toLowerCase()} in every graded area - Ofsted's post-2024 framework doesn't publish a composite label
            </p>
          )}
          {!school.ofstedRating && school.ofstedNotJudgedUnderNewFramework && (
            <p class="text-xs text-stone-400 mt-1">
              {formatOfstedDate(school.ofstedLastInspection) ? `Inspected ${formatOfstedDate(school.ofstedLastInspection)} · ` : ""}
              mixed grades across areas, no single overall grade under Ofsted's post-2024 framework
            </p>
          )}
          {school.numberOfPupils && (
            <p class="text-xs text-stone-400 mt-1">
              {school.numberOfPupils} pupils{school.schoolCapacity ? ` / capacity ${school.schoolCapacity}` : ""}
            </p>
          )}
        </div>
      ))
    }
  </div>

  <p class="text-xs text-stone-400 mt-4">Source: DfE Get Information about Schools (GIAS) and Ofsted inspection outcomes.</p>
</LocalityLayout>
