---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import SchoolCard from "../../../../components/SchoolCard.astro";
import SchoolFilters from "../../../../components/SchoolFilters.astro";
import { displayPlaceName, getAllOutcodeParams, getSchoolAdmissionsUrl, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "schools"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;
const placeName = displayPlaceName(data.postTown, data.wards, data.city);
const admissionsUrl = getSchoolAdmissionsUrl(borough!);
const hasCompositeLabelNote = data.schools.schools.some((s) => s.ofstedRatingDerivedFromAreaGrades);
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="schools"
  title={`Schools in ${data.outcode}`}
  description={`Schools and Ofsted ratings in the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-4">Schools in {placeName} - {data.outcode} ({data.schools.schools.length})</h1>

  <SchoolFilters schools={data.schools.schools} />

  <div class:list={["grid gap-3 sm:grid-cols-2", !hasCompositeLabelNote && "mb-8"]} data-school-group>
    {data.schools.schools.map((school) => <SchoolCard school={school} />)}
  </div>
  {
    hasCompositeLabelNote && (
      <p class="text-xs text-stone-400 mt-4 mb-8">
        Some ratings above are based on a school's lowest-graded individual area, since Ofsted's post-2024 framework doesn't
        publish a single composite label.
      </p>
    )
  }

  {
    admissionsUrl && (
      <section class="mb-4">
        <h2 class="text-lg font-semibold mb-3">School admissions</h2>
        <a
          href={admissionsUrl}
          target="_blank"
          rel="noopener"
          class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors sm:max-w-md"
        >
          <span class="text-3xl leading-none" aria-hidden="true">📝</span>
          <div>
            <p class="font-medium">School admissions</p>
            <p class="text-sm text-stone-500 mt-1">
              Find out what school year group your child is in and what school application to make. Apply for primary or
              secondary schools for your child and in-year admissions.
            </p>
          </div>
        </a>
      </section>
    )
  }

  <p class="text-xs text-stone-400 mt-4">Source: DfE Get Information about Schools (GIAS) and Ofsted inspection outcomes.</p>
</LocalityLayout>
