---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import { getAllOutcodeParams, hasContent, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "schools"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const RATING_COLORS: Record<string, string> = {
  Outstanding: "bg-emerald-100 text-emerald-800",
  Good: "bg-lime-100 text-lime-800",
  "Requires improvement": "bg-amber-100 text-amber-800",
  Inadequate: "bg-red-100 text-red-800",
};
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="schools"
  title={`Schools in ${data.outcode}`}
  description={`Schools and Ofsted ratings in the ${data.outcode} area.`}
>
  <h1 class="text-2xl font-bold mb-6">Schools in {data.outcode} ({data.schools.schools.length})</h1>

  <div class="grid gap-3 sm:grid-cols-2">
    {
      data.schools.schools.map((school) => (
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <div class="flex items-start justify-between gap-2">
            <p class="font-medium">{school.name}</p>
            {school.ofstedRating && (
              <span class:list={["text-xs px-2 py-0.5 rounded-full whitespace-nowrap", RATING_COLORS[school.ofstedRating] ?? "bg-stone-100 text-stone-600"]}>
                {school.ofstedRating}
              </span>
            )}
          </div>
          <p class="text-sm text-stone-500 mt-1">{school.phaseOfEducation} &middot; {school.address}</p>
          {school.numberOfPupils && (
            <p class="text-xs text-stone-400 mt-1">
              {school.numberOfPupils} pupils{school.schoolCapacity ? ` / capacity ${school.schoolCapacity}` : ""}
            </p>
          )}
        </div>
      ))
    }
  </div>

  <p class="text-xs text-stone-400 mt-4">Source: DfE Get Information about Schools (GIAS) and Ofsted inspection outcomes.</p>
</LocalityLayout>
