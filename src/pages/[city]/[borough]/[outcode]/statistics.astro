---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import LeafletAssets from "../../../../components/LeafletAssets.astro";
import DataUpdated from "../../../../components/DataUpdated.astro";
import CrimeStats from "../../../../components/CrimeStats.astro";
import ConnectivitySection from "../../../../components/ConnectivitySection.astro";
import DemographicsSection from "../../../../components/DemographicsSection.astro";
import FavoriteStar from "../../../../components/FavoriteStar.astro";
import HousingMarket from "../../../../components/HousingMarket.astro";
import NoiseGreenSection from "../../../../components/NoiseGreenSection.astro";
import LiveFloodWarningsWidget from "../../../../components/LiveFloodWarningsWidget.astro";
import { datasetJsonLd } from "../../../../lib/seo";
import SectionTabs from "../../../../components/SectionTabs.astro";
import {
  getAllOutcodeParams,
  getBorough,
  getBoroughCrimeTrend,
  getBoroughDemographics,
  getBoroughPostTownPrices,
  getBroadband,
  getCouncilTax,
  getCouncilTaxAverage,
  formatDataDate,
  getGreenspace,
  getHpi,
  getMobileCoverage,
  getNoise,
  getRents,
  hasContent,
  loadOutcodeData,
} from "../../../../lib/data";

export function getStaticPaths() {
  return getAllOutcodeParams()
    .map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }))
    .filter((entry) => hasContent(entry.props.data, "statistics"));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

const boroughName = getBorough(city!, borough!)?.name ?? data.city;
const councilTax = getCouncilTax(borough!);
const londonAverage = getCouncilTaxAverage();
const COUNCIL_TAX_BANDS = ["A", "B", "C", "D", "E", "F", "G", "H"] as const;

// Borough-level housing market data (rents, HPI, post town prices) - the outcode inherits its borough's.
const hpi = getHpi(borough!);
const housing = {
  slug: borough!,
  name: data.borough,
  hpi,
  hpiTrend: hpi ? { months: hpi.borough.months, boroughs: [{ name: data.borough, slug: borough!, series: hpi.borough.averagePrice }], average: hpi.london.averagePrice } : null,
  rents: getRents(borough!),
  prices: getBoroughPostTownPrices(city!, borough!),
};

const boroughDemographics = getBoroughDemographics(borough!);
const hasCrime = data.safety.monthlyTrend.length > 0 || data.safety.totalLast12Months > 0;
const boroughCrimeTrend = hasCrime ? getBoroughCrimeTrend(city!, borough!) : null;
const demographics = data.demographics && boroughDemographics ? { outcode: data.demographics, ...boroughDemographics } : null;
const broadband = getBroadband(data.outcode, borough!);
const mobile = getMobileCoverage(borough!);
const hasConnectivity = Boolean(broadband || mobile);
const noise = getNoise(data.outcode, city!, borough!);
const green = getGreenspace(borough!, data.outcode);

const tabs = [
  { id: "housing", label: "Housing" },
  ...(demographics ? [{ id: "demographics", label: "Demographics" }] : []),
  ...(hasCrime ? [{ id: "crime", label: "Crime" }] : []),
  ...(hasConnectivity ? [{ id: "connectivity", label: "Connectivity" }] : []),
  { id: "environment", label: "Environment" },
];

const gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });
const recentSales = data.property.sales.slice(0, 40);

// "Data as of" labels: the latest period each source in a section covers.
const latestSale = data.property.sales.reduce((max, s) => (s.dateOfTransfer > max ? s.dateOfTransfer : max), "");
const housingUpdated = [
  ...(housing.rents ? [{ label: "Rents", value: formatDataDate(housing.rents.latestMonth) }] : []),
  ...(hpi ? [{ label: "House prices", value: formatDataDate(hpi.borough.months[hpi.borough.months.length - 1]) }] : []),
  ...(latestSale ? [{ label: "Sales to", value: formatDataDate(latestSale) }] : []),
  ...(councilTax ? [{ label: "Council Tax", value: "2026-27" }] : []),
];
const crimeMonths = data.safety.monthlyTrend;
const crimeUpdated = crimeMonths.length > 0 ? [{ label: "Crime to", value: formatDataDate(crimeMonths[crimeMonths.length - 1].month) }] : [];
const connectivityUpdated = [
  ...(broadband ? [{ label: "Broadband", value: broadband.period }] : []),
  ...(mobile ? [{ label: "Mobile", value: mobile.period }] : []),
];
const environmentUpdated = [
  { label: "Air quality and flood warnings", value: "live" },
  ...(noise ? [{ label: "Road noise (modelled)", value: noise.modelled }] : []),
  ...(green ? [{ label: "Green space", value: String(green.year) }] : []),
];
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="statistics"
  topic="Statistics"
  jsonLd={datasetJsonLd({
    name: `Statistics for ${data.outcode}, ${data.borough}`,
    description: `Housing costs, demographics, deprivation, recorded crime, broadband and mobile coverage and flood risk for the ${data.outcode} postcode district in ${data.borough}, compared with London.`,
    url: `/${city}/${borough}/${data.slug}/statistics/`,
    sources: ["HM Land Registry Price Paid Data", "HM Land Registry UK House Price Index", "ONS Price Index of Private Rents", "ONS Census 2021", "English Indices of Deprivation 2019", "data.police.uk street-level crime data", "Ofcom Connected Nations 2025", "Environment Agency flood monitoring", "Defra strategic noise mapping", "ONS access to gardens and public green space"],
    keywords: [data.outcode, data.borough, "house prices", "rents", "Council Tax", "demographics", "deprivation", "crime", "broadband", "flood risk", "road noise", "green space"],
    spatial: { name: `${data.outcode}, ${data.borough}`, latitude: data.latitude, longitude: data.longitude },
  })}
>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <h1 class="text-2xl font-bold">Statistics in {data.outcode}, {data.borough}</h1>
    <div class="flex items-center gap-2 shrink-0">
      <span class="inline-flex items-center gap-1 text-sm text-stone-500">
        <FavoriteStar favKey={`outcode:${city}/${borough}/${data.slug}`} />
        Save
      </span>
      <a
        href={`/compare/?areas=${data.outcode}`}
        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-700 px-3.5 py-2 text-sm font-medium text-white hover:bg-emerald-800 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 6h9m0 0L9.5 3.5M12 6 9.5 8.5M17 14H8m0 0 2.5-2.5M8 14l2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Compare with other areas
      </a>
    </div>
  </div>

  <SectionTabs tabs={tabs} />

  <section id="housing" data-section="housing">
    <DataUpdated items={housingUpdated} />
  {
    councilTax && (
      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-1">Council Tax bands in {boroughName}</h2>
        <p class="text-sm text-stone-500 mb-3">
          2026-27 rates, Band D (the reference band) is {gbp.format(councilTax.bandD)} a year.
        </p>
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="px-4 py-2 font-semibold">Band</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax (AVG London)</th>
              </tr>
            </thead>
            <tbody>
              {
                COUNCIL_TAX_BANDS.map((band) => {
                  const amount = councilTax.bands[band];
                  const avgAmount = londonAverage[band];
                  return (
                    <tr class:list={["border-b border-stone-100 last:border-0", band === "D" && "bg-emerald-50 font-semibold"]}>
                      <td class="px-4 py-2">Band {band}</td>
                      <td class="px-4 py-2 text-right">
                        {gbp.format(amount)}
                        {avgAmount != null && amount !== avgAmount && (
                          <span
                            class:list={["ml-1.5", amount > avgAmount ? "text-red-600" : "text-emerald-600"]}
                            title={amount > avgAmount ? "Above the London average" : "Below the London average"}
                          >
                            {amount > avgAmount ? "▲" : "▼"}
                          </span>
                        )}
                      </td>
                      <td class="px-4 py-2 text-right text-stone-500">{avgAmount != null ? gbp.format(avgAmount) : "—"}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        <p class="text-xs text-stone-400 mt-2">
          Source: gov.uk, Council Tax levels set by local authorities in England 2026 to 2027 (Band D area council tax, including the GLA
          precept).
        </p>
      </section>
    )
  }

    <HousingMarket b={housing} />

  <p class="text-stone-500 mb-6">{data.property.sales.length} recorded sales over the last two years.</p>

  <div class="grid gap-4 sm:grid-cols-2 mb-8">
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{data.property.medianPrice ? gbp.format(data.property.medianPrice) : "n/a"}</p>
      <p class="text-xs text-stone-500 mt-1">Median sale price</p>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
      <p class="text-2xl font-bold text-emerald-800">{data.property.averagePrice ? gbp.format(data.property.averagePrice) : "n/a"}</p>
      <p class="text-xs text-stone-500 mt-1">Average sale price</p>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-3">Recent sales</h2>
  <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
          <th class="px-4 py-2 font-semibold">Address</th>
          <th class="px-4 py-2 font-semibold">Type</th>
          <th class="px-4 py-2 font-semibold">Date</th>
          <th class="px-4 py-2 font-semibold text-right">Price</th>
        </tr>
      </thead>
      <tbody>
        {
          recentSales.map((sale) => (
            <tr class="border-b border-stone-100 last:border-0">
              <td class="px-4 py-2">{sale.address || sale.postcode}</td>
              <td class="px-4 py-2 text-stone-500">{sale.propertyType}{sale.newBuild ? " (new build)" : ""}</td>
              <td class="px-4 py-2 text-stone-500">{sale.dateOfTransfer}</td>
              <td class="px-4 py-2 text-right font-medium">{gbp.format(sale.price)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="text-xs text-stone-400 mt-4">Source: HM Land Registry Price Paid Data.</p>
  </section>

  {
    demographics && (
      <section id="demographics" data-section="demographics" class="mt-10">
        <DataUpdated items={[{ label: "Census", value: "2021" }, { label: "Deprivation index", value: "2019" }]} />
        <DemographicsSection
          columns={[
            { label: data.outcode, data: demographics.outcode },
            { label: data.borough, data: demographics.borough },
            { label: "London", data: demographics.london },
          ]}
          source={demographics.source}
          note={`${data.outcode} figures are built from the census neighbourhoods (output areas) whose postcodes mostly fall in ${data.outcode}, so they may not match its boundary exactly.`}
        />
      </section>
    )
  }

  {
    hasCrime && boroughCrimeTrend && (
      <section id="crime" data-section="crime" class="mt-10">
        <DataUpdated items={crimeUpdated} />
        <h2 class="text-2xl font-bold mb-1">Crime in {data.outcode}</h2>
        <CrimeStats
          total={data.safety.totalLast12Months}
          coverage="within roughly 1 mile of the area centre"
          monthly={data.safety.monthlyTrend}
          categories={Object.entries(data.safety.categoryBreakdown)}
          compare={{
            trend: boroughCrimeTrend,
            averageLabel: `${data.borough} average`,
            defaultHighlightSlug: data.slug,
            chartId: "borough-crime",
            heading: `Compare postcode areas in ${data.borough}`,
            intro: `Monthly crime trend across every postcode area in ${data.borough}, against the borough average.`,
          }}
        />
      </section>
    )
  }

  {
    hasConnectivity && (
      <section id="connectivity" data-section="connectivity" class="mt-10">
        <DataUpdated items={connectivityUpdated} />
        <h2 class="text-2xl font-bold mb-4">Connectivity in {data.outcode}</h2>
        <ConnectivitySection
          checkerOutcode={data.outcode}
          broadband={
            broadband
              ? {
                  columns: [
                    { label: data.outcode, data: broadband.outcode },
                    ...(broadband.borough ? [{ label: data.borough, data: broadband.borough }] : []),
                    { label: "London", data: broadband.london },
                  ],
                  period: broadband.period,
                  source: broadband.source,
                  note: `${data.outcode} figures are the average across its ${broadband.outcode.postcodes.toLocaleString()} postcodes; borough and London figures are weighted by number of homes. Full fibre is only published per borough. Use the checker below for an exact address.`,
                }
              : null
          }
          mobile={
            mobile
              ? {
                  columns: [
                    { label: data.borough, data: mobile.borough },
                    { label: "London", data: mobile.london },
                  ],
                  period: mobile.period,
                  source: mobile.source,
                  intro: `Share of homes in ${data.borough} with mobile coverage from EE, O2, Three and Vodafone (Ofcom, ${mobile.period}). Mobile coverage is only published per borough, so this applies to the whole of ${data.borough}, not just ${data.outcode}. Use the checker below for an exact address.`,
                }
              : null
          }
        />
      </section>
    )
  }

  <LeafletAssets />
  <section id="environment" data-section="environment" class="mt-10">
    <DataUpdated items={environmentUpdated} />
    <h2 class="text-2xl font-bold mb-4">Environment</h2>
    <div id="flood-risk">
    <h2 class="text-lg font-semibold mb-3">Flood risk</h2>
    <div class="mb-3">
      <LiveFloodWarningsWidget latitude={data.latitude} longitude={data.longitude} />
    </div>
    <a
      href={`https://check-long-term-flood-risk.service.gov.uk/postcode?postcode=${encodeURIComponent(data.outcode)}`}
      target="_blank"
      rel="noopener"
      class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
    >
      <span class="text-3xl leading-none" aria-hidden="true">🌊</span>
      <div>
        <p class="font-medium">Check long-term flood risk</p>
        <p class="text-sm text-stone-500 mt-1">
          Flood risk from rivers, the sea and surface water varies street by street within {data.outcode} - look up an exact
          address on the Environment Agency's checker.
        </p>
      </div>
    </a>
    </div>

    {
      (noise || green) && (
        <div class="mt-8">
          <NoiseGreenSection
            columns={[
              { label: data.outcode, noise: noise?.outcode ?? null, green: green?.outcode ?? null },
              { label: data.borough, noise: noise?.borough ?? null, green: green?.borough ?? null },
              { label: "London", noise: noise?.london ?? null, green: green?.london ?? null },
            ]}
            noiseLabels={noise?.labels ?? []}
            noiseModelled={noise?.modelled ?? ""}
            noiseSource={noise?.source ?? ""}
            greenSource={green?.source ?? ""}
            greenYear={green?.year ?? 2020}
            noiseScope={`within a mile of the centre of ${data.outcode}`}
            map={{
              latitude: data.latitude,
              longitude: data.longitude,
              zoom: 14,
              radiusM: 1609,
              areaLabel: `${data.outcode}: the area the figures cover (1 mile)`,
              parks: data.places.places.filter((p) => p.category === "park").map((p) => ({ name: p.name, latitude: p.latitude, longitude: p.longitude })),
            }}
          />
        </div>
      )
    }
  </section>
</LocalityLayout>
