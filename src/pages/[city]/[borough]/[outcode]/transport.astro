---
import LocalityLayout from "../../../../layouts/LocalityLayout.astro";
import EvChargingSection from "../../../../components/EvChargingSection.astro";
import LeafletAssets from "../../../../components/LeafletAssets.astro";
import LiveCycleHire from "../../../../components/LiveCycleHire.astro";
import LiveTflWidget from "../../../../components/LiveTflWidget.astro";
import RelatedGuides from "../../../../components/RelatedGuides.astro";
import { getAllOutcodeParams, getEvCharging, getJourneyTimes, loadOutcodeData } from "../../../../lib/data";

export function getStaticPaths() {
  // Every outcode gets a Transport page unconditionally, even one with no
  // nearby stations at all - the static journey-planner/rail links and the
  // "no nearby stations" message are still useful. Only the live disruption
  // status itself is fetched client-side (LiveTflWidget); which lines/stations
  // are actually nearby is a real build-time fact from fetch-transport.ts.
  return getAllOutcodeParams().map((p) => ({ params: p, props: { data: loadOutcodeData(p.city, p.borough, p.outcode) } }));
}

const { city, borough } = Astro.params;
const { data } = Astro.props;

// Only these two have a real, PD-licensed logo checked in under public/logos/
// (Wikimedia Commons: National_Rail_logo.svg and Underground.svg, both
// public domain). Any other mode TfL's StopPoint API could still return for
// these stopTypes (dlr, overground, elizabeth-line, tram) falls back to text.
const journeyTimes = getJourneyTimes(data.outcode);
const ev = getEvCharging(borough!, data.latitude, data.longitude);
const MODE_LABELS: Record<string, string> = {
  tube: "Tube",
  "national-rail": "Rail",
  overground: "Overground",
  "elizabeth-line": "Elizabeth line",
  dlr: "DLR",
  bus: "Bus",
  tram: "Tram",
  "river-bus": "River bus",
  "cable-car": "Cable car",
};
const formatMinutes = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, "0")} min` : `${m} min`);
const MODE_LOGOS: Record<string, { src: string; alt: string }> = {
  "national-rail": { src: "/logos/national-rail.svg", alt: "National Rail" },
  tube: { src: "/logos/underground.svg", alt: "London Underground" },
};
---

<LocalityLayout
  data={data}
  citySlug={city!}
  boroughSlug={borough!}
  active="transport"
  topic="Transport"
>
  <h1 class="text-2xl font-bold mb-6">Transport in {data.outcode}, {data.borough}</h1>

  <div class="grid gap-4 sm:grid-cols-2 mb-8">
    <LiveTflWidget lines={data.transport.lines} nearestStationName={data.transport.nearbyStations[0]?.name} />
  </div>

  {
    journeyTimes && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold mb-1">Journey times to central London</h2>
        <p class="text-sm text-stone-500 mb-3">
          Fastest public transport journey from the centre of {data.outcode}, door to door including walking, leaving at 08:30 on a weekday.
        </p>
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="px-4 py-2 font-semibold">To</th>
                <th class="px-4 py-2 font-semibold text-right">Time</th>
                <th class="px-4 py-2 font-semibold">How</th>
              </tr>
            </thead>
            <tbody>
              {journeyTimes.journeys.map((j, i) => (
                <tr class:list={["border-b border-stone-100 last:border-0", i === 0 && "bg-emerald-50"]}>
                  <td class="px-4 py-2">
                    <span class="font-medium">{j.name}</span>
                    <span class="block text-xs text-stone-400">{j.area}</span>
                  </td>
                  <td class:list={["px-4 py-2 text-right whitespace-nowrap", i === 0 ? "font-semibold text-emerald-800" : "font-medium"]}>{formatMinutes(j.minutes)}</td>
                  <td class="px-4 py-2 text-stone-500">
                    {j.modes.length > 0 ? j.modes.map((m) => MODE_LABELS[m] ?? m.replace(/-/g, " ")).join(" + ") : "Walk"}
                    <span class="block text-xs text-stone-400">{j.changes === 0 ? "Direct" : `${j.changes} ${j.changes === 1 ? "change" : "changes"}`}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-stone-400 mt-2">
          Source: {journeyTimes.source}, planned for {journeyTimes.departure}. Times vary by street, service and day; check the journey planner below before you travel.
        </p>
      </section>
    )
  }

  {
    data.transport.nearbyStations.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold mb-3">Nearby stations</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {data.transport.nearbyStations.map((station) => (
            <div class="rounded-lg border border-stone-200 bg-white p-4">
              <p class="font-medium">{station.name}</p>
              <div class="flex items-center gap-1.5 mt-1">
                {station.modes.map((mode) =>
                  MODE_LOGOS[mode] ? (
                    <img src={MODE_LOGOS[mode].src} alt={MODE_LOGOS[mode].alt} title={MODE_LOGOS[mode].alt} class="h-4 w-auto" />
                  ) : (
                    <span class="text-xs text-stone-500 capitalize">{mode.replace(/-/g, " ")}</span>
                  )
                )}
              </div>
              <p class="text-xs text-stone-400 mt-1">{(station.distanceKm * 0.621371).toFixed(1)} mi away</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-8">
    <h2 class="text-lg font-semibold mb-1">Cycle hire</h2>
    <p class="text-sm text-stone-500 mb-3">Santander Cycles docking stations within a mile of {data.outcode}, with bikes and free docks right now.</p>
    <LiveCycleHire latitude={data.latitude} longitude={data.longitude} outcode={data.outcode} />
    <p class="text-xs text-stone-400 mt-2">Source: Transport for London (live).</p>
  </section>

  {
    ev && (
      <>
        <LeafletAssets />
        <EvChargingSection ev={ev} outcode={data.outcode} boroughName={data.borough} />
      </>
    )
  }

  <section class="grid gap-3 sm:grid-cols-3">
    <a href="https://tfl.gov.uk/plan-a-journey/" target="_blank" rel="noopener" class="rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
      <p class="font-medium">TfL Journey Planner</p>
      <p class="text-sm text-stone-500 mt-1">Plan a journey by tube, bus, or rail.</p>
    </a>
    <a href="https://www.nationalrail.co.uk/live-trains/" target="_blank" rel="noopener" class="rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
      <p class="font-medium">National Rail Live Departures</p>
      <p class="text-sm text-stone-500 mt-1">Live train times for local stations.</p>
    </a>
    <a href="https://www.travelinesoutheast.org.uk/" target="_blank" rel="noopener" class="rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
      <p class="font-medium">Traveline South East</p>
      <p class="text-sm text-stone-500 mt-1">Bus and local transport timetables.</p>
    </a>
  </section>

  <div class="mt-8">
    <RelatedGuides topic="commute" />
  </div>

  <p class="text-xs text-stone-400 mt-6">Live status: Transport for London Unified API.</p>
</LocalityLayout>
