---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LeafletAssets from "../../../components/LeafletAssets.astro";
import PlaceCategorySection from "../../../components/PlaceCategorySection.astro";
import { displayPlaceName, getBoroughFood, getFoodHygieneMeta, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughFood(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const meta = getFoodHygieneMeta();

const TYPES = [
  { key: "Restaurant/Cafe/Canteen", label: "Restaurants & cafes", emoji: "🍽️", colorClass: "text-orange-700" },
  { key: "Takeaway/sandwich shop", label: "Takeaways & sandwich shops", emoji: "🥡", colorClass: "text-amber-700" },
  { key: "Pub/bar/nightclub", label: "Pubs, bars & nightclubs", emoji: "🍺", colorClass: "text-yellow-700" },
  { key: "Hotel/bed & breakfast/guest house", label: "Hotels & guest houses", emoji: "🛎️", colorClass: "text-sky-700" },
  { key: "Mobile caterer", label: "Mobile caterers", emoji: "🚚", colorClass: "text-teal-700" },
  { key: "Retailers - supermarkets/hypermarkets", label: "Supermarkets", emoji: "🛒", colorClass: "text-emerald-700" },
  { key: "Retailers - other", label: "Food shops & other retailers", emoji: "🥖", colorClass: "text-rose-700" },
];
const RATING_LABELS: Record<number, string> = { 5: "Very good", 4: "Good", 3: "Generally satisfactory", 2: "Improvement necessary", 1: "Major improvement necessary", 0: "Urgent improvement necessary" };
const RATING_COLORS: Record<number, string> = { 5: "bg-emerald-700", 4: "bg-lime-700", 3: "bg-yellow-400 !text-stone-900", 2: "bg-orange-600", 1: "bg-red-600", 0: "bg-red-800" };
const RATING_TEXT: Record<number, string> = { 5: "text-emerald-700", 4: "text-lime-700", 3: "text-yellow-700", 2: "text-orange-700", 1: "text-red-700", 0: "text-red-800" };
// Coordinates keep the link short (a busy borough has thousands of these); fall back to the address when a business has none.
const mapsUrl = (e: { name: string; address: string; postcode: string; latitude: number | null; longitude: number | null }) =>
  e.latitude != null && e.longitude != null
    ? `https://www.google.com/maps/search/?api=1&query=${e.latitude},${e.longitude}`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.name}, ${e.address}, ${e.postcode}`)}`;
const PILL_BASE = "text-xs px-3 py-1 rounded-full border whitespace-nowrap transition-colors";

const groups = getBoroughFood(city.slug, borough.slug).map((g) => ({
  ...g,
  placeName: displayPlaceName(g.postTown, g.wards, city.name),
}));
const all = groups.flatMap((g) => g.establishments);
const total = all.length;
const typeCounts = new Map<string, number>();
for (const e of all) typeCounts.set(e.type, (typeCounts.get(e.type) ?? 0) + 1);
const availableTypes = TYPES.filter((t) => (typeCounts.get(t.key) ?? 0) > 0);
const ratings = [5, 4, 3, 2, 1, 0].filter((r) => all.some((e) => e.rating === r));
const postTowns = [...new Set(groups.map((g) => g.placeName))].sort((a, b) => a.localeCompare(b));
const formatDate = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout
  title={`Food and hospitality in ${borough.name}`}
  description={`Food hygiene ratings for restaurants, cafes, takeaways, pubs, hotels and food shops across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Food & Hospitality" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Food &amp; Hospitality in {borough.name} ({total.toLocaleString()})</h1>

    <LeafletAssets />
    <div data-food-filters>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-2">
        {availableTypes.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs text-stone-400">Type:</span>
            {availableTypes.map((t) => <button type="button" class={PILL_BASE} data-filter-group="type" data-filter-value={t.key}>{t.label}</button>)}
          </div>
        )}
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs text-stone-400">Rating:</span>
          {ratings.map((r) => <button type="button" class={PILL_BASE} data-filter-group="rating" data-filter-value={String(r)}>{r}</button>)}
        </div>
        {postTowns.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs text-stone-400">Post town:</span>
            {postTowns.map((t) => <button type="button" class={PILL_BASE} data-filter-group="postTown" data-filter-value={t}>{t}</button>)}
          </div>
        )}
        <button type="button" class="text-xs text-stone-400 underline hidden" data-filter-clear>Clear filters</button>
      </div>
      <p class="text-xs text-stone-400 mb-6" data-filter-count></p>
    </div>

    {
      groups.map((group) => (
        <div class="mb-8" data-food-group data-post-town={group.placeName}>
          <h2 class="text-lg font-semibold mb-3">
            <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/food/`} class="hover:text-emerald-700">
              {group.outcode} - {group.placeName}
            </a>
          </h2>
          {TYPES.map((t, ti) => {
            const items = group.establishments.filter((e) => e.type === t.key);
            return (
              items.length > 0 && (
                <PlaceCategorySection cat={{ key: t.key, label: t.label }} items={items} mapId={`${group.outcodeSlug}-food-${ti}`}>
                  <div class="contents" style={`--fc-emoji:'${t.emoji}'`}>
                    {items.map((e) => (
                      <div class="fc" data-food-card data-food-rating={e.rating}>
                        <div class="fc-body">
                          <p class="fc-name">{e.name}</p>
                          <p class="fc-addr">{e.address}, {e.postcode}</p>
                          <p class="fc-meta"><b class={`fc-r${e.rating}`} title={RATING_LABELS[e.rating]}>{e.rating}</b> &middot; Inspected {formatDate(e.ratingDate)}</p>
                        </div>
                        <a href={mapsUrl(e)} target="_blank" rel="noopener" class="fc-dir" aria-label={`Get directions to ${e.name}`} title="Get directions">
                          <svg width="16" height="16" aria-hidden="true"><use href="#food-dir" /></svg>
                        </a>
                      </div>
                    ))}
                  </div>
                </PlaceCategorySection>
              )
            );
          })}
        </div>
      ))
    }

    <p class="text-xs text-stone-400 mt-4">
      Source: {meta?.source ?? "Food Standards Agency"}, retrieved {meta ? formatDate(meta.fetchedAt) : ""}. Ratings run from 5 (very good) to 3 (generally satisfactory) and
      reflect the last inspection. Only businesses rated 3 or above are listed; premises rated below 3, awaiting inspection or exempt are not shown.
    </p>
  </section>

  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <symbol id="food-dir" viewBox="0 0 20 20"><path d="M10 2.5L16.5 16.5L10 13L3.5 16.5L10 2.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></symbol>
  </svg>

  <style is:global>
    [data-filter-group] {
      border-color: #d6d3d1;
      color: #57534e;
      background: white;
    }
    [data-filter-group].is-active {
      border-color: #059669;
      background: #ecfdf5;
      color: #065f46;
    }
    /* Compact food cards: a busy borough lists thousands, so the markup and its styling are kept as small as possible. */
    .fc {
      position: relative;
      overflow: hidden;
      border: 1px solid #e7e5e4;
      border-radius: 0.5rem;
      background: #fff;
      padding: 1rem;
      content-visibility: auto;
      contain-intrinsic-size: auto 96px;
    }
    .fc::after {
      content: var(--fc-emoji);
      position: absolute;
      right: -0.5rem;
      bottom: -0.75rem;
      font-size: 3.75rem;
      line-height: 1;
      opacity: 0.25;
      pointer-events: none;
    }
    .fc-body { position: relative; padding-right: 2rem; }
    .fc-name { font-weight: 500; }
    .fc-addr { font-size: 0.875rem; color: #625b55; margin-top: 0.25rem; }
    .fc-meta { font-size: 0.75rem; color: #78716c; margin-top: 0.25rem; }
    .fc-meta b { font-weight: 600; }
    .fc-r5 { color: #047857; } .fc-r4 { color: #4d7c0f; } .fc-r3 { color: #a16207; }
    .fc-dir {
      position: absolute; top: 0.5rem; right: 0.5rem; z-index: 1;
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.75rem; height: 1.75rem; border-radius: 9999px; color: #78716c;
    }
    .fc-dir:hover { background: #f5f5f4; color: #047857; }
  </style>

  <script>
    const bar = document.querySelector<HTMLElement>("[data-food-filters]");
    if (bar) {
      const pills = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter-group]")];
      const clearBtn = bar.querySelector<HTMLElement>("[data-filter-clear]");
      const countEl = bar.querySelector<HTMLElement>("[data-filter-count]");
      const cards = [...document.querySelectorAll<HTMLElement>("[data-food-card]")];
      const typeBlocks = [...document.querySelectorAll<HTMLElement>("[data-place-type-block]")];
      const groups = [...document.querySelectorAll<HTMLElement>("[data-food-group]")];
      const active: Record<string, Set<string>> = {};

      function apply() {
        const activeGroups = Object.entries(active).filter(([, set]) => set.size > 0);
        let visible = 0;
        for (const card of cards) {
          // Type and post town live on the enclosing block/group rather than being repeated on every card.
          const matches = activeGroups.every(([group, values]) => {
            const value =
              group === "type"
                ? card.closest<HTMLElement>("[data-place-type-block]")?.dataset.placeKind
                : group === "postTown"
                  ? card.closest<HTMLElement>("[data-food-group]")?.dataset.postTown
                  : card.dataset[`food${group[0].toUpperCase()}${group.slice(1)}`];
            return values.has(value ?? "");
          });
          card.classList.toggle("hidden", !matches);
          if (matches) visible++;
        }
        for (const block of typeBlocks) block.classList.toggle("hidden", ![...block.querySelectorAll<HTMLElement>("[data-food-card]")].some((c) => !c.classList.contains("hidden")));
        for (const group of groups) group.classList.toggle("hidden", ![...group.querySelectorAll<HTMLElement>("[data-place-type-block]")].some((b) => !b.classList.contains("hidden")));
        clearBtn?.classList.toggle("hidden", activeGroups.length === 0);
        if (countEl) countEl.textContent = activeGroups.length > 0 ? `Showing ${visible} of ${cards.length} results` : "";
      }

      for (const pill of pills) {
        const group = pill.dataset.filterGroup!;
        const value = pill.dataset.filterValue!;
        active[group] ??= new Set();
        pill.addEventListener("click", () => {
          if (active[group].has(value)) active[group].delete(value);
          else active[group].add(value);
          pill.classList.toggle("is-active", active[group].has(value));
          apply();
        });
      }
      clearBtn?.addEventListener("click", () => {
        for (const key of Object.keys(active)) active[key].clear();
        pills.forEach((p) => p.classList.remove("is-active"));
        apply();
      });
    }
  </script>
</BaseLayout>
