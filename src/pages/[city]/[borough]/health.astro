---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import HealthOrgCard from "../../../components/HealthOrgCard.astro";
import HealthFilters from "../../../components/HealthFilters.astro";
import { getBoroughHealth, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughHealth(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughHealth(city.slug, borough.slug);
const counts = {
  gp: groups.reduce((sum, g) => sum + g.gpSurgeries.length, 0),
  dentist: groups.reduce((sum, g) => sum + g.dentists.length, 0),
  pharmacy: groups.reduce((sum, g) => sum + g.pharmacies.length, 0),
  hospital: groups.reduce((sum, g) => sum + g.hospitals.length, 0),
};
const totalServices = counts.gp + counts.dentist + counts.pharmacy + counts.hospital;
---

<BaseLayout
  title={`Health in ${borough.name}`}
  description={`GP surgeries, dentists, pharmacies, and hospitals across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Health" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Health services in {borough.name} ({totalServices})</h1>

    <HealthFilters counts={counts} />

    {
      groups.map((group) => (
        <div class="mb-8" data-health-group>
          <h2 class="text-lg font-semibold mb-3">
            <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/health/`} class="hover:text-emerald-700">
              {group.outcode}
            </a>
          </h2>
          {[
            { title: "GP surgeries", items: group.gpSurgeries, kind: "gp" as const },
            { title: "Dentists", items: group.dentists, kind: "dentist" as const },
            { title: "Pharmacies", items: group.pharmacies, kind: "pharmacy" as const },
            { title: "Hospitals", items: group.hospitals, kind: "hospital" as const },
          ].map(
            (section) =>
              section.items.length > 0 && (
                <div class="mb-4" data-health-type-block data-health-kind={section.kind}>
                  <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">
                    {section.title} ({section.items.length})
                  </p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {section.items.map((org) => (
                      <HealthOrgCard org={org} kind={section.kind} />
                    ))}
                  </div>
                </div>
              )
          )}
        </div>
      ))
    }

    <section class="mb-4">
      <h2 class="text-lg font-semibold mb-3">Urgent &amp; emergency health services</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href="https://111.nhs.uk/" target="_blank" rel="noopener" class="rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
          <p class="font-medium">111 online</p>
          <p class="text-sm text-stone-500 mt-1">
            Get help for your symptoms. If you think you need medical help right now, 111 online can tell you what to do next.
          </p>
        </a>
        <a href="tel:999" class="rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
          <p class="font-medium">When to call 999</p>
          <p class="text-sm text-stone-500 mt-1">
            999 is for life-threatening emergencies like serious road traffic accidents, strokes and heart attacks.
          </p>
        </a>
      </div>
    </section>

    <p class="text-xs text-stone-400 mt-4">Source: NHS Organisation Data Service (ODS).</p>
  </section>
</BaseLayout>
