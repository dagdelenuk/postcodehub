---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import HealthCategorySection from "../../../components/HealthCategorySection.astro";
import HealthFilters from "../../../components/HealthFilters.astro";
import LeafletAssets from "../../../components/LeafletAssets.astro";
import { displayPlaceName, getBoroughHealth, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughHealth(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughHealth(city.slug, borough.slug).map((g) => ({
  ...g,
  placeName: displayPlaceName(g.postTown, g.wards, city.name),
}));
const counts = {
  gp: groups.reduce((sum, g) => sum + g.gpSurgeries.length, 0),
  dentist: groups.reduce((sum, g) => sum + g.dentists.length, 0),
  pharmacy: groups.reduce((sum, g) => sum + g.pharmacies.length, 0),
  hospital: groups.reduce((sum, g) => sum + g.hospitals.length, 0),
};
const totalServices = counts.gp + counts.dentist + counts.pharmacy + counts.hospital;
const postTowns = [...new Set(groups.map((g) => g.placeName))].sort((a, b) => a.localeCompare(b));

// CQC only publishes a usable overall rating for GP surgeries (see fetch-health.ts) - dentists, pharmacies and hospitals never carry one.
const ratedOrgs = groups.flatMap((g) => g.gpSurgeries);
const ratingsSummary = (() => {
  const rated = ratedOrgs.filter((o) => o.cqcRating);
  if (rated.length === 0) return null;
  const pct = (n: number) => `${((n / rated.length) * 100).toFixed(0)}%`;
  const ratingCounts = new Map<string, number>();
  for (const o of rated) ratingCounts.set(o.cqcRating!, (ratingCounts.get(o.cqcRating!) ?? 0) + 1);
  const breakdown = [...ratingCounts.entries()]
    .sort(([, a], [, b]) => b - a)
    .map(([rating, count]) => `${pct(count)} ${rating}`)
    .join(", ");
  return {
    headline: `Of the ${rated.length} GP surgeries in ${borough.name} with a current CQC rating (out of ${ratedOrgs.length} in total), ${breakdown}.`,
    unrated: ratedOrgs.length - rated.length,
  };
})();
---

<BaseLayout
  title={`Health in ${borough.name}`}
  description={`GP surgeries, dentists, pharmacies, and hospitals across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Health" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Health services in {borough.name} ({totalServices})</h1>

    {
      ratingsSummary && (
        <div class="rounded-lg border border-emerald-100 bg-emerald-50/60 p-4 mb-6" data-health-summary>
          <p class="text-xs uppercase tracking-wide text-emerald-800 font-medium mb-1">At a glance</p>
          <p class="text-sm text-stone-700 leading-relaxed">
            {ratingsSummary.headline}
            {ratingsSummary.unrated > 0 && ` ${ratingsSummary.unrated} have no current CQC rating (often a newly registered practice).`}
          </p>
          <p class="text-xs text-stone-500 mt-2">
            CQC ratings cover GP surgeries only here - pharmacies are regulated separately by the GPhC, CQC doesn't publish a
            comparable overall rating for dental practices, and hospital ratings aren't matched here.
          </p>
        </div>
      )
    }

    <LeafletAssets />
    <HealthFilters counts={counts} postTowns={postTowns} ratedOrgs={ratedOrgs} />

    {
      groups.map((group) => (
        <div class="mb-8" data-health-group>
          <h2 class="text-lg font-semibold mb-3">
            <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/health/`} class="hover:text-emerald-700">
              {group.outcode} - {group.placeName}
            </a>
          </h2>
          {[
            { title: "GP surgeries", items: group.gpSurgeries, kind: "gp" as const },
            { title: "Dentists", items: group.dentists, kind: "dentist" as const },
            { title: "Pharmacies", items: group.pharmacies, kind: "pharmacy" as const },
            { title: "Hospitals", items: group.hospitals, kind: "hospital" as const },
          ].map(
            (section) =>
              section.items.length > 0 && (
                <HealthCategorySection
                  title={section.title}
                  kind={section.kind}
                  items={section.items}
                  mapId={`${group.outcodeSlug}-${section.kind}`}
                  postTown={group.placeName}
                />
              )
          )}
        </div>
      ))
    }

    <section class="mb-4">
      <h2 class="text-lg font-semibold mb-3">Urgent &amp; emergency health services</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <a
          href="https://111.nhs.uk/"
          target="_blank"
          rel="noopener"
          class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
        >
          <span class="text-3xl leading-none" aria-hidden="true">☎️</span>
          <div>
            <p class="font-medium">111 online</p>
            <p class="text-sm text-stone-500 mt-1">
              Get help for your symptoms. If you think you need medical help right now, 111 online can tell you what to do next.
            </p>
          </div>
        </a>
        <a
          href="https://www.nhs.uk/nhs-services/urgent-and-emergency-care-services/when-to-call-999/"
          target="_blank"
          rel="noopener"
          class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
        >
          <span class="text-3xl leading-none" aria-hidden="true">🚑</span>
          <div>
            <p class="font-medium">When to call 999</p>
            <p class="text-sm text-stone-500 mt-1">
              999 is for life-threatening emergencies like serious road traffic accidents, strokes and heart attacks.
            </p>
          </div>
        </a>
      </div>
    </section>

    <section id="air-quality" class="mb-4">
      <h2 class="text-lg font-semibold mb-3">Air quality</h2>
      <a
        href="https://uk-air.defra.gov.uk/"
        target="_blank"
        rel="noopener"
        class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
      >
        <span class="text-3xl leading-none" aria-hidden="true">🌬️</span>
        <div>
          <p class="font-medium">Check air quality in {borough.name}</p>
          <p class="text-sm text-stone-500 mt-1">
            Daily Air Quality Index and pollutant levels (NO₂, PM2.5, PM10) from DEFRA's UK-AIR monitoring network.
          </p>
        </div>
      </a>
    </section>

    <p class="text-xs text-stone-400 mt-4">Sources: NHS Organisation Data Service (ODS); Care Quality Commission ratings.</p>
  </section>
</BaseLayout>
