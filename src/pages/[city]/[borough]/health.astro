---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import HealthOrgCard from "../../../components/HealthOrgCard.astro";
import HealthFilters from "../../../components/HealthFilters.astro";
import { getBoroughHealth, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughHealth(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughHealth(city.slug, borough.slug);
const totalGp = groups.reduce((sum, g) => sum + g.gpSurgeries.length, 0);
const counts = {
  gp: totalGp,
  dentist: groups.reduce((sum, g) => sum + g.dentists.length, 0),
  pharmacy: groups.reduce((sum, g) => sum + g.pharmacies.length, 0),
};
---

<BaseLayout
  title={`Health in ${borough.name}`}
  description={`GP surgeries, dentists, and pharmacies across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Health" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Health services in {borough.name} ({totalGp} GP surgeries)</h1>

    <HealthFilters counts={counts} />

    {
      groups.map((group) => (
        <div class="mb-8" data-health-group>
          <h2 class="text-lg font-semibold mb-3">
            <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/health/`} class="hover:text-emerald-700">
              {group.outcode}
            </a>
          </h2>
          {[
            { title: "GP surgeries", items: group.gpSurgeries, kind: "gp" as const },
            { title: "Dentists", items: group.dentists, kind: "dentist" as const },
            { title: "Pharmacies", items: group.pharmacies, kind: "pharmacy" as const },
          ].map(
            (section) =>
              section.items.length > 0 && (
                <div class="mb-4" data-health-type-block data-health-kind={section.kind}>
                  <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">
                    {section.title} ({section.items.length})
                  </p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {section.items.map((org) => (
                      <HealthOrgCard org={org} kind={section.kind} />
                    ))}
                  </div>
                </div>
              )
          )}
        </div>
      ))
    }

    <p class="text-xs text-stone-400 mt-4">Source: NHS Organisation Data Service (ODS).</p>
  </section>
</BaseLayout>
