---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import RotatingBanner from "../../../components/RotatingBanner.astro";
import LiveWeatherWidget from "../../../components/LiveWeatherWidget.astro";
import LiveAirQualityWidget from "../../../components/LiveAirQualityWidget.astro";
import FavoriteStar from "../../../components/FavoriteStar.astro";
import PartBadge from "../../../components/PartBadge.astro";
import {
  districtLocalName,
  getBannerImages,
  getBoroughFood,
  getBoroughHealth,
  getBoroughPlaces,
  getBoroughRepresentatives,
  getBoroughSchools,
  getBoroughSafetyServiceCount,
  getBoroughSummary,
  getCouncilServices,
  getFavouritesLookup,
  loadHierarchy,
  partitionDistrictsForNav,
} from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs.map((borough) => ({
      params: { city: city.slug, borough: borough.slug },
      props: { city, borough },
    }))
  );
}

const { city, borough } = Astro.props;
const summary = getBoroughSummary(city.slug, borough.slug);
const hasHealth = getBoroughHealth(city.slug, borough.slug).length > 0;
const boroughFood = getBoroughFood(city.slug, borough.slug);
const foodCount = boroughFood.reduce((sum, g) => sum + g.establishments.length, 0);
const hasSchools = getBoroughSchools(city.slug, borough.slug).length > 0;
const representativeGroups = getBoroughRepresentatives(city.slug, borough.slug);
const hasRepresentatives = representativeGroups.length > 0;
const mpCount = new Set(representativeGroups.flatMap((g) => g.representatives.filter((r) => r.role === "MP").map((r) => r.name))).size;
const hasCouncilServices = getCouncilServices(borough.slug).links.length > 0;
const boroughPlaces = getBoroughPlaces(city.slug, borough.slug);
const placesCount = boroughPlaces.reduce((sum, g) => sum + g.places.length, 0);
const summaryStats = [
  { label: "Health services", value: summary.gpSurgeries, href: hasHealth ? `/${city.slug}/${borough.slug}/health/` : null, icon: "🏥", color: "text-rose-600" },
  { label: "Schools", value: summary.schools, href: hasSchools ? `/${city.slug}/${borough.slug}/schools/` : null, icon: "🏫", color: "text-indigo-600" },
  { label: "Safety services", value: getBoroughSafetyServiceCount(city.slug, borough.slug), href: `/${city.slug}/safety/?highlight=${borough.slug}`, icon: "🚨", color: "text-amber-600" },
  { label: "Places", value: placesCount, href: boroughPlaces.length > 0 ? `/${city.slug}/${borough.slug}/places/` : null, icon: "📍", color: "text-teal-600" },
  { label: "Food & Hospitality", value: foodCount, href: foodCount > 0 ? `/${city.slug}/${borough.slug}/food/` : null, icon: "🍽️", color: "text-orange-600" },
  { label: "Statistics", value: null as number | null, href: `/${city.slug}/property/?highlight=${borough.slug}`, icon: "🏠", color: "text-emerald-600" },
];
const favouritesLookup = getFavouritesLookup();
const districtGroups = partitionDistrictsForNav(borough.outcodes, city.name);
const hasSplitDistricts = districtGroups.split.length > 0;
---

<BaseLayout title={borough.name} description={`Health, safety, schools, transport, and civic information for every postcode area in ${borough.name}.`} menuLevel="borough" citySlug={city.slug} boroughSlug={borough.slug}>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 pt-6 pb-4">
    <RotatingBanner images={getBannerImages(borough.slug)} />
    <div class="flex items-start justify-between gap-4 mt-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{borough.name}</h1>
        <p class="text-stone-500 mt-1">{borough.outcodes.length} postcode districts covered</p>
      </div>
      {
        hasCouncilServices && (
          <a
            href={`/${city.slug}/${borough.slug}/services/`}
            class="shrink-0 rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 transition-colors"
          >
            Council Services
          </a>
        )
      }
    </div>
    {
      hasSplitDistricts && (
        <p class="text-sm text-stone-500 mt-1">
          Some postcode districts extend beyond the borough boundary. Districts marked <PartBadge /> are shared with a neighbouring borough.
        </p>
      )
    }
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-8">
    <div class="grid gap-4 sm:grid-cols-6 mb-8">
      {
        summaryStats.map((stat) => {
          const cardClass = "relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4 text-center transition-colors" + (stat.href ? " hover:border-emerald-600 cursor-pointer" : "");
          const content = (
            <>
              <span class:list={["pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none", stat.color]} aria-hidden="true">
                {stat.icon}
              </span>
              {stat.value === null ? (
                <svg class="relative mx-auto h-8 w-8 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Chart">
                  <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
                </svg>
              ) : (
                <p class="relative text-2xl font-bold text-emerald-800">{stat.value.toLocaleString()}</p>
              )}
              <p class="relative text-xs text-stone-500 mt-1">{stat.label}</p>
            </>
          );
          return stat.href ? (
            <a href={stat.href} class={cardClass}>
              {content}
            </a>
          ) : (
            <div class={cardClass}>{content}</div>
          );
        })
      }
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <LiveWeatherWidget latitude={summary.latitude} longitude={summary.longitude} />
      <LiveAirQualityWidget latitude={summary.latitude} longitude={summary.longitude} />
    </div>

    {
      (summary.historySummary || hasRepresentatives) && (
        <div class="flex items-stretch gap-4 mt-6">
          {summary.historySummary && (
            <div class="flex-1 rounded-lg border border-stone-200 bg-white p-4">
              <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">About {borough.name}</p>
              <p class="text-sm text-stone-600">{summary.historySummary}</p>
            </div>
          )}
          {hasRepresentatives && (
            <a
              href={`/${city.slug}/${borough.slug}/representatives/`}
              class="relative overflow-hidden shrink-0 w-32 sm:w-40 aspect-square rounded-lg border border-stone-200 bg-white p-4 text-center flex flex-col items-center justify-center transition-colors hover:border-emerald-600 cursor-pointer"
            >
              <span class="pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none text-purple-600" aria-hidden="true">
                🏛️
              </span>
              <p class="relative text-2xl font-bold text-emerald-800">{mpCount}</p>
              <p class="relative text-xs text-stone-500 mt-1">Representatives</p>
            </a>
          )}
        </div>
      )
    }
  </section>

  <script type="application/json" id="favourites-lookup" set:html={JSON.stringify(favouritesLookup)} />

  <section class="mx-auto max-w-5xl px-4 pb-4 hidden" data-favourites-section>
    <h2 class="text-xl font-semibold mb-4">Your Favourites</h2>
    <div class="grid gap-3 sm:grid-cols-2" data-favourites-list></div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-xl font-semibold mb-4">Postcode districts in {borough.name}</h2>
    <div class="grid gap-3 sm:grid-cols-3" data-favorite-list data-no-reorder>
      {
        districtGroups.full.map((outcode) => {
          const favKey = `outcode:${city.slug}/${borough.slug}/${outcode.slug}`;
          return (
            <div class="relative rounded-lg border border-stone-200 bg-white transition-colors" data-favorite-key={favKey}>
              <a
                href={`/${city.slug}/${borough.slug}/${outcode.slug}/`}
                class="flex items-center gap-3 px-4 py-3 pr-9 hover:border-emerald-600 rounded-lg transition-colors"
              >
                <span class="h-10 w-10 shrink-0 rounded-md border border-stone-200 bg-stone-100 text-stone-600 text-[11px] font-bold flex items-center justify-center">
                  {outcode.outcode}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold truncate">{districtLocalName(outcode, city.name)}</span>
                  <span class="block text-xs text-stone-500 truncate">{outcode.wards.join(", ")}</span>
                </span>
              </a>
              <div class="absolute top-1.5 right-1.5">
                <FavoriteStar favKey={favKey} size="sm" />
              </div>
            </div>
          );
        })
      }
    </div>

    {
      hasSplitDistricts && (
        <>
          <h2 class="text-lg font-semibold mt-8 mb-4">Partly in this borough</h2>
          <div class="grid gap-3 sm:grid-cols-3" data-favorite-list data-no-reorder>
            {districtGroups.split.map((outcode) => {
              const favKey = `outcode:${city.slug}/${borough.slug}/${outcode.slug}`;
              return (
                <div class="relative rounded-lg border border-stone-200 bg-white transition-colors" data-favorite-key={favKey}>
                  <a
                    href={`/${city.slug}/${borough.slug}/${outcode.slug}/`}
                    class="flex items-center gap-3 px-4 py-3 pr-9 hover:border-emerald-600 rounded-lg transition-colors"
                  >
                    <span class="h-10 w-10 shrink-0 rounded-md border border-stone-200 bg-stone-100 text-stone-600 text-[11px] font-bold flex items-center justify-center">
                      {outcode.outcode}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center truncate font-semibold">
                        <span class="truncate">{districtLocalName(outcode, city.name)}</span>
                        <PartBadge borough={borough.name} />
                      </span>
                    </span>
                  </a>
                  <div class="absolute top-1.5 right-1.5">
                    <FavoriteStar favKey={favKey} size="sm" />
                  </div>
                </div>
              );
            })}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
