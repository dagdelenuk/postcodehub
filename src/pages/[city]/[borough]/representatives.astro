---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import VotingInfo from "../../../components/VotingInfo.astro";
import { getBoroughRepresentatives, getCouncilServices, mpContactUrl, getLocalElections, getWardElectionResults, loadHierarchy } from "../../../lib/data";
import type { Representative } from "../../../lib/types";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughRepresentatives(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughRepresentatives(city.slug, borough.slug);

// MPs are constituency-based, not ward-based, so the same MP repeats across
// every outcode in their constituency - dedupe by name + constituency for a
// single borough-wide list (a borough spanning several constituencies still
// gets each MP once).
const mpByKey = new Map<string, Representative>();
for (const group of groups) {
  for (const rep of group.representatives) {
    if (rep.role === "MP") mpByKey.set(`${rep.name}|${rep.constituency}`, rep);
  }
}
const mps = [...mpByKey.values()].sort((a, b) => a.name.localeCompare(b.name));

// Councillors are ward-based, and a ward's councillor list is identical
// wherever that ward is referenced from - dedupe by ward name so a ward
// shared by several outcodes only gets one card.
const councillorsByWard = new Map<string, Representative[]>();
for (const group of groups) {
  for (const rep of group.representatives) {
    if (rep.role === "Councillor" && rep.ward && !councillorsByWard.has(rep.ward)) {
      councillorsByWard.set(
        rep.ward,
        group.representatives.filter((r) => r.role === "Councillor" && r.ward === rep.ward)
      );
    }
  }
}
const wardNames = [...councillorsByWard.keys()].sort((a, b) => a.localeCompare(b));

const election = getLocalElections(borough.slug);
const wardResults = election ? getWardElectionResults(borough.slug, wardNames) : [];
const pct = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 1 });
---

<BaseLayout
  title={`Representatives in ${borough.name}`}
  description={`MPs, ward councillors, and local election results for ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Representatives" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-6">Your representatives in {borough.name}</h1>

    {
      mps.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-3">Members of Parliament</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {mps.map((rep) => (
              <div class="rounded-lg border border-stone-200 bg-white p-4">
                <p class="font-medium">{rep.name}</p>
                <p class="text-sm text-stone-500 mt-1">{rep.party} &middot; {rep.constituency}</p>
                {rep.contactUrl && (
                  <a href={mpContactUrl(rep.name)} target="_blank" rel="noopener" class="text-sm text-emerald-700 hover:underline mt-1 inline-block">
                    Contact &rarr;
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      wardNames.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-3">Ward councillors ({wardNames.length} wards)</h2>
          {wardNames.map((ward) => (
            <div class="mb-6">
              <h3 class="font-medium text-stone-700 mb-2">{ward}</h3>
              <div class="grid gap-3 sm:grid-cols-2">
                {councillorsByWard.get(ward)!.map((rep) => (
                  <div class="rounded-lg border border-stone-200 bg-white p-4">
                    <p class="font-medium">{rep.name}</p>
                    <p class="text-sm text-stone-500 mt-1">{rep.party}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>
      )
    }

    {
      election && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-1">Local election results</h2>
          <p class="text-sm text-stone-500 mb-4">
            Last election: {election.lastElectionYear} &middot; Turnout {pct.format(election.lastElectionTurnoutPercent)}% (
            {election.lastElectionTurnoutVotes.toLocaleString()} of {election.lastElectionRegisteredElectors.toLocaleString()} registered
            electors) &middot; Next election due {election.nextElectionYear}
          </p>

          {
            wardResults.length > 0 && (
              <div class="grid gap-4 sm:grid-cols-2 mb-3">
                {wardResults.map((ward) => (
                  <div class="rounded-lg border border-stone-200 bg-white p-4">
                    <p class="font-medium">
                      {ward.ward} <span class="font-normal text-stone-500">&middot; {ward.year} result</span>
                    </p>
                    {ward.turnoutPercent != null && (
                      <p class="text-xs text-stone-500 mt-0.5">
                        Turnout {pct.format(ward.turnoutPercent)}%{ward.turnoutVotes != null && ` (${ward.turnoutVotes.toLocaleString()} votes)`}
                      </p>
                    )}
                    <table class="w-full text-sm mt-3">
                      <tbody>
                        {ward.candidates.map((c) => (
                          <tr class="border-b border-stone-100 last:border-0">
                            <td class="py-1.5 pr-2">
                              {c.elected && <span title="Elected">✅ </span>}
                              {c.name}
                              <span class="block text-xs text-stone-500">{c.party}</span>
                            </td>
                            <td class="py-1.5 text-right align-top whitespace-nowrap">
                              {c.votes.toLocaleString()}
                              <span class="block text-xs text-stone-500">{pct.format(c.votePercent)}%</span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ))}
              </div>
            )
          }

          <p class="text-xs text-stone-400">
            {wardResults.length > 0 && election.wardResultsYear !== election.lastElectionYear && (
              <>
                Ward-level vote counts above are from the {election.wardResultsYear} election, the most recent with published figures for
                every candidate - current ward councillors (above) reflect {election.lastElectionYear} results and any by-elections since.{" "}
              </>
            )}
            Full, up-to-date results:{" "}
            <a href={election.resultsUrl} target="_blank" rel="noopener" class="text-emerald-700 hover:underline">
              {borough.name} council &rarr;
            </a>
          </p>
        </section>
      )
    }

    <VotingInfo services={getCouncilServices(borough.slug)} boroughName={borough.name} />

    <p class="text-xs text-stone-400 mt-6">Sources: UK Parliament Members API; {borough.name} council.</p>
  </section>
</BaseLayout>
