---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SchoolCard from "../../../components/SchoolCard.astro";
import SchoolFilters from "../../../components/SchoolFilters.astro";
import { getBoroughSchools, getSchoolAdmissionsUrl, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughSchools(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughSchools(city.slug, borough.slug);
const allSchools = groups.flatMap((g) => g.schools);
const totalSchools = allSchools.length;
const admissionsUrl = getSchoolAdmissionsUrl(borough.slug);
const hasCompositeLabelNote = allSchools.some((s) => s.ofstedRatingDerivedFromAreaGrades);
---

<BaseLayout
  title={`Schools in ${borough.name}`}
  description={`Schools and Ofsted ratings across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Schools" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Schools in {borough.name} ({totalSchools})</h1>

    <SchoolFilters schools={allSchools} />

    {
      groups.map((group) => (
        <div class="mb-8" data-school-group>
          <h2 class="text-lg font-semibold mb-3">
            <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/schools/`} class="hover:text-emerald-700">
              {group.outcode}
            </a>
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {group.schools.map((school) => (
              <SchoolCard school={school} />
            ))}
          </div>
        </div>
      ))
    }

    {
      hasCompositeLabelNote && (
        <p class="text-xs text-stone-400 mb-8">
          Some ratings above are based on a school's lowest-graded individual area, since Ofsted's post-2024 framework doesn't
          publish a single composite label.
        </p>
      )
    }

    {
      admissionsUrl && (
        <section class="mb-4">
          <h2 class="text-lg font-semibold mb-3">School admissions</h2>
          <a
            href={admissionsUrl}
            target="_blank"
            rel="noopener"
            class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors sm:max-w-md"
          >
            <span class="text-3xl leading-none" aria-hidden="true">📝</span>
            <div>
              <p class="font-medium">School admissions</p>
              <p class="text-sm text-stone-500 mt-1">
                Find out what school year group your child is in and what school application to make. Apply for primary or
                secondary schools for your child and in-year admissions.
              </p>
            </div>
          </a>
        </section>
      )
    }

    <p class="text-xs text-stone-400 mt-4">Source: DfE Get Information about Schools (GIAS) and Ofsted inspection outcomes.</p>
  </section>
</BaseLayout>
