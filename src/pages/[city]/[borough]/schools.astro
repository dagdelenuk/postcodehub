---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LeafletAssets from "../../../components/LeafletAssets.astro";
import SchoolFilters from "../../../components/SchoolFilters.astro";
import SchoolListSection from "../../../components/SchoolListSection.astro";
import ChildcareCard from "../../../components/ChildcareCard.astro";
import RelatedGuides from "../../../components/RelatedGuides.astro";
import { displayPlaceName, getBoroughChildcare, getBoroughSchools, getSchoolAdmissionsUrl, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getBoroughSchools(city.slug, borough.slug).length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const groups = getBoroughSchools(city.slug, borough.slug).map((g) => ({
  ...g,
  placeName: displayPlaceName(g.postTown, g.wards, city.name),
}));
const allSchools = groups.flatMap((g) => g.schools);
const totalSchools = allSchools.length;
const admissionsUrl = getSchoolAdmissionsUrl(borough.slug);
const hasCompositeLabelNote = allSchools.some((s) => s.ofstedRatingDerivedFromAreaGrades);
const postTowns = [...new Set(groups.map((g) => g.placeName))].sort((a, b) => a.localeCompare(b));

// Ofsted-ratings summary.
const ratingsSummary = (() => {
  const rated = allSchools.filter((s) => s.ofstedRating);
  if (rated.length === 0) return null;
  const pct = (n: number) => `${((n / rated.length) * 100).toFixed(0)}%`;
  const counts = new Map<string, number>();
  for (const s of rated) counts.set(s.ofstedRating!, (counts.get(s.ofstedRating!) ?? 0) + 1);
  const breakdown = [...counts.entries()]
    .sort(([, a], [, b]) => b - a)
    .map(([rating, count]) => `${pct(count)} ${rating}`)
    .join(", ");
  const primary = allSchools.filter((s) => s.phaseOfEducation === "Primary").length;
  const secondary = allSchools.filter((s) => s.phaseOfEducation === "Secondary").length;
  const other = totalSchools - primary - secondary;
  const phaseParts = [
    primary > 0 ? `${primary} primary` : null,
    secondary > 0 ? `${secondary} secondary` : null,
    other > 0 ? `${other} other (independent, special or further/higher education)` : null,
  ].filter((p): p is string => p !== null);
  return {
    headline: `Of the ${rated.length} schools in ${borough.name} with a current Ofsted rating (out of ${totalSchools} in total), ${breakdown}.`,
    phases: phaseParts.length > 0 ? `By phase: ${phaseParts.join(", ")}.` : null,
    unrated: totalSchools - rated.length,
  };
})();
const childcareGroups = getBoroughChildcare(city.slug, borough.slug).map((g) => ({
  ...g,
  placeName: displayPlaceName(g.postTown, g.wards, city.name),
}));
const totalChildcare = childcareGroups.reduce((sum, g) => sum + g.providers.length, 0);
---

<BaseLayout
  title={`Schools in ${borough.name}`}
  description={`Schools and Ofsted ratings across ${borough.name}.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Schools" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4">Schools in {borough.name} ({totalSchools})</h1>

    {
      ratingsSummary && (
        <div class="rounded-lg border border-emerald-100 bg-emerald-50/60 p-4 mb-6" data-schools-summary>
          <p class="text-xs uppercase tracking-wide text-emerald-800 font-medium mb-1">At a glance</p>
          <p class="text-sm text-stone-700 leading-relaxed">
            {ratingsSummary.headline} {ratingsSummary.phases}
            {ratingsSummary.unrated > 0 && ` ${ratingsSummary.unrated} have no current Ofsted rating (often a new or independent school).`}
          </p>
          <p class="text-xs text-stone-500 mt-2">
            This is Ofsted inspection ratings only, from DfE Get Information about Schools - we don't hold exam or SATs performance
            data (GCSE or KS2 league tables) for individual schools.
          </p>
        </div>
      )
    }

    <LeafletAssets />
    <SchoolFilters schools={allSchools} postTowns={postTowns} />

    {
      groups.map((group) => (
        <SchoolListSection
          heading={`${group.outcode} - ${group.placeName}`}
          headingHref={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/schools/`}
          sectionKey={group.outcodeSlug}
          schools={group.schools}
          postTown={group.placeName}
        />
      ))
    }

    {
      hasCompositeLabelNote && (
        <p class="text-xs text-stone-400 mb-8">
          Some ratings above are based on a school's lowest-graded individual area, since Ofsted's post-2024 framework doesn't
          publish a single composite label.
        </p>
      )
    }

    {
      childcareGroups.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-3">Nurseries &amp; Childminders in {borough.name} ({totalChildcare})</h2>
          {childcareGroups.map((group) => (
            <div class="mb-6">
              <h3 class="font-medium text-stone-700 mb-2">
                <a href={`/${city.slug}/${borough.slug}/${group.outcodeSlug}/schools/`} class="hover:text-emerald-700">
                  {group.outcode} - {group.placeName}
                </a>{" "}
                ({group.providers.length})
              </h3>
              <div class="grid gap-3 sm:grid-cols-2">
                {group.providers.map((provider) => (
                  <ChildcareCard provider={provider} />
                ))}
              </div>
            </div>
          ))}
        </section>
      )
    }

    {
      admissionsUrl && (
        <section class="mb-4">
          <h2 class="text-lg font-semibold mb-3">School admissions</h2>
          <a
            href={admissionsUrl}
            target="_blank"
            rel="noopener"
            class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors sm:max-w-md"
          >
            <span class="text-3xl leading-none" aria-hidden="true">📝</span>
            <div>
              <p class="font-medium">School admissions</p>
              <p class="text-sm text-stone-500 mt-1">
                Find out what school year group your child is in and what school application to make. Apply for primary or
                secondary schools for your child and in-year admissions.
              </p>
            </div>
          </a>
        </section>
      )
    }

    <RelatedGuides topic="schools" />

    <p class="text-xs text-stone-400 mt-4">
      Sources: DfE Get Information about Schools (GIAS) and Ofsted inspection outcomes; Ofsted childcare providers and
      inspections register.
    </p>
  </section>
</BaseLayout>
