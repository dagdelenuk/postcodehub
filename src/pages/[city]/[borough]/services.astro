---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CouncilServices from "../../../components/CouncilServices.astro";
import NewcomerChecklist from "../../../components/NewcomerChecklist.astro";
import { getBoroughFood, getBoroughHealth, getBoroughPlaces, getBoroughSchools, getCouncilServices, getCouncilTax, loadHierarchy } from "../../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.flatMap((city) =>
    city.boroughs
      .filter((borough) => getCouncilServices(borough.slug).links.length > 0)
      .map((borough) => ({
        params: { city: city.slug, borough: borough.slug },
        props: { city, borough },
      }))
  );
}

const { city, borough } = Astro.props;
const services = getCouncilServices(borough.slug);
---

<BaseLayout
  title={`Council services and moving checklist for ${borough.name}`}
  description={`Moving to ${borough.name}? A first-month checklist (GP, voting, Council Tax, bins, parking) plus bin days and other council services.`}
  menuLevel="borough"
  citySlug={city.slug}
  boroughSlug={borough.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: borough.name, href: `/${city.slug}/${borough.slug}/` },
      { label: "Council services" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-2">Council services in {borough.name}</h1>
    <p class="text-stone-500 mb-6">Bin collection days, Council Tax, parking and other services, straight from {borough.name}'s own website.</p>
    <NewcomerChecklist
      services={services}
      boroughName={borough.name}
      storageKey={borough.slug}
      base={`/${city.slug}/${borough.slug}`}
      connectivityHref={`/${city.slug}/${borough.slug}/statistics/#connectivity`}
      bandD={getCouncilTax(borough.slug)?.bandD}
      pages={{
        health: getBoroughHealth(city.slug, borough.slug).length > 0,
        schools: getBoroughSchools(city.slug, borough.slug).length > 0,
        places: getBoroughPlaces(city.slug, borough.slug).length > 0,
        food: getBoroughFood(city.slug, borough.slug).length > 0,
        transport: false, // transport pages exist per district, not per borough
      }}
    />
    <h2 class="text-2xl font-bold mb-4">All council services</h2>
    <CouncilServices services={services} boroughName={borough.name} />
  </section>
</BaseLayout>
