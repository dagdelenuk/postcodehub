---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RotatingBanner from "../../components/RotatingBanner.astro";
import LiveWeatherWidget from "../../components/LiveWeatherWidget.astro";
import { getBannerImages, getCityFact, getCitySummary, loadHierarchy } from "../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const summary = getCitySummary(city.slug);
const cityFact = getCityFact(city.slug) ?? summary.historySummary;
---

<BaseLayout title={city.name} description={`Community information for ${city.name}, organised by council authority and postcode.`}>
  <Breadcrumbs crumbs={[{ label: "PostcodeHub", href: "/" }, { label: city.name }]} />

  <section class="mx-auto max-w-5xl px-4 pt-6 pb-4">
    <RotatingBanner images={getBannerImages(city.slug)} />
    <h1 class="text-3xl font-bold tracking-tight mt-4">{city.name}</h1>
    <p class="text-stone-500 mt-1">{city.boroughs.length} council {city.boroughs.length === 1 ? "authority" : "authorities"} covered</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-8">
    <div class="grid gap-6 sm:grid-cols-2">
      <LiveWeatherWidget latitude={summary.latitude} longitude={summary.longitude} />
      {cityFact && (
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">About {city.name}</p>
          <p class="text-sm text-stone-600">{cityFact}</p>
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        city.boroughs.map((borough) => {
          const thumb = getBannerImages(borough.slug)[0];
          return (
            <a href={`/${city.slug}/${borough.slug}/`} class="flex items-center gap-4 rounded-lg border border-stone-200 bg-white p-6 hover:border-emerald-600 transition-colors">
              {thumb && <img src={thumb.src} alt="" class="h-16 w-16 shrink-0 rounded-md object-cover" />}
              <div>
                <h2 class="text-lg font-semibold">{borough.name}</h2>
                <p class="text-sm text-stone-500 mt-1">{borough.outcodes.length} postcode areas</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
