---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BoroughTrendChart from "../../components/BoroughTrendChart.astro";
import HighlightBreadcrumbCrumb from "../../components/HighlightBreadcrumbCrumb.astro";
import { getBoroughPostTownPrices, getBoroughPropertyTrendByPostTown, getCityPropertyTrend, getCouncilTax, getCouncilTaxAverage, getHpi, getRents, loadHierarchy } from "../../lib/data";
import type { RentBedroomKey } from "../../lib/types";

function slugify(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities
    .filter((city) => getCityPropertyTrend(city.slug).boroughs.length > 0)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const trend = getCityPropertyTrend(city.slug);

// ?highlight= (which borough the visitor arrived from) is only known once the
// page loads in the browser, so every borough's Council Tax bands are
// precomputed here and the right set is picked and rendered client-side -
// same approach as the Police/Fire stations sections on the safety page.
const councilTaxByBorough = trend.boroughs
  .map((b) => ({ slug: b.slug, name: b.name, councilTax: getCouncilTax(b.slug) }))
  .filter((b) => b.councilTax);
const councilTaxLondonAverage = getCouncilTaxAverage();

// Same precompute-every-borough-then-toggle-client-side approach: property
// sales within the highlighted borough, grouped by Royal Mail post town
// (multiple outcodes can share one, e.g. Twickenham covers TW1 and TW2).
// BoroughTrendChart is reused as-is - its "boroughs" entities just happen to
// be post towns here, with a locally slugified id used only for this chart's
// own legend-toggle DOM matching, not a real route.
const postTownTrendsByBorough = trend.boroughs
  .map((b) => {
    const postTownTrend = getBoroughPropertyTrendByPostTown(city.slug, b.slug);
    return {
      slug: b.slug,
      name: b.name,
      trend: {
        months: postTownTrend.months,
        boroughs: postTownTrend.postTowns.map((p) => ({ name: p.name, slug: slugify(p.name), series: p.series })),
        average: postTownTrend.average,
      },
    };
  })
  .filter((b) => b.trend.boroughs.length > 0);

const gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });
const RENT_ROWS: { key: RentBedroomKey; label: string }[] = [
  { key: "room", label: "Room in a shared house" },
  { key: "studio", label: "Studio" },
  { key: "oneBed", label: "1 bedroom" },
  { key: "twoBed", label: "2 bedrooms" },
  { key: "threeBed", label: "3 bedrooms" },
  { key: "fourPlusBed", label: "4+ bedrooms" },
  { key: "all", label: "All private rentals" },
];
const TYPE_ROWS = [
  { key: "flat", label: "Flat / maisonette" },
  { key: "terraced", label: "Terraced" },
  { key: "semiDetached", label: "Semi-detached" },
  { key: "detached", label: "Detached" },
] as const;

function formatMonth(month: string): string {
  return new Date(`${month}-01`).toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}

// Same precompute-every-borough-then-reveal approach as the sections above.
const housingByBorough = trend.boroughs
  .map((b) => {
    const hpi = getHpi(b.slug);
    return {
      slug: b.slug,
      name: b.name,
      hpi,
      hpiTrend: hpi ? { months: hpi.borough.months, boroughs: [{ name: b.name, slug: b.slug, series: hpi.borough.averagePrice }], average: hpi.london.averagePrice } : null,
      rents: getRents(b.slug),
      prices: getBoroughPostTownPrices(city.slug, b.slug),
    };
  })
  .filter((b) => b.hpi || b.rents || b.prices);
---

<BaseLayout
  title={`Property sales comparison across ${city.name}`}
  description={`Monthly property sale volumes compared across every borough in ${city.name}, with a city average.`}
  menuLevel="city"
  citySlug={city.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: "Property sales comparison" },
    ]}
  />
  <HighlightBreadcrumbCrumb citySlug={city.slug} entities={trend.boroughs} />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <section class="mb-8 hidden" data-council-tax-section>
      <h2 class="text-2xl font-bold mb-1" data-council-tax-heading>Council Tax bands</h2>
      <p class="text-stone-500 mb-3 text-sm" data-council-tax-sub></p>
      <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
              <th class="px-4 py-2 font-semibold">Band</th>
              <th class="px-4 py-2 font-semibold text-right">Annual Council Tax</th>
              <th class="px-4 py-2 font-semibold text-right">Annual Council Tax (AVG London)</th>
            </tr>
          </thead>
          <tbody data-council-tax-rows></tbody>
        </table>
      </div>
    </section>

    {
      housingByBorough.map((b) => (
        <div class="hidden" data-borough-housing data-borough-slug={b.slug}>
          {b.rents && (
            <section class="mb-8">
              <h2 class="text-2xl font-bold mb-1">Private rents in {b.name}</h2>
              <p class="text-stone-500 mb-3 text-sm">Median monthly rent by number of bedrooms, against the London median. Rents recorded {b.rents.period}.</p>
              <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                      <th class="px-4 py-2 font-semibold">Property</th>
                      <th class="px-4 py-2 font-semibold text-right">{b.name} median / month</th>
                      <th class="px-4 py-2 font-semibold text-right">Typical range</th>
                      <th class="px-4 py-2 font-semibold text-right">London median / month</th>
                    </tr>
                  </thead>
                  <tbody>
                    {RENT_ROWS.map((row) => {
                      const local = b.rents!.borough[row.key];
                      const lon = b.rents!.london[row.key];
                      return (
                        <tr class:list={["border-b border-stone-100 last:border-0", row.key === "all" && "bg-emerald-50 font-semibold"]}>
                          <td class="px-4 py-2">{row.label}</td>
                          <td class="px-4 py-2 text-right">
                            {local.median != null ? gbp.format(local.median) : "n/a"}
                            {local.median != null && lon.median != null && local.median !== lon.median && (
                              <span class:list={["ml-1.5", local.median > lon.median ? "text-red-600" : "text-emerald-600"]} title={local.median > lon.median ? "Above the London median" : "Below the London median"}>
                                {local.median > lon.median ? "▲" : "▼"}
                              </span>
                            )}
                          </td>
                          <td class="px-4 py-2 text-right text-stone-500">
                            {local.lowerQuartile != null && local.upperQuartile != null ? `${gbp.format(local.lowerQuartile)} - ${gbp.format(local.upperQuartile)}` : "—"}
                          </td>
                          <td class="px-4 py-2 text-right text-stone-500">{lon.median != null ? gbp.format(lon.median) : "n/a"}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-stone-400 mt-2">
                Source: {b.rents.source}. "Typical range" is the lower to upper quartile. This series was discontinued after this period, so
                current asking rents will be higher. "n/a" means too few rents recorded to publish.
              </p>
            </section>
          )}

          {b.hpi && b.hpiTrend && (
            <section class="mb-8">
              <h2 class="text-2xl font-bold mb-1">House prices in {b.name}</h2>
              <p class="text-stone-500 mb-3 text-sm">Average sale price by month, against the London average. Latest figures: {formatMonth(b.hpi.borough.months[b.hpi.borough.months.length - 1])}.</p>
              <div class="grid gap-4 sm:grid-cols-2 mb-4">
                {[
                  { label: b.name, series: b.hpi.borough },
                  { label: "London average", series: b.hpi.london },
                ].map((c) => (
                  <div class="rounded-lg border border-stone-200 bg-white p-4 text-center">
                    <p class="text-2xl font-bold text-emerald-800">{gbp.format(c.series.averagePrice[c.series.averagePrice.length - 1])}</p>
                    <p class="text-xs text-stone-500 mt-1">
                      {c.label} average price
                      {c.series.annualChange != null && (
                        <span class:list={["ml-1 font-medium", c.series.annualChange >= 0 ? "text-emerald-600" : "text-red-600"]}>
                          {c.series.annualChange >= 0 ? "▲" : "▼"} {Math.abs(c.series.annualChange).toFixed(1)}% in 12 months
                        </span>
                      )}
                    </p>
                  </div>
                ))}
              </div>
              <BoroughTrendChart trend={b.hpiTrend} averageLabel="London average" chartId={`hpi-${b.slug}`} />
              <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white mt-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                      <th class="px-4 py-2 font-semibold">Property type</th>
                      <th class="px-4 py-2 font-semibold text-right">{b.name}</th>
                      <th class="px-4 py-2 font-semibold text-right">London average</th>
                    </tr>
                  </thead>
                  <tbody>
                    {TYPE_ROWS.map((row) => {
                      const local = b.hpi!.borough.byType[row.key];
                      const lon = b.hpi!.london.byType[row.key];
                      return (
                        <tr class="border-b border-stone-100 last:border-0">
                          <td class="px-4 py-2">{row.label}</td>
                          <td class="px-4 py-2 text-right">
                            {local != null ? gbp.format(local) : "n/a"}
                            {local != null && lon != null && local !== lon && (
                              <span class:list={["ml-1.5", local > lon ? "text-red-600" : "text-emerald-600"]} title={local > lon ? "Above the London average" : "Below the London average"}>
                                {local > lon ? "▲" : "▼"}
                              </span>
                            )}
                          </td>
                          <td class="px-4 py-2 text-right text-stone-500">{lon != null ? gbp.format(lon) : "n/a"}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-stone-400 mt-2">Source: {b.hpi.source}.</p>
            </section>
          )}

          {b.prices && b.prices.postTowns.length > 0 && (
            <section class="mb-8">
              <h2 class="text-2xl font-bold mb-1">Sale prices by post town in {b.name}</h2>
              <p class="text-stone-500 mb-3 text-sm">Median price of homes sold since {new Date(b.prices.since).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}, and how it moved on the earlier sales we hold, against the borough and London medians.</p>
              <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                      <th class="px-4 py-2 font-semibold">Post town</th>
                      <th class="px-4 py-2 font-semibold text-right">Sales</th>
                      <th class="px-4 py-2 font-semibold text-right">Median price</th>
                      <th class="px-4 py-2 font-semibold text-right">Change</th>
                    </tr>
                  </thead>
                  <tbody>
                    {[...b.prices.postTowns, { ...b.prices.borough, name: `${b.name} (all)` }, { ...b.prices.london, name: "London average (all boroughs)" }].map((row, i, all) => (
                      <tr class:list={["border-b border-stone-100 last:border-0", i >= all.length - 2 && "bg-emerald-50 font-semibold"]}>
                        <td class="px-4 py-2">{row.name}</td>
                        <td class="px-4 py-2 text-right text-stone-500">{row.sales.toLocaleString()}</td>
                        <td class="px-4 py-2 text-right">
                          {row.median != null ? gbp.format(row.median) : "n/a"}
                          {i < all.length - 2 && row.median != null && b.prices!.london.median != null && row.median !== b.prices!.london.median && (
                            <span class:list={["ml-1.5", row.median > b.prices!.london.median! ? "text-red-600" : "text-emerald-600"]} title={row.median > b.prices!.london.median! ? "Above the London median" : "Below the London median"}>
                              {row.median > b.prices!.london.median! ? "▲" : "▼"}
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-2 text-right text-stone-500">{row.change != null ? `${row.change >= 0 ? "+" : ""}${row.change.toFixed(1)}%` : "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-stone-400 mt-2">
                Source: HM Land Registry Price Paid Data. The official house price index stops at borough level, so post towns are compared on
                median sale prices instead. Change is shown only where there are enough sales in both periods.
              </p>
            </section>
          )}
        </div>
      ))
    }

    {
      postTownTrendsByBorough.map((b) => (
        <div class="hidden mb-8" data-post-town-section data-borough-slug={b.slug}>
          <h2 class="text-2xl font-bold mb-1">Property sales comparison across {b.name}, grouped by post town</h2>
          <p class="text-stone-500 mb-3 text-sm">Monthly residential sales by post town within {b.name}, against the borough average.</p>
          <BoroughTrendChart trend={b.trend} averageLabel={`${b.name} average`} chartId={`property-posttown-${b.slug}`} />
        </div>
      ))
    }

    <h1 class="text-2xl font-bold mb-1">Property sales comparison across {city.name}</h1>
    <p class="text-stone-500 mb-6">Number of residential sales completed per month in each borough, covering roughly the last two years.</p>

    <BoroughTrendChart trend={trend} averageLabel={`${city.name} average`} chartId="property" />

    <p class="text-xs text-stone-400 mt-6">
      Source: HM Land Registry Price Paid Data.
      {councilTaxByBorough.length > 0 && " Council Tax: gov.uk, Council Tax levels set by local authorities in England 2026 to 2027 (Band D area council tax, including the GLA precept)."}
    </p>
  </section>

  <script type="application/json" data-council-tax-data set:html={JSON.stringify(councilTaxByBorough)} />
  <script type="application/json" data-council-tax-average set:html={JSON.stringify(councilTaxLondonAverage)} />

  <script>
    interface BoroughCouncilTax {
      slug: string;
      name: string;
      councilTax: {
        boroughName: string;
        bandD: number;
        bands: Record<string, number>;
      };
    }

    const BAND_ORDER = ["A", "B", "C", "D", "E", "F", "G", "H"];
    const GBP = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });

    document.querySelectorAll<HTMLScriptElement>("[data-council-tax-data]").forEach((el) => {
      const boroughs = JSON.parse(el.textContent ?? "[]") as BoroughCouncilTax[];
      const highlight = new URLSearchParams(location.search).get("highlight");
      const match = highlight ? boroughs.find((b) => b.slug === highlight) : null;
      if (!match) return;

      const averageEl = document.querySelector<HTMLScriptElement>("[data-council-tax-average]");
      const londonAverage = JSON.parse(averageEl?.textContent ?? "{}") as Record<string, number>;

      const section = document.querySelector<HTMLElement>("[data-council-tax-section]");
      const heading = document.querySelector<HTMLElement>("[data-council-tax-heading]");
      const sub = document.querySelector<HTMLElement>("[data-council-tax-sub]");
      const rows = document.querySelector<HTMLElement>("[data-council-tax-rows]");
      if (!section || !heading || !sub || !rows) return;

      heading.textContent = `Council Tax bands in ${match.name}`;
      sub.textContent = `2026-27 rates, Band D (the reference band) is ${GBP.format(match.councilTax.bandD)} a year.`;

      for (const band of BAND_ORDER) {
        const amount = match.councilTax.bands[band];
        if (amount == null) continue;
        const avgAmount = londonAverage[band];
        const tr = document.createElement("tr");
        tr.className = band === "D" ? "border-b border-stone-100 bg-emerald-50 font-semibold" : "border-b border-stone-100 last:border-0";

        const bandCell = document.createElement("td");
        bandCell.className = "px-4 py-2";
        bandCell.textContent = `Band ${band}`;

        const amountCell = document.createElement("td");
        amountCell.className = "px-4 py-2 text-right";
        amountCell.textContent = GBP.format(amount);
        if (avgAmount != null && amount !== avgAmount) {
          const icon = document.createElement("span");
          icon.className = amount > avgAmount ? "text-red-600 ml-1.5" : "text-emerald-600 ml-1.5";
          icon.textContent = amount > avgAmount ? "▲" : "▼";
          icon.title = amount > avgAmount ? "Above the London average" : "Below the London average";
          amountCell.append(icon);
        }

        const avgCell = document.createElement("td");
        avgCell.className = "px-4 py-2 text-right text-stone-500";
        avgCell.textContent = avgAmount != null ? GBP.format(avgAmount) : "—";

        tr.append(bandCell, amountCell, avgCell);
        rows.append(tr);
      }

      section.classList.remove("hidden");
    });
  </script>

  <script>
    const highlight = new URLSearchParams(location.search).get("highlight");
    if (highlight) {
      document.querySelector(`[data-post-town-section][data-borough-slug="${highlight}"]`)?.classList.remove("hidden");
      document.querySelector(`[data-borough-housing][data-borough-slug="${highlight}"]`)?.classList.remove("hidden");
    }
  </script>
</BaseLayout>
