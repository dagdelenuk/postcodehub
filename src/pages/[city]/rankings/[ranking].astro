---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { loadHierarchy } from "../../../lib/data";
import { RANKINGS, getRanking } from "../../../lib/rankings";
import { itemListJsonLd } from "../../../lib/seo";

export function getStaticPaths() {
  return loadHierarchy().cities.flatMap((city) => RANKINGS.map((r) => ({ params: { city: city.slug, ranking: r.slug }, props: { city } })));
}

const { ranking } = Astro.params;
const { city } = Astro.props;
const result = getRanking(ranking!)!;
const { def, rows } = result;
const TOP = 25;
const top = rows.slice(0, TOP);
const rest = rows.slice(TOP);
const unit = def.scope === "borough" ? "boroughs" : "postcode districts";
const others = RANKINGS.filter((r) => r.slug !== def.slug);

---

<BaseLayout
  title={def.title}
  description={def.description}
  menuLevel="city"
  citySlug={city.slug}
  jsonLd={itemListJsonLd({
    name: def.title,
    description: def.description,
    url: `/${city.slug}/rankings/${def.slug}/`,
    items: top.slice(0, 10).map((r) => ({ name: `${r.name} (${r.subtitle})`, url: r.href.split("?")[0] })),
  })}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: "Rankings", href: `/${city.slug}/rankings/` },
      { label: def.name },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-2"><span aria-hidden="true">{def.emoji}</span> {def.title}</h1>
    <p class="text-stone-600 mb-2">{def.description}</p>
    <p class="text-sm text-stone-500 mb-6">
      {rows.length} {unit} ranked, {def.higherIsBetter ? "highest" : "lowest"} {def.primary.label.toLowerCase()} first.
    </p>

    <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
            <th class="px-4 py-2 font-semibold w-12">#</th>
            <th class="px-4 py-2 font-semibold">Area</th>
            <th class="px-4 py-2 font-semibold text-right whitespace-nowrap">{def.primary.label}</th>
            {def.extra.map((c) => <th class="px-4 py-2 font-semibold text-right whitespace-nowrap hidden sm:table-cell">{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            top.map((r) => (
              <tr class:list={["border-b border-stone-100 last:border-0", r.rank <= 3 && "bg-emerald-50"]}>
                <td class="px-4 py-2 font-semibold text-stone-500">{r.rank}</td>
                <td class="px-4 py-2">
                  <a href={r.href} class="font-medium text-emerald-700 hover:underline">{r.name}</a>
                  <span class="block text-xs text-stone-400">{r.subtitle}</span>
                </td>
                <td class="px-4 py-2 text-right font-semibold whitespace-nowrap">{r.primary}</td>
                {r.extra.map((v) => <td class="px-4 py-2 text-right text-stone-500 whitespace-nowrap hidden sm:table-cell">{v}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      rest.length > 0 && (
        <details class="mt-4 rounded-lg border border-stone-200 bg-white">
          <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-emerald-700">Show the other {rest.length} {unit}</summary>
          <div class="overflow-x-auto border-t border-stone-100">
            <table class="w-full text-sm">
              <tbody>
                {rest.map((r) => (
                  <tr class="border-b border-stone-100 last:border-0">
                    <td class="px-4 py-2 font-semibold text-stone-500 w-12">{r.rank}</td>
                    <td class="px-4 py-2">
                      <a href={r.href} class="font-medium text-emerald-700 hover:underline">{r.name}</a>
                      <span class="block text-xs text-stone-400">{r.subtitle}</span>
                    </td>
                    <td class="px-4 py-2 text-right font-semibold whitespace-nowrap">{r.primary}</td>
                    {r.extra.map((v) => <td class="px-4 py-2 text-right text-stone-500 whitespace-nowrap hidden sm:table-cell">{v}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )
    }

    <p class="text-xs text-stone-400 mt-4">{def.caveat}</p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href="/compare/" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-700 px-3.5 py-2 text-sm font-medium text-white hover:bg-emerald-800 transition-colors">
        Compare areas side by side
      </a>
      <a href={`/${city.slug}/statistics/`} class="text-sm text-emerald-700 hover:underline">All {city.name} statistics &rarr;</a>
    </div>

    <h2 class="text-lg font-semibold mt-10 mb-3">More rankings</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        others.map((r) => (
          <li>
            <a href={`/${city.slug}/rankings/${r.slug}/`} class="flex items-center gap-3 rounded-lg border border-stone-200 bg-white p-3 hover:border-emerald-600 transition-colors">
              <span class="text-2xl leading-none" aria-hidden="true">{r.emoji}</span>
              <span class="font-medium text-sm">{r.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
