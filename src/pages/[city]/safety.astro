---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BoroughTrendChart from "../../components/BoroughTrendChart.astro";
import HighlightBreadcrumbCrumb from "../../components/HighlightBreadcrumbCrumb.astro";
import { getBoroughFireStations, getBoroughPoliceStations, getCityCrimeTrend, loadHierarchy } from "../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities
    .filter((city) => getCityCrimeTrend(city.slug).boroughs.length > 0)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const trend = getCityCrimeTrend(city.slug);

// ?highlight= (which borough the visitor arrived from) is only known once the
// page loads in the browser, so every borough's stations are precomputed here
// and the right set is picked and rendered client-side - same approach as
// HighlightBreadcrumbCrumb and BoroughTrendChart's own highlight handling.
const policeStationsByBorough = trend.boroughs.map((b) => ({
  slug: b.slug,
  name: b.name,
  stations: getBoroughPoliceStations(city.slug, b.slug),
}));
const fireStationsByBorough = trend.boroughs.map((b) => ({
  slug: b.slug,
  name: b.name,
  stations: getBoroughFireStations(city.slug, b.slug),
}));
---

<BaseLayout
  title={`Crime comparison across ${city.name}`}
  description={`Monthly crime trends compared across every borough in ${city.name}, with a city average.`}
  menuLevel="city"
  citySlug={city.slug}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: "Crime comparison" },
    ]}
  />
  <HighlightBreadcrumbCrumb citySlug={city.slug} entities={trend.boroughs} />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <section class="mb-8 hidden" data-police-stations-section>
      <h2 class="text-2xl font-bold mb-1" data-police-stations-heading>Police stations</h2>
      <p class="text-stone-500 mb-3 text-sm" data-police-stations-sub></p>
      <div class="grid gap-3 sm:grid-cols-2" data-police-stations-list></div>
    </section>

    <section class="mb-8 hidden" data-fire-stations-section>
      <h2 class="text-2xl font-bold mb-1" data-fire-stations-heading>Fire stations</h2>
      <p class="text-stone-500 mb-3 text-sm" data-fire-stations-sub></p>
      <div class="grid gap-3 sm:grid-cols-2" data-fire-stations-list></div>
    </section>

    <h1 class="text-2xl font-bold mb-1">Crime comparison across {city.name}</h1>
    <p class="text-stone-500 mb-6">Monthly recorded crimes per borough, each estimated within roughly 1 mile of its postcode areas' centres.</p>

    <BoroughTrendChart trend={trend} averageLabel={`${city.name} average`} chartId="crime" />

    <p class="text-xs text-stone-400 mt-6">
      Source: data.police.uk street-level crime data. Police and fire station locations: OpenStreetMap contributors.
    </p>
  </section>

  <script type="application/json" data-police-stations-data set:html={JSON.stringify(policeStationsByBorough)} />
  <script type="application/json" data-fire-stations-data set:html={JSON.stringify(fireStationsByBorough)} />

  <script>
    interface BoroughStations {
      slug: string;
      name: string;
      stations: { name: string; address: string; postcode: string; telephone?: string; distanceKm: number }[];
    }

    function renderStationSection(config: {
      dataAttr: string;
      sectionAttr: string;
      headingAttr: string;
      subAttr: string;
      listAttr: string;
      kindLabel: string;
      icon: string;
      iconColorClass: string;
    }) {
      document.querySelectorAll<HTMLScriptElement>(`[${config.dataAttr}]`).forEach((el) => {
        const boroughs = JSON.parse(el.textContent ?? "[]") as BoroughStations[];
        const highlight = new URLSearchParams(location.search).get("highlight");
        const match = highlight ? boroughs.find((b) => b.slug === highlight) : null;
        if (!match || match.stations.length === 0) return;

        const section = document.querySelector<HTMLElement>(`[${config.sectionAttr}]`);
        const heading = document.querySelector<HTMLElement>(`[${config.headingAttr}]`);
        const sub = document.querySelector<HTMLElement>(`[${config.subAttr}]`);
        const list = document.querySelector<HTMLElement>(`[${config.listAttr}]`);
        if (!section || !heading || !sub || !list) return;

        heading.textContent = `${config.kindLabel}s in ${match.name}`;
        sub.textContent = `${match.stations.length} ${config.kindLabel.toLowerCase()}${match.stations.length === 1 ? "" : "s"}, nearest to furthest from the centre of ${match.name}.`;

        for (const station of match.stations) {
          const card = document.createElement("div");
          card.className = "relative overflow-hidden rounded-lg border border-stone-200 bg-white p-4";

          const icon = document.createElement("span");
          icon.className = `pointer-events-none select-none absolute -right-2 -bottom-3 text-6xl opacity-25 leading-none ${config.iconColorClass}`;
          icon.setAttribute("aria-hidden", "true");
          icon.textContent = config.icon;

          const inner = document.createElement("div");
          inner.className = "relative";

          const name = document.createElement("p");
          name.className = "font-medium";
          name.textContent = station.name;
          inner.append(name);

          const addressLine = [station.address, station.postcode].filter(Boolean).join(", ");
          if (addressLine) {
            const addr = document.createElement("p");
            addr.className = "text-sm text-stone-500 mt-1";
            addr.textContent = addressLine;
            inner.append(addr);
          }

          if (station.telephone) {
            const tel = document.createElement("p");
            tel.className = "text-sm text-stone-500";
            tel.textContent = station.telephone;
            inner.append(tel);
          }

          const dist = document.createElement("p");
          dist.className = "text-xs text-stone-400 mt-1";
          dist.textContent = `${(station.distanceKm * 0.621371).toFixed(1)} mi away`;
          inner.append(dist);

          card.append(icon, inner);
          list.append(card);
        }

        section.classList.remove("hidden");
      });
    }

    renderStationSection({
      dataAttr: "data-police-stations-data",
      sectionAttr: "data-police-stations-section",
      headingAttr: "data-police-stations-heading",
      subAttr: "data-police-stations-sub",
      listAttr: "data-police-stations-list",
      kindLabel: "Police station",
      icon: "🚓",
      iconColorClass: "text-blue-700",
    });

    renderStationSection({
      dataAttr: "data-fire-stations-data",
      sectionAttr: "data-fire-stations-section",
      headingAttr: "data-fire-stations-heading",
      subAttr: "data-fire-stations-sub",
      listAttr: "data-fire-stations-list",
      kindLabel: "Fire station",
      icon: "🚒",
      iconColorClass: "text-red-600",
    });
  </script>
</BaseLayout>
