---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCityCrimeTrend, loadHierarchy } from "../../lib/data";

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities
    .filter((city) => getCityCrimeTrend(city.slug).boroughs.length > 0)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const trend = getCityCrimeTrend(city.slug);

// month is stored "YYYY-MM"; display as "MM-YY" (Ay-Yil).
function formatMonthLabel(month: string): string {
  const [year, mon] = month.split("-");
  return `${mon}-${year.slice(2)}`;
}

// Golden-angle hue rotation gives maximally distinct colours for any borough
// count without clustering, unlike a fixed palette that runs out or repeats.
function colorFor(index: number): string {
  const hue = (index * 137.508) % 360;
  return `hsl(${hue.toFixed(0)}, 62%, 42%)`;
}

const PAD_LEFT = 56;
const PAD_RIGHT = 16;
const PAD_TOP = 16;
const PAD_BOTTOM = 36;
const CHART_WIDTH = 900;
const CHART_HEIGHT = 360;
const plotWidth = CHART_WIDTH - PAD_LEFT - PAD_RIGHT;
const plotHeight = CHART_HEIGHT - PAD_TOP - PAD_BOTTOM;

const monthCount = trend.months.length;
const maxValue = Math.max(...trend.boroughs.flatMap((b) => b.series), ...trend.average, 1) * 1.08;

function xAt(i: number): number {
  return PAD_LEFT + (monthCount <= 1 ? 0 : (i / (monthCount - 1)) * plotWidth);
}
function yAt(value: number): number {
  return PAD_TOP + (1 - value / maxValue) * plotHeight;
}
function pointsFor(series: number[]): string {
  return series.map((v, i) => `${xAt(i).toFixed(1)},${yAt(v).toFixed(1)}`).join(" ");
}

const gridLines = [0, 0.25, 0.5, 0.75, 1].map((frac) => ({
  y: PAD_TOP + (1 - frac) * plotHeight,
  value: Math.round(maxValue * frac),
}));

const boroughsWithColor = trend.boroughs.map((b, i) => ({ ...b, color: colorFor(i) }));
---

<BaseLayout
  title={`Crime comparison across ${city.name}`}
  description={`Monthly crime trends compared across every borough in ${city.name}, with a city average.`}
  menuLevel="city"
  citySlug={city.slug}
>
  <Breadcrumbs
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: "Crime comparison" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-1">Crime comparison across {city.name}</h1>
    <p class="text-stone-500 mb-6">Monthly recorded crimes per borough, each estimated within roughly 1 mile of its postcode areas' centres.</p>

    <div class="rounded-lg border border-stone-200 bg-white p-4 overflow-x-auto" data-crime-chart>
      <svg viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`} class="w-full min-w-[640px]" role="img" aria-label={`Monthly crime trend by borough in ${city.name}`}>
        {
          gridLines.map((g) => (
            <>
              <line x1={PAD_LEFT} y1={g.y} x2={CHART_WIDTH - PAD_RIGHT} y2={g.y} stroke="#e7e5e4" stroke-width="1" />
              <text x={PAD_LEFT - 8} y={g.y + 4} text-anchor="end" font-size="10" fill="#a8a29e">
                {g.value.toLocaleString()}
              </text>
            </>
          ))
        }
        {
          trend.months.map((m, i) => (
            <text x={xAt(i)} y={CHART_HEIGHT - PAD_BOTTOM + 16} text-anchor="middle" font-size="10" fill="#a8a29e">
              {formatMonthLabel(m)}
            </text>
          ))
        }

        {
          boroughsWithColor.map((b) => (
            <polyline
              points={pointsFor(b.series)}
              fill="none"
              stroke={b.color}
              stroke-width="1.75"
              stroke-linejoin="round"
              stroke-linecap="round"
              data-borough-line
              data-borough-slug={b.slug}
            >
              <title>{b.name}</title>
            </polyline>
          ))
        }

        <polyline points={pointsFor(trend.average)} fill="none" stroke="#1c1917" stroke-width="2.5" stroke-dasharray="6 4" stroke-linejoin="round" stroke-linecap="round" data-average-line>
          <title>{city.name} average</title>
        </polyline>
      </svg>
    </div>

    <div class="flex flex-wrap items-center gap-2 mt-4" data-crime-legend>
      <button type="button" class="legend-pill is-average" data-legend-toggle="average">
        <span class="legend-dot" style="background:#1c1917" /> {city.name} average
      </button>
      {
        boroughsWithColor.map((b) => (
          <button type="button" class="legend-pill" data-legend-toggle={b.slug}>
            <span class="legend-dot" style={`background:${b.color}`} /> {b.name}
          </button>
        ))
      }
      <button type="button" class="text-xs text-stone-400 underline ml-1" data-legend-reset>
        Show all
      </button>
    </div>

    <p class="text-xs text-stone-400 mt-6">Source: data.police.uk street-level crime data.</p>
  </section>
</BaseLayout>

<style>
  .legend-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    padding: 3px 10px 3px 8px;
    border-radius: 9999px;
    border: 1px solid #e7e5e4;
    background: white;
    color: #57534e;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .legend-pill.is-off {
    opacity: 0.35;
  }
  .legend-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  [data-borough-line].is-dimmed {
    stroke-opacity: 0.22;
  }
  [data-borough-line].is-emphasised {
    stroke-width: 3.5;
  }
  [data-borough-line].is-hidden,
  [data-average-line].is-hidden {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-crime-chart]").forEach((chart) => {
    const wrapper = chart.closest("section");
    if (!wrapper) return;

    const lines = [...chart.querySelectorAll<SVGPolylineElement>("[data-borough-line]")];
    const averageLine = chart.querySelector<SVGPolylineElement>("[data-average-line]");
    const legend = wrapper.querySelector<HTMLElement>("[data-crime-legend]");
    const pills = [...(legend?.querySelectorAll<HTMLButtonElement>("[data-legend-toggle]") ?? [])];
    const resetBtn = legend?.querySelector<HTMLElement>("[data-legend-reset]");

    const hidden = new Set<string>();

    function pillFor(slug: string) {
      return pills.find((p) => p.dataset.legendToggle === slug);
    }

    function refresh() {
      for (const line of lines) {
        const slug = line.dataset.boroughSlug!;
        line.classList.toggle("is-hidden", hidden.has(slug));
      }
      if (hidden.has("average")) averageLine?.classList.add("is-hidden");
      else averageLine?.classList.remove("is-hidden");
      for (const pill of pills) {
        pill.classList.toggle("is-off", hidden.has(pill.dataset.legendToggle!));
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const slug = pill.dataset.legendToggle!;
        if (hidden.has(slug)) hidden.delete(slug);
        else hidden.add(slug);
        refresh();
      });
    });

    resetBtn?.addEventListener("click", () => {
      hidden.clear();
      for (const line of lines) line.classList.remove("is-dimmed", "is-emphasised");
      refresh();
    });

    // Arriving from a specific borough's "Crimes (12mo)" card: emphasise
    // that borough's line and dim the rest, without hiding anything - the
    // point is still to compare against the full picture.
    const params = new URLSearchParams(location.search);
    const highlight = params.get("highlight");
    if (highlight) {
      const highlightLine = lines.find((l) => l.dataset.boroughSlug === highlight);
      if (highlightLine) {
        for (const line of lines) {
          if (line === highlightLine) line.classList.add("is-emphasised");
          else line.classList.add("is-dimmed");
        }
        pillFor(highlight)?.scrollIntoView({ block: "nearest", inline: "center" });
      }
    }

    refresh();
  });
</script>
