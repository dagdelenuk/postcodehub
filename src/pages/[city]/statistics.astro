---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BoroughTrendChart from "../../components/BoroughTrendChart.astro";
import HighlightBreadcrumbCrumb from "../../components/HighlightBreadcrumbCrumb.astro";
import { getBoroughCrimeCategories, getBoroughCrimeTrend, getBoroughSummary, getCitySummary, getCityCrimeTrend, getBoroughPostTownPrices, getBoroughPropertyTrendByPostTown, getCityPropertyTrend, getCouncilTax, getCouncilTaxAverage, getBoroughBroadband, getBoroughDemographics, getHpi, getLondonDemographics, getMobileCoverage, getRents, loadHierarchy } from "../../lib/data";
import ConnectivitySection from "../../components/ConnectivitySection.astro";
import DemographicsSection from "../../components/DemographicsSection.astro";
import BoroughComparisonTable from "../../components/BoroughComparisonTable.astro";
import HousingMarket from "../../components/HousingMarket.astro";
import { datasetJsonLd } from "../../lib/seo";
import CrimeStats from "../../components/CrimeStats.astro";
import LiveAirQualityWidget from "../../components/LiveAirQualityWidget.astro";
import LiveFloodWarningsWidget from "../../components/LiveFloodWarningsWidget.astro";
import SectionTabs from "../../components/SectionTabs.astro";

function slugify(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

export function getStaticPaths() {
  const hierarchy = loadHierarchy();
  return hierarchy.cities
    .filter((city) => getCityPropertyTrend(city.slug).boroughs.length > 0)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const trend = getCityPropertyTrend(city.slug);

// ?highlight= (which borough the visitor arrived from) is only known once the
// page loads in the browser, so every borough's Council Tax bands are
// precomputed here and the right set is picked and rendered client-side -
// same approach as the Police/Fire stations sections on the safety page.
const councilTaxByBorough = trend.boroughs
  .map((b) => ({ slug: b.slug, name: b.name, councilTax: getCouncilTax(b.slug) }))
  .filter((b) => b.councilTax);
const councilTaxLondonAverage = getCouncilTaxAverage();

// Same precompute-every-borough-then-toggle-client-side approach: property
// sales within the highlighted borough, grouped by Royal Mail post town
// (multiple outcodes can share one, e.g. Twickenham covers TW1 and TW2).
// BoroughTrendChart is reused as-is - its "boroughs" entities just happen to
// be post towns here, with a locally slugified id used only for this chart's
// own legend-toggle DOM matching, not a real route.
const postTownTrendsByBorough = trend.boroughs
  .map((b) => {
    const postTownTrend = getBoroughPropertyTrendByPostTown(city.slug, b.slug);
    return {
      slug: b.slug,
      name: b.name,
      trend: {
        months: postTownTrend.months,
        boroughs: postTownTrend.postTowns.map((p) => ({ name: p.name, slug: slugify(p.name), series: p.series })),
        average: postTownTrend.average,
      },
    };
  })
  .filter((b) => b.trend.boroughs.length > 0);

// Same precompute-every-borough-then-reveal approach as the sections above.
const housingByBorough = trend.boroughs
  .map((b) => {
    const hpi = getHpi(b.slug);
    return {
      slug: b.slug,
      name: b.name,
      hpi,
      hpiTrend: hpi ? { months: hpi.borough.months, boroughs: [{ name: b.name, slug: b.slug, series: hpi.borough.averagePrice }], average: hpi.london.averagePrice } : null,
      rents: getRents(b.slug),
      prices: getBoroughPostTownPrices(city.slug, b.slug),
      demographics: getBoroughDemographics(b.slug),
      broadband: getBoroughBroadband(b.slug),
      mobile: getMobileCoverage(b.slug),
    };
  })
  .filter((b) => b.hpi || b.rents || b.prices || b.demographics || b.broadband || b.mobile);

// City-level view (no ?highlight=): London as a whole, plus every borough compared side by side.
const firstSlug = trend.boroughs[0]?.slug ?? "";
const londonHpiRaw = getHpi(firstSlug);
const londonRentsRaw = getRents(firstSlug);
const londonHousing = {
  slug: "london",
  name: city.name,
  hpi: londonHpiRaw ? { borough: londonHpiRaw.london, london: londonHpiRaw.london, source: londonHpiRaw.source } : null,
  hpiTrend: londonHpiRaw ? { months: londonHpiRaw.london.months, boroughs: [], average: londonHpiRaw.london.averagePrice } : null,
  rents: londonRentsRaw
    ? {
        borough: londonRentsRaw.london,
        london: londonRentsRaw.london,
        latestMonth: londonRentsRaw.latestMonth,
        source: londonRentsRaw.source,
        trend: { months: londonRentsRaw.london.history.months, boroughs: [], average: londonRentsRaw.london.history.price },
      }
    : null,
  prices: null,
};
const londonDemographics = getLondonDemographics();
const londonBroadband = getBoroughBroadband(firstSlug);
const londonMobile = getMobileCoverage(firstSlug);

const gbpFmt = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });
const pct1 = (n: number | null | undefined) => (n == null ? "n/a" : `${n.toFixed(1)}%`);
const chg = (n: number | null | undefined) => (n == null ? "n/a" : `${n >= 0 ? "+" : ""}${n.toFixed(1)}%`);
const COUNCIL_TAX_BANDS = ["A", "B", "C", "D", "E", "F", "G", "H"] as const;
const councilTaxRange = COUNCIL_TAX_BANDS.map((band) => {
  const values = councilTaxByBorough.map((b) => b.councilTax!.bands[band]).filter((v) => typeof v === "number");
  return { band, average: councilTaxLondonAverage[band], lowest: Math.min(...values), highest: Math.max(...values) };
});
const boroughLink = (slug: string) => `/${city.slug}/statistics/?highlight=${slug}`;
const housingComparison = housingByBorough.map((b) => {
  const tax = councilTaxByBorough.find((t) => t.slug === b.slug);
  const rentAll = b.rents?.borough.byBedrooms.all;
  const twoBed = b.rents?.borough.byBedrooms.twoBed;
  return {
    slug: b.slug,
    name: b.name,
    rent: rentAll?.price ?? null,
    rentChange: rentAll?.annualChange ?? null,
    twoBed: twoBed?.price ?? null,
    price: b.hpi ? b.hpi.borough.averagePrice[b.hpi.borough.averagePrice.length - 1] : null,
    priceChange: b.hpi?.borough.annualChange ?? null,
    bandD: tax?.councilTax?.bandD ?? null,
  };
});
const demographicsComparison = housingByBorough
  .filter((b) => b.demographics)
  .map((b) => {
    const d = b.demographics!.borough;
    return {
      slug: b.slug,
      name: b.name,
      population: d.population,
      under15: d.age.under15,
      over65: d.age.age65plus,
      degree: d.qualifications.degreeLevel,
      social: d.tenure.socialRented,
      private: d.tenure.privateRented,
      deprived: d.imdDeciles.slice(0, 3).reduce((a, x) => a + x, 0),
    };
  });
const connectivityComparison = housingByBorough
  .filter((b) => b.broadband || b.mobile)
  .map((b) => ({
    slug: b.slug,
    name: b.name,
    gigabit: b.broadband?.borough.gigabit ?? null,
    fullFibre: b.broadband?.borough.fullFibre ?? null,
    superfast: b.broadband?.borough.superfast ?? null,
    fourGIndoor: b.mobile?.borough.fourGIndoorAll ?? null,
    fiveG: b.mobile?.borough.fiveGOutdoorAll ?? null,
  }));

// Crime: every borough's monthly series (for the London comparison chart) plus, per borough, its postcode-area comparison and categories.
const crimeTrend = getCityCrimeTrend(city.slug);
const crimeByBorough = crimeTrend.boroughs.map((b) => ({
  slug: b.slug,
  name: b.name,
  total: getBoroughSummary(city.slug, b.slug).crimes12mo,
  monthly: crimeTrend.months.map((month, i) => ({ month, totalCrimes: b.series[i] })),
  categories: getBoroughCrimeCategories(city.slug, b.slug),
  compare: getBoroughCrimeTrend(city.slug, b.slug),
}));
const londonCrimeTotal = crimeByBorough.reduce((sum, b) => sum + b.total, 0);
const londonCrimeMonthly = crimeTrend.months.map((month, i) => ({ month, totalCrimes: crimeTrend.boroughs.reduce((sum, b) => sum + b.series[i], 0) }));
const londonCrimeCategories = (() => {
  const totals = new Map<string, number>();
  for (const b of crimeByBorough) for (const [category, count] of b.categories) totals.set(category, (totals.get(category) ?? 0) + count);
  return [...totals.entries()] as [string, number][];
})();

// Environment: live air quality and flood warnings around each borough's centre, and around the whole city.
const boroughCentres = new Map(trend.boroughs.map((b) => [b.slug, getBoroughSummary(city.slug, b.slug)]));
const cityCentre = getCitySummary(city.slug);
---

<BaseLayout
  title={`Statistics across ${city.name}`}
  description={`Rents, house prices, deprivation, demographics and monthly property sales compared across every borough in ${city.name}.`}
  menuLevel="city"
  citySlug={city.slug}
  jsonLd={datasetJsonLd({
    name: `Statistics across ${city.name}`,
    description: `Rents, house prices, Council Tax, demographics, deprivation, recorded crime, broadband, mobile coverage and environment compared across every borough in ${city.name}.`,
    url: `/${city.slug}/statistics/`,
    sources: ["HM Land Registry Price Paid Data", "HM Land Registry UK House Price Index", "ONS Price Index of Private Rents", "ONS Census 2021", "English Indices of Deprivation 2019", "data.police.uk street-level crime data", "Ofcom Connected Nations 2025", "gov.uk Council Tax levels 2026-27", "Environment Agency flood monitoring"],
    keywords: [city.name, "house prices", "rents", "Council Tax", "demographics", "deprivation", "crime", "broadband", "flood risk", "borough comparison"],
    spatial: { name: city.name },
  })}
>
  <Breadcrumbs
    sticky
    crumbs={[
      { label: "PostcodeHub", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: "Statistics" },
    ]}
  />
  <HighlightBreadcrumbCrumb citySlug={city.slug} entities={trend.boroughs} />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-4" data-stats-heading data-default={`Statistics across ${city.name}`}>Statistics across {city.name}</h1>

    <SectionTabs />

    <section data-section="housing" data-section-label="Housing">
      <div data-london-block>
        <section class="mb-8">
          <h2 class="text-2xl font-bold mb-1">Council Tax bands across {city.name}</h2>
          <p class="text-stone-500 mb-3 text-sm">2026-27 annual Council Tax by band: the London average and the cheapest and most expensive borough.</p>
          <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                  <th class="px-4 py-2 font-semibold">Band</th>
                  <th class="px-4 py-2 font-semibold text-right">London average</th>
                  <th class="px-4 py-2 font-semibold text-right">Lowest borough</th>
                  <th class="px-4 py-2 font-semibold text-right">Highest borough</th>
                </tr>
              </thead>
              <tbody>
                {councilTaxRange.map((r) => (
                  <tr class:list={["border-b border-stone-100 last:border-0", r.band === "D" && "bg-emerald-50 font-semibold"]}>
                    <td class="px-4 py-2">Band {r.band}</td>
                    <td class="px-4 py-2 text-right">{gbpFmt.format(r.average)}</td>
                    <td class="px-4 py-2 text-right text-stone-500">{gbpFmt.format(r.lowest)}</td>
                    <td class="px-4 py-2 text-right text-stone-500">{gbpFmt.format(r.highest)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-stone-400 mt-2">Source: gov.uk, Council Tax levels set by local authorities in England 2026 to 2027 (Band D area council tax, including the GLA precept).</p>
        </section>

        <HousingMarket b={londonHousing} solo />

        <BoroughComparisonTable
          title="Boroughs compared: rents, house prices and Council Tax"
          intro="Average monthly rent, average house price and Band D Council Tax in every borough, with 12-month changes."
          columns={["Avg rent / month", "Rent 12m", "2 bed rent", "Avg house price", "Price 12m", "Band D tax"]}
          rows={housingComparison.map((r) => ({
            name: r.name,
            href: boroughLink(r.slug),
            cells: [r.rent != null ? gbpFmt.format(r.rent) : "n/a", chg(r.rentChange), r.twoBed != null ? gbpFmt.format(r.twoBed) : "n/a", r.price != null ? gbpFmt.format(r.price) : "n/a", chg(r.priceChange), r.bandD != null ? gbpFmt.format(r.bandD) : "n/a"],
          }))}
          footer={{
            name: "London average",
            cells: [
              londonRentsRaw?.london.byBedrooms.all.price != null ? gbpFmt.format(londonRentsRaw.london.byBedrooms.all.price) : "n/a",
              chg(londonRentsRaw?.london.byBedrooms.all.annualChange),
              londonRentsRaw?.london.byBedrooms.twoBed.price != null ? gbpFmt.format(londonRentsRaw.london.byBedrooms.twoBed.price) : "n/a",
              londonHpiRaw ? gbpFmt.format(londonHpiRaw.london.averagePrice[londonHpiRaw.london.averagePrice.length - 1]) : "n/a",
              chg(londonHpiRaw?.london.annualChange),
              gbpFmt.format(councilTaxLondonAverage.D),
            ],
          }}
          source="Sources: ONS Price Index of Private Rents; HM Land Registry UK House Price Index; gov.uk Council Tax 2026-27. City of London has no published rent figures."
        />
      </div>

      <section class="mb-8 hidden" data-council-tax-section>
        <h2 class="text-2xl font-bold mb-1" data-council-tax-heading>Council Tax bands</h2>
        <p class="text-stone-500 mb-3 text-sm" data-council-tax-sub></p>
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="px-4 py-2 font-semibold">Band</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax</th>
                <th class="px-4 py-2 font-semibold text-right">Annual Council Tax (AVG London)</th>
              </tr>
            </thead>
            <tbody data-council-tax-rows></tbody>
          </table>
        </div>
      </section>

      {
        housingByBorough
          .filter((b) => b.hpi || b.rents || b.prices)
          .map((b) => (
            <div class="hidden" data-borough-block data-borough-slug={b.slug}>
              <HousingMarket b={b} />
            </div>
          ))
      }

      {
        postTownTrendsByBorough.map((b) => (
          <div class="hidden mb-8" data-borough-block data-borough-slug={b.slug}>
            <h2 class="text-2xl font-bold mb-1">Property sales comparison across {b.name}, grouped by post town</h2>
            <p class="text-stone-500 mb-3 text-sm">Monthly residential sales by post town within {b.name}, against the borough average.</p>
            <BoroughTrendChart trend={b.trend} averageLabel={`${b.name} average`} chartId={`property-posttown-${b.slug}`} />
          </div>
        ))
      }

      <h2 class="text-2xl font-bold mb-1">Property sales comparison across {city.name}</h2>
      <p class="text-stone-500 mb-6">Number of residential sales completed per month in each borough, covering roughly the last two years.</p>

      <BoroughTrendChart trend={trend} averageLabel={`${city.name} average`} chartId="property" />

      <p class="text-xs text-stone-400 mt-6">
        Source: HM Land Registry Price Paid Data.
        {councilTaxByBorough.length > 0 && " Council Tax: gov.uk, Council Tax levels set by local authorities in England 2026 to 2027 (Band D area council tax, including the GLA precept)."}
      </p>
    </section>

    <section data-section="demographics" data-section-label="Demographics" class="mt-10">
      {
        londonDemographics && (
          <div data-london-block>
            <DemographicsSection columns={[{ label: city.name, data: londonDemographics.london }]} source={londonDemographics.source} />
            <BoroughComparisonTable
              title="Boroughs compared: who lives where"
              intro="Population, age, education, housing tenure and deprivation in every borough (2021 Census; deprivation from the 2019 Indices)."
              columns={["Residents", "Under 15", "65 and over", "Degree level", "Social rent", "Private rent", "Most deprived 30%"]}
              rows={demographicsComparison.map((r) => ({
                name: r.name,
                href: boroughLink(r.slug),
                cells: [r.population.toLocaleString("en-GB"), pct1(r.under15), pct1(r.over65), pct1(r.degree), pct1(r.social), pct1(r.private), pct1(r.deprived)],
              }))}
              footer={{
                name: "London",
                cells: [
                  londonDemographics.london.population.toLocaleString("en-GB"),
                  pct1(londonDemographics.london.age.under15),
                  pct1(londonDemographics.london.age.age65plus),
                  pct1(londonDemographics.london.qualifications.degreeLevel),
                  pct1(londonDemographics.london.tenure.socialRented),
                  pct1(londonDemographics.london.tenure.privateRented),
                  pct1(londonDemographics.london.imdDeciles.slice(0, 3).reduce((a, x) => a + x, 0)),
                ],
              }}
              source="Sources: ONS Census 2021; English Indices of Deprivation 2019. Most deprived 30% is the share of postcodes in the most deprived 30% of England."
            />
          </div>
        )
      }
      {
        housingByBorough
          .filter((b) => b.demographics)
          .map((b) => (
            <div class="hidden" data-borough-block data-borough-slug={b.slug}>
              <DemographicsSection
                columns={[
                  { label: b.name, data: b.demographics!.borough },
                  { label: "London", data: b.demographics!.london },
                ]}
                source={b.demographics!.source}
              />
            </div>
          ))
      }
    </section>

    <section data-section="crime" data-section-label="Crime" class="mt-10">
      {
        crimeByBorough.map((b) => (
          <div class="hidden" data-borough-block data-borough-slug={b.slug}>
            <h2 class="text-2xl font-bold mb-1">Crime in {b.name}</h2>
            <CrimeStats
              total={b.total}
              coverage="counted within roughly 1 mile of each postcode area's centre"
              monthly={b.monthly}
              categories={b.categories}
              compare={{
                trend: b.compare,
                averageLabel: `${b.name} average`,
                chartId: `borough-crime-${b.slug}`,
                heading: `Compare postcode areas in ${b.name}`,
                intro: `Monthly crime trend across every postcode area in ${b.name}, against the borough average.`,
              }}
            />
          </div>
        ))
      }

      <div data-london-block>
        <h2 class="text-2xl font-bold mb-1">Crime across {city.name}</h2>
        <CrimeStats total={londonCrimeTotal} coverage="counted within roughly 1 mile of each postcode area's centre, added across boroughs" monthly={londonCrimeMonthly} categories={londonCrimeCategories} />
      </div>

      <section class="mt-8">
        <h2 class="text-2xl font-bold mb-1">Crime comparison across {city.name}</h2>
        <p class="text-stone-500 mb-3 text-sm">Monthly recorded crimes per borough, each counted within roughly 1 mile of its postcode areas' centres.</p>
        <BoroughTrendChart trend={crimeTrend} averageLabel={`${city.name} average`} chartId="crime" />
        <div class="mt-6" data-london-block>
          <BoroughComparisonTable
            title="Boroughs compared: recorded crime"
            intro="Recorded crimes over the last 12 months in every borough, and each borough's share of the London total."
            columns={["Recorded crimes (12 months)", "Share of London"]}
            rows={crimeByBorough.map((b) => ({ name: b.name, href: boroughLink(b.slug), cells: [b.total.toLocaleString("en-GB"), pct1(londonCrimeTotal > 0 ? (b.total / londonCrimeTotal) * 100 : 0)] }))}
            footer={{ name: "London", cells: [londonCrimeTotal.toLocaleString("en-GB"), "100.0%"] }}
            source="Source: data.police.uk street-level crime data. Boroughs with larger centres and busier streets record more crime, so these are counts, not rates."
          />
        </div>
      </section>
    </section>

    <section data-section="connectivity" data-section-label="Connectivity" class="mt-10">
      {
        (londonBroadband || londonMobile) && (
          <div data-london-block>
            <h2 class="text-2xl font-bold mb-4">Connectivity across {city.name}</h2>
            <ConnectivitySection
              broadband={
                londonBroadband
                  ? {
                      columns: [{ label: city.name, data: londonBroadband.london }],
                      period: londonBroadband.period,
                      source: londonBroadband.source,
                      note: "London figures are weighted by number of homes.",
                    }
                  : null
              }
              mobile={
                londonMobile
                  ? {
                      columns: [{ label: city.name, data: londonMobile.london }],
                      period: londonMobile.period,
                      source: londonMobile.source,
                      intro: `Share of homes in ${city.name} with mobile coverage from EE, O2, Three and Vodafone (Ofcom, ${londonMobile.period}).`,
                    }
                  : null
              }
            />
            <BoroughComparisonTable
              title="Boroughs compared: broadband and mobile"
              intro="Share of homes that can get each service, in every borough."
              columns={["Gigabit", "Full fibre", "Superfast (30+ Mbit/s)", "4G indoors, all networks", "5G outdoors, all networks"]}
              rows={connectivityComparison.map((r) => ({
                name: r.name,
                href: boroughLink(r.slug),
                cells: [pct1(r.gigabit), pct1(r.fullFibre), pct1(r.superfast), pct1(r.fourGIndoor), pct1(r.fiveG)],
              }))}
              footer={
                londonBroadband && londonMobile
                  ? {
                      name: "London",
                      cells: [pct1(londonBroadband.london.gigabit), pct1(londonBroadband.london.fullFibre), pct1(londonBroadband.london.superfast), pct1(londonMobile.london.fourGIndoorAll), pct1(londonMobile.london.fiveGOutdoorAll)],
                    }
                  : undefined
              }
              source="Source: Ofcom Connected Nations 2025."
            />
          </div>
        )
      }
      {
        housingByBorough
          .filter((b) => b.broadband || b.mobile)
          .map((b) => (
            <div class="hidden" data-borough-block data-borough-slug={b.slug}>
              <h2 class="text-2xl font-bold mb-4">Connectivity in {b.name}</h2>
              <ConnectivitySection
                broadband={
                  b.broadband
                    ? {
                        columns: [
                          { label: b.name, data: b.broadband.borough },
                          { label: "London", data: b.broadband.london },
                        ],
                        period: b.broadband.period,
                        source: b.broadband.source,
                        note: "Borough and London figures are weighted by number of homes.",
                      }
                    : null
                }
                mobile={
                  b.mobile
                    ? {
                        columns: [
                          { label: b.name, data: b.mobile.borough },
                          { label: "London", data: b.mobile.london },
                        ],
                        period: b.mobile.period,
                        source: b.mobile.source,
                        intro: `Share of homes in ${b.name} with mobile coverage from EE, O2, Three and Vodafone (Ofcom, ${b.mobile.period}).`,
                      }
                    : null
                }
              />
            </div>
          ))
      }
    </section>

    <section data-section="environment" data-section-label="Environment" class="mt-10">
      {
        trend.boroughs.map((b) => (
          <div class="hidden" data-borough-block data-borough-slug={b.slug}>
            <h2 class="text-2xl font-bold mb-4">Environment in {b.name}</h2>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <LiveAirQualityWidget latitude={boroughCentres.get(b.slug)!.latitude} longitude={boroughCentres.get(b.slug)!.longitude} />
              <LiveFloodWarningsWidget latitude={boroughCentres.get(b.slug)!.latitude} longitude={boroughCentres.get(b.slug)!.longitude} radiusKm={8} areaLabel={b.name} />
            </div>
            <a
              href="https://check-long-term-flood-risk.service.gov.uk/"
              target="_blank"
              rel="noopener"
              class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
            >
              <span class="text-3xl leading-none" aria-hidden="true">🌊</span>
              <div>
                <p class="font-medium">Check long-term flood risk</p>
                <p class="text-sm text-stone-500 mt-1">Flood risk from rivers, the sea and surface water varies street by street within {b.name} - look up an exact address on the Environment Agency's checker.</p>
              </div>
            </a>
            <p class="text-xs text-stone-400 mt-2">Sources: Open-Meteo air quality; Environment Agency flood monitoring. Warnings cover an 8 km radius from the centre of {b.name}.</p>
          </div>
        ))
      }

      <div data-london-block>
        <h2 class="text-2xl font-bold mb-4">Environment across {city.name}</h2>
        <div class="grid gap-4 sm:grid-cols-2 mb-4">
          <LiveAirQualityWidget latitude={cityCentre.latitude} longitude={cityCentre.longitude} />
          <LiveFloodWarningsWidget latitude={cityCentre.latitude} longitude={cityCentre.longitude} radiusKm={30} areaLabel={city.name} />
        </div>
        <a
          href="https://check-long-term-flood-risk.service.gov.uk/"
          target="_blank"
          rel="noopener"
          class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors"
        >
          <span class="text-3xl leading-none" aria-hidden="true">🌊</span>
          <div>
            <p class="font-medium">Check long-term flood risk</p>
            <p class="text-sm text-stone-500 mt-1">Flood risk from rivers, the sea and surface water varies street by street - look up an exact address on the Environment Agency's checker.</p>
          </div>
        </a>
        <p class="text-xs text-stone-400 mt-2">Sources: Open-Meteo air quality; Environment Agency flood monitoring (30 km around central {city.name}). Select a borough for its own readings.</p>
      </div>
    </section>
  </section>

  <script type="application/json" data-borough-names set:html={JSON.stringify(trend.boroughs.map((b) => ({ slug: b.slug, name: b.name })))} />
  <script type="application/json" data-council-tax-data set:html={JSON.stringify(councilTaxByBorough)} />
  <script type="application/json" data-council-tax-average set:html={JSON.stringify(councilTaxLondonAverage)} />

  <script>
    interface BoroughCouncilTax {
      slug: string;
      name: string;
      councilTax: {
        boroughName: string;
        bandD: number;
        bands: Record<string, number>;
      };
    }

    const BAND_ORDER = ["A", "B", "C", "D", "E", "F", "G", "H"];
    const GBP = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });

    document.querySelectorAll<HTMLScriptElement>("[data-council-tax-data]").forEach((el) => {
      const boroughs = JSON.parse(el.textContent ?? "[]") as BoroughCouncilTax[];
      const highlight = new URLSearchParams(location.search).get("highlight");
      const match = highlight ? boroughs.find((b) => b.slug === highlight) : null;
      if (!match) return;

      const averageEl = document.querySelector<HTMLScriptElement>("[data-council-tax-average]");
      const londonAverage = JSON.parse(averageEl?.textContent ?? "{}") as Record<string, number>;

      const section = document.querySelector<HTMLElement>("[data-council-tax-section]");
      const heading = document.querySelector<HTMLElement>("[data-council-tax-heading]");
      const sub = document.querySelector<HTMLElement>("[data-council-tax-sub]");
      const rows = document.querySelector<HTMLElement>("[data-council-tax-rows]");
      if (!section || !heading || !sub || !rows) return;

      heading.textContent = `Council Tax bands in ${match.name}`;
      sub.textContent = `2026-27 rates, Band D (the reference band) is ${GBP.format(match.councilTax.bandD)} a year.`;

      for (const band of BAND_ORDER) {
        const amount = match.councilTax.bands[band];
        if (amount == null) continue;
        const avgAmount = londonAverage[band];
        const tr = document.createElement("tr");
        tr.className = band === "D" ? "border-b border-stone-100 bg-emerald-50 font-semibold" : "border-b border-stone-100 last:border-0";

        const bandCell = document.createElement("td");
        bandCell.className = "px-4 py-2";
        bandCell.textContent = `Band ${band}`;

        const amountCell = document.createElement("td");
        amountCell.className = "px-4 py-2 text-right";
        amountCell.textContent = GBP.format(amount);
        if (avgAmount != null && amount !== avgAmount) {
          const icon = document.createElement("span");
          icon.className = amount > avgAmount ? "text-red-600 ml-1.5" : "text-emerald-600 ml-1.5";
          icon.textContent = amount > avgAmount ? "▲" : "▼";
          icon.title = amount > avgAmount ? "Above the London average" : "Below the London average";
          amountCell.append(icon);
        }

        const avgCell = document.createElement("td");
        avgCell.className = "px-4 py-2 text-right text-stone-500";
        avgCell.textContent = avgAmount != null ? GBP.format(avgAmount) : "—";

        tr.append(bandCell, amountCell, avgCell);
        rows.append(tr);
      }

      section.classList.remove("hidden");
    });
  </script>

  <script>
    // Every borough's blocks are rendered; keep only the highlighted borough's and drop the rest, so section ids stay unique
    // and the sticky tabs (built afterwards, on window load) list only sections that have data for it.
    const params = new URLSearchParams(location.search);
    const highlight = params.get("highlight");
    for (const block of document.querySelectorAll<HTMLElement>("[data-borough-block]")) {
      if (highlight && block.dataset.boroughSlug === highlight) block.classList.remove("hidden");
      else block.remove();
    }
    // Without a highlighted borough the page shows London as a whole; with one, that view is replaced by the borough's.
    if (highlight) document.querySelectorAll("[data-london-block]").forEach((b) => b.remove());
    for (const section of document.querySelectorAll<HTMLElement>("[data-section]")) {
      // Demographics and Connectivity exist only through the London or a borough's blocks.
      if (section.dataset.section !== "housing" && !section.querySelector("[data-borough-block], [data-london-block]")) section.remove();
    }
    const heading = document.querySelector<HTMLElement>("[data-stats-heading]");
    if (heading && highlight) {
      const names = JSON.parse(document.querySelector("[data-borough-names]")?.textContent ?? "[]") as { slug: string; name: string }[];
      const match = names.find((b) => b.slug === highlight);
      if (match) heading.textContent = `Statistics in ${match.name}`;
    }
  </script>
</BaseLayout>
