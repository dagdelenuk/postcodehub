---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import { articleJsonLd } from "../../lib/seo";
import { CHECKLIST_STEPS } from "../../lib/checklist";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const reviewedDate = guide.data.lastReviewed.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const isoDate = guide.data.lastReviewed.toISOString();

// This guide can only show the "moving checklist" sidebar if it's actually about one of the checklist's own steps
// (matched by topic id) - a guide like commute-budget-impact has no such step and gets no sidebar/script at all. Even
// then, the sidebar stays hidden until the page's own client-side script confirms (from the URL) that this particular
// visit came from a specific borough's checklist - this is a fully static site, so there is no server-side way to know
// that at build time.
const relevantStepId = guide.data.topics.find((t) => CHECKLIST_STEPS.some((s) => s.id === t));
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  jsonLd={articleJsonLd({
    headline: guide.data.title,
    description: guide.data.description,
    url: `/guides/${guide.id}/`,
    datePublished: isoDate,
    dateModified: isoDate,
  })}
>
  <Breadcrumbs sticky crumbs={[{ label: "PostcodeHub", href: "/" }, { label: "Guides", href: "/guides/" }, { label: guide.data.title }]} />

  <div class="mx-auto max-w-5xl px-4 py-6 lg:grid lg:grid-cols-[1fr_18rem] lg:gap-8 lg:items-start">
    <article class="max-w-3xl">
      <p class="text-xs uppercase tracking-wide text-emerald-700 font-medium mb-2">Guide &middot; {guide.data.minutesToRead} min read</p>
      <h1 class="text-2xl font-bold mb-2">{guide.data.title}</h1>
      <p class="text-stone-500 mb-1">{guide.data.description}</p>
      <p class="text-xs text-stone-400 mb-6">Last reviewed: {reviewedDate}</p>

      <div class="guide-content text-stone-700 leading-relaxed">
        <Content />
      </div>

      {
        guide.data.relatedTools.length > 0 && (
          <div class="mt-8 rounded-lg border border-emerald-100 bg-emerald-50/60 p-4">
            <p class="text-xs uppercase tracking-wide text-emerald-800 font-medium mb-2">PostcodeHub tools for this</p>
            <ul class="space-y-1.5">
              {guide.data.relatedTools.map((tool) => (
                <li>
                  <a href={tool.href} class="text-sm text-emerald-700 hover:underline">
                    {tool.label} &rarr;
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>

    {
      relevantStepId && (
        <aside id="checklist-sidebar" class="hidden mt-8 lg:mt-0 lg:sticky lg:top-24 rounded-lg border border-stone-200 bg-white p-4" data-checklist-sidebar>
          <p class="text-xs uppercase tracking-wide text-stone-500 font-medium mb-3">Your moving checklist</p>
          <ol class="space-y-1 text-sm" data-checklist-sidebar-list>
            {
              CHECKLIST_STEPS.map((step) => (
                <li data-step-id={step.id} class="rounded-md transition-colors">
                  <a href="#" class="flex items-start gap-2 p-2 rounded-md hover:bg-stone-50 transition-colors" data-checklist-compact data-checklist-sidebar-link>
                    <input type="checkbox" disabled class="mt-0.5 h-3.5 w-3.5 shrink-0 accent-stone-300 pointer-events-none" />
                    <span class="text-stone-700">{step.title}</span>
                  </a>
                  <div class="hidden rounded-md p-3" data-checklist-full>
                    <p class="font-semibold text-white">{step.title}</p>
                    <p class="text-emerald-50 text-xs mt-1">{step.text}</p>
                    <a href="#" class="text-xs text-white underline mt-2 inline-block" data-checklist-sidebar-link>
                      Back to checklist &rarr;
                    </a>
                  </div>
                </li>
              ))
            }
          </ol>
        </aside>
      )
    }
  </div>
</BaseLayout>

{
  relevantStepId && (
    <script define:vars={{ relevantStepId }}>
      const params = new URLSearchParams(location.search);
      const base = params.get("base");
      const step = params.get("step");
      const isValidBase = base && /^\/[a-z0-9-]+(\/[a-z0-9-]+){1,2}$/.test(base);
      const isValidStep = step && /^[a-z-]+$/.test(step);

      if (params.get("from") === "checklist" && isValidBase) {
        const aside = document.querySelector("[data-checklist-sidebar]");
        const list = aside?.querySelector("[data-checklist-sidebar-list]");
        if (aside && list) {
          for (const li of list.querySelectorAll("[data-step-id]")) {
            for (const link of li.querySelectorAll("[data-checklist-sidebar-link]")) {
              link.href = `${base}/services/#${li.dataset.stepId}`;
            }
          }
          const pinnedId = isValidStep ? step : relevantStepId;
          const pinned = list.querySelector(`[data-step-id="${pinnedId}"]`);
          if (pinned) {
            list.prepend(pinned);
            pinned.querySelector("[data-checklist-compact]")?.classList.add("hidden");
            pinned.querySelector("[data-checklist-full]")?.classList.remove("hidden");
            pinned.querySelector("[data-checklist-full]")?.classList.add("bg-emerald-600");
          }
          aside.classList.remove("hidden");
        }
      }
    </script>
  )
}

<style>
  .guide-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #1c1917;
  }
  .guide-content :global(p) {
    margin-bottom: 1rem;
  }
  .guide-content :global(ul),
  .guide-content :global(ol) {
    margin: 0 0 1rem 1.25rem;
    list-style: disc;
  }
  .guide-content :global(ol) {
    list-style: decimal;
  }
  .guide-content :global(li) {
    margin-bottom: 0.375rem;
  }
  .guide-content :global(a) {
    color: #047857;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .guide-content :global(strong) {
    font-weight: 600;
    color: #1c1917;
  }
</style>
