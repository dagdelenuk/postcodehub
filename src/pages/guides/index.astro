---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getAllGuides } from "../../lib/guides";
import { itemListJsonLd } from "../../lib/seo";

const guides = await getAllGuides();
---

<BaseLayout
  title="Guides"
  description="Plain-English guides to school admissions, commuting costs and comparing London boroughs, linked to PostcodeHub's own tools and open data."
  jsonLd={itemListJsonLd({
    name: "PostcodeHub guides",
    description: "Guides to school admissions, commuting and comparing London boroughs.",
    url: "/guides/",
    items: guides.map((g) => ({ name: g.data.title, url: `/guides/${g.id}/` })),
  })}
>
  <Breadcrumbs sticky crumbs={[{ label: "PostcodeHub", href: "/" }, { label: "Guides" }]} />

  <section class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-2xl font-bold mb-2">Guides</h1>
    <p class="text-stone-600 mb-6">Plain-English explainers on the things that shape a move - schools, commuting, budget and comparing areas - linked back to PostcodeHub's own tools and data wherever it helps.</p>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        guides.map((guide) => (
          <li>
            <a href={`/guides/${guide.id}/`} class="relative overflow-hidden block h-full rounded-lg border border-stone-200 bg-white p-4 hover:border-emerald-600 transition-colors">
              <span class="pointer-events-none select-none absolute -right-2 -bottom-3 text-7xl opacity-25 leading-none" aria-hidden="true">
                {guide.data.icon}
              </span>
              <div class="relative pr-8">
                <p class="text-lg font-semibold">{guide.data.title}</p>
                <p class="text-sm text-stone-500 mt-1">{guide.data.description}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <span class="text-xs text-stone-400">{guide.data.minutesToRead} min read</span>
                  {guide.data.topics.map((topic) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-600 capitalize">{topic}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
