---
import BaseLayout from "../layouts/BaseLayout.astro";
import FavoriteStar from "../components/FavoriteStar.astro";
import PostcodeSearch from "../components/PostcodeSearch.astro";
import { getBannerImages, loadHierarchy } from "../lib/data";

const hierarchy = loadHierarchy();

// Favourites live in the visitor's localStorage, unknown at build time, so
// every possible favourite (every city/borough/outcode) gets a lookup entry
// here; client-side JS (favorites.ts logic in FavoriteStar.astro) reads this
// to render the "Your Favourites" section for whichever keys are actually
// favourited, without needing to fetch anything at runtime.
const favouritesLookup: Record<string, { label: string; sublabel: string; href: string; thumb?: string }> = {};
for (const city of hierarchy.cities) {
  favouritesLookup[`city:${city.slug}`] = {
    label: city.name,
    sublabel: `${city.boroughs.length} council ${city.boroughs.length === 1 ? "authority" : "authorities"} covered`,
    href: `/${city.slug}/`,
    thumb: getBannerImages(city.slug)[0]?.src,
  };
  for (const borough of city.boroughs) {
    favouritesLookup[`borough:${borough.slug}`] = {
      label: borough.name,
      sublabel: `${borough.outcodes.length} postcode areas`,
      href: `/${city.slug}/${borough.slug}/`,
      thumb: getBannerImages(borough.slug)[0]?.src,
    };
    for (const outcode of borough.outcodes) {
      favouritesLookup[`outcode:${city.slug}/${borough.slug}/${outcode.slug}`] = {
        label: outcode.outcode,
        sublabel: outcode.wards.slice(0, 2).join(", "),
        href: `/${city.slug}/${borough.slug}/${outcode.slug}/`,
      };
    }
  }
}
---

<BaseLayout title="Home" description="A non-commercial community information hub for UK neighbourhoods, covering health, safety, transport, schools, and civic data by postcode." menuLevel="home">
  <div class="relative">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px); background-size: 40px 40px; -webkit-mask-image: linear-gradient(to bottom, black, transparent); mask-image: linear-gradient(to bottom, black, transparent);"
    >
    </div>
    <section class="relative mx-auto max-w-5xl px-4 py-16 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Your neighbourhood, in one place</h1>
      <p class="mt-4 text-lg text-stone-600 max-w-2xl">
        Health services, transport, schools, safety, planning, local representatives, events, and property
        &mdash; built from open UK government data, organised by postcode.
      </p>
      <div class="mt-6 max-w-xs">
        <PostcodeSearch />
      </div>
    </section>
  </div>

  <script type="application/json" id="favourites-lookup" set:html={JSON.stringify(favouritesLookup)} />

  <section class="mx-auto max-w-5xl px-4 pt-8 pb-4 hidden" data-favourites-section>
    <h2 class="text-xl font-semibold mb-4">Your Favourites</h2>
    <div class="grid gap-3 sm:grid-cols-2" data-favourites-list></div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-xl font-semibold mb-4">Browse by city</h2>
    <div class="grid gap-4 sm:grid-cols-2" data-favorite-list>
      {
        hierarchy.cities.map((city) => {
          const thumb = getBannerImages(city.slug)[0];
          const favKey = `city:${city.slug}`;
          return (
            <div class="relative rounded-lg border border-stone-200 bg-white transition-colors" data-favorite-key={favKey}>
              <a href={`/${city.slug}/`} class="flex items-center gap-4 p-6 hover:border-emerald-600 rounded-lg transition-colors">
                {thumb && <img src={thumb.src} alt="" class="h-16 w-16 shrink-0 rounded-md object-cover" />}
                <div>
                  <h3 class="text-lg font-semibold">{city.name}</h3>
                  <p class="text-sm text-stone-500 mt-1">
                    {city.boroughs.length} council {city.boroughs.length === 1 ? "authority" : "authorities"} covered
                  </p>
                </div>
              </a>
              <div class="absolute top-2 right-2">
                <FavoriteStar favKey={favKey} />
              </div>
            </div>
          );
        })
      }
      <div class="flex items-center gap-4 rounded-lg border border-dashed border-stone-200 bg-stone-50 p-6 text-stone-400">
        <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-md bg-stone-100 text-2xl">🏙️</span>
        <div>
          <h3 class="text-lg font-semibold text-stone-500">Other Cities</h3>
          <span class="inline-block mt-1 rounded-full bg-stone-200 px-2 py-0.5 text-xs font-medium text-stone-500">Coming soon</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
